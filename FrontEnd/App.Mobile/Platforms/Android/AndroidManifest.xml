<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        allowBackup is off deliberately. The only local state worth preserving is the theme and
        language preference; everything else is re-fetched on sign-in. What Auto Backup WOULD carry
        is the EncryptedSharedPreferences file behind SecureStorage, whose decryption key lives in
        the hardware Keystore and is NOT backed up. Restoring it onto a new device therefore yields
        an undecryptable keyset that faults on first read, which is a worse outcome than simply
        signing in again.

        networkSecurityConfig permits cleartext only to the loopback hosts a Debug build talks to;
        the Release API is HTTPS.
    -->
    <application android:allowBackup="false"
                 android:icon="@mipmap/appicon"
                 android:roundIcon="@mipmap/appicon_round"
                 android:supportsRtl="true"
                 android:hardwareAccelerated="true"
                 android:networkSecurityConfig="@xml/network_security_config">

        <!-- What Google Play services uses when IT draws a push (the app was closed, so the app's
             own renderer never ran): the diya as the status-bar icon, the app's saffron as the
             accent, and the channel for a message that names none. The server names the same icon
             and a channel on every push, and AppNotifications.cs uses the same three when the app
             draws one itself, so the two cannot be told apart. Without these the system falls back
             to the launcher icon, which Android renders as a grey square. -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon"
                   android:resource="@drawable/ic_notification" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color"
                   android:resource="@color/notification_accent" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id"
                   android:value="general" />
    </application>

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13 (API 33) and later refuse to show a notification unless the user has granted
         this at runtime. Declaring it is only half the job; ReminderScheduler requests it before
         it schedules anything, and NotificationCenterState once the phone is registered for push. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Alarms are cleared when the device restarts, so the daily reminders have to be rebuilt.
         RECEIVE_BOOT_COMPLETED is what lets BootReminderReceiver hear about it. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The japa screen ticks on every count and vibrates long when a mala completes. A normal
         permission: granted at install, never prompted. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- The Panchangam screen computes sunrise and the day's timings for wherever the seeker is.
         Coarse is enough for that, and is the weaker prompt; fine is optional and declared so a
         seeker who grants it gets a better fix. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>
