<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Cleartext is no longer allowed blanket-wide. network_security_config.xml permits http only
         to the loopback hosts a Debug build talks to (10.0.2.2 for the emulator, localhost for a
         port-forwarded device); the Release API is HTTPS and needs no exception. -->
    <application android:allowBackup="true"
                 android:icon="@mipmap/appicon"
                 android:roundIcon="@mipmap/appicon_round"
                 android:supportsRtl="true"
                 android:hardwareAccelerated="true"
                 android:networkSecurityConfig="@xml/network_security_config"></application>

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The Panchangam screen computes sunrise and the day's timings for wherever the seeker is.
         Coarse is enough for that, and is the weaker prompt; fine is optional and declared so a
         seeker who grants it gets a better fix. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>
