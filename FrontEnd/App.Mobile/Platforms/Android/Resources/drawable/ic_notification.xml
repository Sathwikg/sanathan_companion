<?xml version="1.0" encoding="utf-8"?>
<!--
    The status-bar icon of every notification the app shows: a diya, the lamp lit before prayer.

    Android draws this icon as a flat silhouette in a single tint (the accent colour named in the
    manifest, or white on the lock screen), so only its shape matters: every pixel is either opaque
    or transparent. A full-colour image here is how apps end up with a grey square in the status bar.

    Named in three places that must agree: the manifest's default_notification_icon (used when
    Google Play services draws a push while the app is closed), the server's
    PushNotifications:DefaultIcon setting, and AppNotifications.cs (used when the app draws one
    itself). Replace the artwork by keeping this file name.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
        android:width="24dp"
        android:height="24dp"
        android:viewportWidth="24"
        android:viewportHeight="24">

    <!-- The flame: a teardrop leaning nowhere, tip at the top. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,1.5 C12,1.5 8.4,5.9 8.4,8.7 C8.4,10.7 10,12.3 12,12.3 C14,12.3 15.6,10.7 15.6,8.7 C15.6,5.9 12,1.5 12,1.5 Z" />

    <!-- The bowl: a shallow half-ellipse with a lip, wide enough to read at 24dp. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M2.5,13.6 L21.5,13.6 C21.5,17.9 17.3,20.6 12,20.6 C6.7,20.6 2.5,17.9 2.5,13.6 Z" />

    <!-- The foot it stands on. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M8.6,21.4 L15.4,21.4 L15.4,22.6 L8.6,22.6 Z" />
</vector>
