@* The phone shell: a compact top bar that owns notifications, the page in the middle, and a
   bottom navigation built from the same Modules API the sidebar uses. Chosen by Routes.razor
   whenever AppConfig.Platform is Mobile, so the web app is untouched by anything in here. *@
@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject NavigationManager Nav
@inject LocalizationState Loc
@inject LanguageContext LangContext
@inject MenuState Menus
@inject MenuRefreshService MenuRefresh
@inject DeepLinks Links
@inject AppBackNavigator BackNav
@inject HardwareBackButton HardwareBack
@inject NotificationCenterState Center
@inject AppConfig Config
@inject IJSRuntime JS
@implements IDisposable

@* lang lets mobile.css loosen the Latin letter-spacing for Indic scripts, where tracking pulls a
   conjunct's glyphs apart. From the bundle on screen, not the stored preference: a failed
   download leaves the page in English. *@
<div class="sc-shell scm-shell @(Immersive ? "scm-shell--immersive" : null)" lang="@LangCode">
    <header class="scm-topbar">
        <div class="scm-topbar-brand">
            @* Inner pages get a back arrow where the logo sits, the way both platforms' own apps
               do. It is the only way back on an iPhone besides the edge swipe, which has no
               button to press. The home screen and the bottom-tab pages are where Back stops, so
               they keep the logo. *@
            @if (ShowBack)
            {
                <button class="scm-back" @onclick="BackAsync"
                        title="@Loc["common.back", "Back"]" aria-label="@Loc["common.back", "Back"]">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
                </button>
            }
            else
            {
                <AppLogo Size="30" />
            }
            <div class="scm-topbar-titles">
                @* On the home screen the bar greets the seeker instead of naming the page ("Mobile
                   Home" says nothing a seeker needs); everywhere else it says where they are. *@
                @if (IsHomeScreen)
                {
                    <AuthorizeView>
                        <Authorized>
                            <span class="scm-topbar-title">@Loc.TF("nav.hiName", "Hi, {0}", GreetingName(context.User))</span>
                        </Authorized>
                        <NotAuthorized>
                            <span class="scm-topbar-title">@Loc.TF("nav.hiName", "Hi, {0}", Loc["nav.guestName", "Guest"])</span>
                        </NotAuthorized>
                    </AuthorizeView>
                }
                else
                {
                    <span class="scm-topbar-title">@Title</span>
                }
                <span class="scm-topbar-sub">@Brand.AppName</span>
            </div>
        </div>

        <div class="scm-topbar-actions">
            <AuthorizeView>
                <Authorized>
                    @* Notifications sit at the top, where a phone user's eye goes first and where
                       every other app puts them. Everything else lives in the account sheet.
                       Only the bell is here — its panel is rendered below, outside the bar. *@
                    <MobileNotificationBell />
                    <button class="scm-avatar-btn" @onclick="OpenAccount"
                            title="@Loc["nav.viewProfile", "View My Profile"]"
                            aria-label="@Loc["nav.viewProfile", "View My Profile"]">
                        <span class="scm-avatar">@Initials(context.User.FindFirst("fullName")?.Value)</span>
                    </button>
                </Authorized>
                <NotAuthorized>
                    @* A guest: no bell (there is nothing of theirs to notify about) and no avatar,
                       but the one control that turns them into a seeker. *@
                    <ThemeToggle />
                    <SignInButton Class="sc-btn-primary sc-btn-sm sc-signin-btn scm-signin-btn" />
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    @* Deliberately a sibling of the header, not a child of it. .scm-topbar carries a
       backdrop-filter, which makes it the containing block for any position:fixed descendant —
       the panel's full-screen scrim would otherwise collapse to the height of the bar, and
       tapping outside it would dismiss nothing. Being outside the bar's stacking context also
       lets the panel paint above the bottom navigation. *@
    <AuthorizeView>
        <Authorized>
            <MobileNotificationPanel />
        </Authorized>
    </AuthorizeView>

    <main class="sc-content scm-content">
        @* No @key here: @Body is a RenderFragment owned by the Router, so keying it would not
           re-instantiate the page. The language key lives on AuthorizeRouteView in Routes.razor. *@
        <AppErrorBoundary>@Body</AppErrorBoundary>
    </main>

    @* A guest gets the bar too, built from the Guest role's menu. Tabs that need an account
       (Favorites, say) are in it on purpose: opening one is how a guest is asked to sign in.
       Not on the japa screen, where the whole screen counts: a thumb resting near the bottom edge
       should add a chant, not leave the page. The page's own Back returns from it. *@
    @if (!Immersive)
    {
        <AuthorizeView Policy="@GuestSession.BrowsePolicy">
            <Authorized>
                <MobileBottomNav Menu="Menus.Menu" Loading="Menus.Menu is null" OnMore="OpenMore" />
            </Authorized>
        </AuthorizeView>
    }

    <MobileSheet Open="_moreOpen" OnClose="CloseSheets" Title="@Loc["nav.allSections", "All Sections"]">
        <MobileMoreSheet Menu="Menus.Menu" OnNavigate="CloseSheets" />
    </MobileSheet>

    <MobileSheet Open="_accountOpen" OnClose="CloseSheets" Title="@Loc["profile.title", "My Profile"]">
        <MobileAccountSheet OnNavigate="CloseSheets" OnLogout="LogoutAsync" OnShowRole="ShowRole" />
    </MobileSheet>

    @* A sibling of the sheets on purpose: on wide screens the sheet carries a transform, which would
       make it the containing block for the popup's fixed backdrop and trap the popup inside it. *@
    <RoleDetailsModal Visible="_role is not null" Role="_role" OnClose="CloseRole" />

    @* Signed-in seekers only: asks for consent to the current Privacy Notice when it is owed. *@
    <AuthorizeView>
        <Authorized>
            <ConsentGate />
        </Authorized>
    </AuthorizeView>

    <ConfirmDialog />
    <ToastHost />
</div>

@code {
    private bool _moreOpen;
    private bool _accountOpen;
    private RoleSummary? _role;
    private bool _scrollLocked;

    /// <summary>
    /// The bar shows where you are, not what the app is called — on a 390px screen the product
    /// name is the least useful thing that could occupy the widest element.
    /// </summary>
    private string Title
    {
        get
        {
            if (Menus.Menu is not { } menu) return Brand.AppName;

            var current = Nav.ToBaseRelativePath(Nav.Uri);
            var match = MobileMenu.Leaves(menu).FirstOrDefault(n => MobileMenu.IsActive(n, current));
            return match is null
                ? Brand.AppName
                : Loc.Entity("MenuModule", match.Id, "Name", match.Name);
        }
    }

    /// <summary>The phone's home: the app root and the mobile dashboard it opens on.</summary>
    private bool IsHomeScreen => AppBackNavigator.IsHomePath(BackNav.CurrentPath);

    /// <summary>
    /// A back arrow everywhere except the home screen and the pages the bottom bar opens, which are
    /// top-level: from those, Back goes home (Android) and there is nothing "behind" to show an arrow
    /// for. Exact matches only: "sadhana/chant/x" is reached from the Sadhana tab and gets the arrow.
    /// </summary>
    private bool ShowBack
    {
        get
        {
            var current = BackNav.CurrentPath;
            if (AppBackNavigator.IsHomePath(current)) return false;
            if (Menus.Menu is not { } menu) return false;

            return !MobileMenu.Build(menu).Primary
                .Any(tab => AppBackNavigator.Clean(tab.RoutePath).Equals(current, StringComparison.OrdinalIgnoreCase));
        }
    }

    private async Task BackAsync() => await BackNav.BackAsync();

    /// <summary>Android's Back button, relayed from MainPage. False sends the app to the background.</summary>
    private async Task<bool> OnHardwareBack()
    {
        // On the renderer's dispatcher: closing a sheet or navigating re-renders this layout.
        var handled = false;
        await InvokeAsync(async () => handled = await BackNav.BackAsync());
        return handled;
    }

    /// <summary>
    /// What the bar calls the seeker: their seeker name when they gave one, else the first word of
    /// their name ("Hi, Ravi", not "Hi, Ravi Kumar Venkata"): the bar is one line on a narrow screen.
    /// From the token's claims, so it costs no request and is there on the first frame.
    /// </summary>
    private string GreetingName(System.Security.Claims.ClaimsPrincipal user)
    {
        var seeker = user.FindFirst("seekerName")?.Value;
        if (!string.IsNullOrWhiteSpace(seeker)) return seeker.Trim();

        var first = (user.FindFirst("fullName")?.Value ?? string.Empty)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .FirstOrDefault();
        return string.IsNullOrWhiteSpace(first) ? Loc["nav.guestName", "Guest"] : first;
    }

    /// <summary>The japa screen (not its completion page) takes the whole screen as its counter.</summary>
    private bool Immersive
    {
        get
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/');
            return path.StartsWith("sadhana/chant/", StringComparison.OrdinalIgnoreCase)
                && !path.EndsWith("/complete", StringComparison.OrdinalIgnoreCase);
        }
    }

    private string LangCode => string.IsNullOrWhiteSpace(Loc.CurrentCode) ? LocalizationState.BaseCode : Loc.CurrentCode;

    protected override async Task OnInitializedAsync()
    {
        Loc.OnChanged += LanguageChanged;
        Nav.LocationChanged += RouteChanged;
        MenuRefresh.OnChanged += MenuEdited;
        Menus.OnChanged += MenuChanged;
        Links.Arrived += LinkArrived;
        HardwareBack.Handler = OnHardwareBack;
        Links.Received += PushReceived;
        Links.TokenReplaced += PushTokenReplaced;

        SetRoute();
        await Loc.EnsureLoadedAsync();
        // Shared with the page: the home screen's quick actions are gated on this same fetch. A
        // language switch re-keys this layout (Routes.razor), and this call is what then refetches
        // the menu in the new language.
        await Menus.EnsureLoadedAsync();

        // A notification tapped while the app was closed: its page was waiting for a layout to
        // exist. Followed last, once the language and the menu are in, so the page it opens renders
        // complete rather than racing them.
        FollowLink();
    }

    private void LinkArrived() => InvokeAsync(FollowLink);

    // Both arrive from the native shell on its own thread; the notification centre raises OnChanged,
    // which the bell marshals onto the renderer itself.
    private void PushReceived() => _ = InvokeAsync(Center.RefreshInboxAsync);

    private void PushTokenReplaced() => _ = InvokeAsync(Center.RegisterDeviceAsync);

    /// <summary>Opens the page a tapped notification is about, and refreshes the bell: something has just arrived.</summary>
    private void FollowLink()
    {
        if (Links.Take() is not { } route) return;

        _ = Center.RefreshInboxAsync();
        Nav.NavigateTo(route.TrimStart('/'));
    }

    private void MenuEdited() => _ = InvokeAsync(Menus.ReloadAsync);

    private void MenuChanged() => InvokeAsync(StateHasChanged);

    // The server needs the current route to honour the per-form opt-out on the Forms tab.
    private void RouteChanged(object? sender, LocationChangedEventArgs e)
    {
        SetRoute();

        // A sheet left open over the page the user just navigated to is the classic phone-nav bug.
        if (_moreOpen || _accountOpen || _role is not null)
        {
            _moreOpen = _accountOpen = false;
            _role = null;
        }

        InvokeAsync(StateHasChanged);
    }

    private void SetRoute()
        => LangContext.Route = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Split('#')[0].Trim('/');

    private void LanguageChanged() => InvokeAsync(StateHasChanged);

    private void OpenMore()
    {
        _accountOpen = false;
        _moreOpen = true;
    }

    private void OpenAccount()
    {
        _moreOpen = false;
        _accountOpen = true;
    }

    private void ShowRole(RoleSummary role) => _role = role;

    private void CloseRole() => _role = null;

    private void CloseSheets()
    {
        _moreOpen = false;
        _accountOpen = false;
    }

    /// <summary>
    /// Kept in sync after every render rather than in the handlers, so a navigation-driven close
    /// releases the lock too. A stranded lock would leave the page unscrollable with no way back.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var wanted = _moreOpen || _accountOpen;
        if (wanted == _scrollLocked) return;

        _scrollLocked = wanted;
        try { await JS.InvokeVoidAsync(wanted ? "scScroll.lock" : "scScroll.release"); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }

    private async Task LogoutAsync()
    {
        CloseSheets();
        await AuthService.LogoutAsync();
        Nav.NavigateTo("login");
    }

    private static string Initials(string? name)
    {
        var parts = (name ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "🕉";
        return parts.Length == 1
            ? parts[0][..1].ToUpperInvariant()
            : (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
    }

    public void Dispose()
    {
        Loc.OnChanged -= LanguageChanged;
        Nav.LocationChanged -= RouteChanged;
        MenuRefresh.OnChanged -= MenuEdited;
        Menus.OnChanged -= MenuChanged;
        Links.Arrived -= LinkArrived;
        if (HardwareBack.Handler == OnHardwareBack) HardwareBack.Handler = null;
        Links.Received -= PushReceived;
        Links.TokenReplaced -= PushTokenReplaced;

        if (_scrollLocked)
        {
            // Fire-and-forget: Dispose cannot await, and a stranded lock would freeze the page.
            _ = JS.InvokeVoidAsync("scScroll.reset").AsTask();
        }
    }
}
