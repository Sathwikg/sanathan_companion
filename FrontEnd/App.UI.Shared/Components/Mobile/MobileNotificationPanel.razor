@* The panel the bell opens.

   Rendered by MobileLayout as a SIBLING of the top bar so its fixed scrim resolves against the
   viewport — see MobileNotificationBell for why it cannot live next to the button.

   Two halves. First the inbox: the notifications this seeker was actually sent (`GET
   notifications/inbox`), newest first, each opening the page it is about. The bell's badge counts
   the unread ones. Below it, what is switched on (`GET notifications/me`) with the server's own
   verdict on whether each would reach them right now, so "why did I not get one" has an answer
   without leaving the panel. *@
@implements IDisposable
@inject NotificationCenterState Center
@inject LocalizationState Loc
@inject NavigationManager Nav

@if (Center.IsOpen)
{
    <div class="scm-panel-scrim" @onclick="Close" aria-hidden="true"></div>
    <div class="scm-panel" role="dialog" aria-label="@Loc["nav.notifications", "Notifications"]">
        <div class="scm-panel-head">
            <div>
                <h2>@Loc["nav.notifications", "Notifications"]</h2>
                <span class="scm-panel-sub">
                    @if (Center.Settings is null)
                    {
                        @Loc["common.loading", "Loading…"]
                    }
                    else if (Center.Settings.InQuietHoursNow)
                    {
                        @Loc["nav.notifQuiet", "Quiet hours — the app is staying silent"]
                    }
                    else if (!Center.Settings.MasterEnabled)
                    {
                        @Loc["nav.notifPaused", "All notifications are paused"]
                    }
                    else
                    {
                        @Loc.TF("nav.notifActiveCount", "{0} active right now", Center.ActiveCount)
                    }
                </span>
            </div>
            <button class="scm-panel-x" @onclick="Close" aria-label="@Loc["common.close", "Close"]">✕</button>
        </div>

        <div class="scm-panel-body">
            @if (Center.IsLoading && Center.Settings is null)
            {
                <OmLoader Size="40" Message="@Loc["common.loading", "Loading…"]" />
            }
            else if (Center.Error is not null && Center.Settings is null)
            {
                <div class="sc-alert sc-alert-error">
                    @Loc["myNotifications.couldNotLoad", "Could not load your notification settings."] @Center.Error
                </div>
            }
            else
            {
                <h3 class="scm-panel-h">@Loc["nav.notifRecent", "Recent"]</h3>
                @if (Center.Inbox.Count == 0)
                {
                    <div class="scm-empty scm-empty-tight">
                        <div class="scm-empty-om">🪔</div>
                        <p>@Loc["nav.notifInboxEmpty", "Nothing yet. Notifications you receive will appear here."]</p>
                    </div>
                }
                else
                {
                    <ul class="scm-notif-list">
                        @foreach (var item in Center.Inbox)
                        {
                            <li>
                                <button class="scm-inbox @(item.IsRead ? "" : "is-new")" @onclick="() => Open(item)">
                                    <span class="scm-inbox-dot" aria-hidden="true"></span>
                                    <span class="scm-notif-text">
                                        <strong>@item.Title</strong>
                                        <span class="scm-notif-desc">@item.Body</span>
                                        <span class="scm-notif-meta">
                                            @if (!item.IsRead)
                                            {
                                                <span class="scm-notif-live">@Loc["nav.notifNew", "New"]</span>
                                            }
                                            <span class="scm-notif-off">@NotificationText.Ago(Loc, item.SentAtUtc, _now)</span>
                                        </span>
                                    </span>
                                </button>
                            </li>
                        }
                    </ul>
                }

                @if (Center.Settings is { Items.Count: > 0 } settings)
                {
                    <h3 class="scm-panel-h">@Loc["nav.notifSwitchedOn", "What You're Notified About"]</h3>
                    <ul class="scm-notif-list">
                        @foreach (var item in settings.Items.Where(i => i.IsEnabled).OrderByDescending(i => i.IsActiveNow))
                        {
                            <li class="scm-notif @(item.IsActiveNow ? "on" : "off")">
                                <span class="scm-notif-ic">@(string.IsNullOrWhiteSpace(item.Icon) ? "🔔" : item.Icon)</span>
                                <div class="scm-notif-text">
                                    <strong>@NotificationText.Title(Loc, item)</strong>
                                    <span class="scm-notif-meta">
                                        @if (item.IsActiveNow)
                                        {
                                            <span class="scm-notif-live">● @Loc["nav.notifActiveNow", "Active Now"]</span>
                                        }
                                        else
                                        {
                                            <span class="scm-notif-off">@(item.InactiveReason ?? Loc["nav.notifInactive", "Not Active"])</span>
                                        }
                                        @if (TimeText(item) is { } time)
                                        {
                                            <span class="scm-notif-window">@time</span>
                                        }
                                    </span>
                                </div>
                            </li>
                        }
                    </ul>
                }
            }
        </div>

        <div class="scm-panel-foot">
            <a class="sc-btn-primary sc-btn-sm" href="my-notifications" @onclick="Close" @onclick:preventDefault="false">
                @Loc["nav.notifManage", "Manage Notifications"] →
            </a>
        </div>
    </div>
}

@code {
    /// <summary>Read once per render pass so every row's "3 min ago" is measured from the same instant.</summary>
    private DateTime _now = DateTime.UtcNow;

    protected override void OnInitialized()
    {
        Center.OnChanged += Changed;
        Loc.OnChanged += Changed;
    }

    /// <summary>A type the seeker times shows its one time; a windowed type shows its span; the rest show nothing.</summary>
    private static string? TimeText(MyNotificationItem item)
    {
        if (item.Schedule == ReminderPlanner.UserTimeSchedule)
            return (item.FromTime ?? item.DefaultTime)?.ToString("HH:mm");

        return item.FromTime is { } from && item.ToTime is { } to ? $"{from:HH:mm}–{to:HH:mm}" : null;
    }

    private void Open(InboxItem item)
    {
        Center.Close();

        // The route came from the server's own catalogue, but it travelled through a push payload
        // on the way to some phones, so it is checked the same way wherever it is used.
        if (DeepLinks.IsInAppPath(item.Route))
            Nav.NavigateTo(item.Route!.TrimStart('/'));
    }

    private void Close() => Center.Close();

    private void Changed()
    {
        _now = DateTime.UtcNow;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Center.OnChanged -= Changed;
        Loc.OnChanged -= Changed;
    }
}
