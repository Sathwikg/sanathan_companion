@* Everything the bottom bar had no room for, as one grouped list. Same data as the sidebar,
   phone-shaped: a module with several forms keeps its heading and lists them; a module that is
   really one destination — childless with a route, or a group of exactly one form — is a plain
   row, because a heading over a single line only repeats it. Consecutive single rows share one
   list so they read as a set rather than as a run of one-line sections. There is deliberately no
   quick grid above the list any more: it showed the very items the list shows, so every one of
   them appeared twice on one sheet. *@
@implements IDisposable
@inject NavigationManager Nav
@inject LocalizationState Loc

@if (Menu is null)
{
    <div class="scm-more-loading"><OmLoader Size="44" Message="@Loc["common.loading", "Loading…"]" /></div>
}
else if (Menu.Count == 0)
{
    <div class="scm-empty">
        <div class="scm-empty-om">🪷</div>
        <p>@Loc["nav.noModules", "No sections are available on mobile for your role yet."]</p>
        <p class="sc-muted">@Loc["nav.noModulesHint", "An administrator can publish a form to mobile from Modules → Show in mobile, and grant it under Access Rights."]</p>
    </div>
}
else
{
    <div class="scm-more-tree">
        @foreach (var block in _blocks)
        {
            if (block.Group is { } group)
            {
                <section class="scm-group">
                    <h3 class="scm-group-head">
                        <span class="scm-group-ic">@Icon(group)</span>
                        <span>@Label(group)</span>
                    </h3>
                    <ul class="scm-rows">
                        @foreach (var child in block.Rows)
                        {
                            @Row(child)
                        }
                    </ul>
                </section>
            }
            else
            {
                <ul class="scm-rows">
                    @foreach (var node in block.Rows)
                    {
                        @Row(node)
                    }
                </ul>
            }
        }
    </div>
}

@code {
    [Parameter] public List<MenuTreeNode>? Menu { get; set; }
    [Parameter] public EventCallback OnNavigate { get; set; }

    /// <summary>A heading with its forms when <see cref="Group"/> is set; otherwise a run of standalone rows.</summary>
    private sealed record Block(MenuTreeNode? Group, List<MenuTreeNode> Rows);

    private List<Block> _blocks = new();
    private string _current = string.Empty;

    protected override void OnInitialized()
    {
        Loc.OnChanged += LanguageChanged;
        _current = Nav.ToBaseRelativePath(Nav.Uri);
    }

    protected override void OnParametersSet() => _blocks = Arrange(Menu ?? new List<MenuTreeNode>());

    private static List<Block> Arrange(IReadOnlyList<MenuTreeNode> tree)
    {
        var blocks = new List<Block>();
        foreach (var root in tree)
        {
            var single = SingleDestination(root);
            if (single is not null)
            {
                if (blocks.Count == 0 || blocks[^1].Group is not null)
                    blocks.Add(new Block(null, new List<MenuTreeNode>()));
                blocks[^1].Rows.Add(single);
            }
            else if (root.Children.Count > 0)
            {
                blocks.Add(new Block(root, root.Children.ToList()));
            }
            // A childless module without a route has nowhere to go and is left out.
        }
        return blocks;
    }

    /// <summary>The one form a module stands for, or null when it is a real group.</summary>
    private static MenuTreeNode? SingleDestination(MenuTreeNode root) => root.Children.Count switch
    {
        0 => string.IsNullOrWhiteSpace(root.RoutePath) ? null : root,
        1 when root.Children[0].Children.Count == 0 && !string.IsNullOrWhiteSpace(root.Children[0].RoutePath) => root.Children[0],
        _ => null
    };

    private RenderFragment Row(MenuTreeNode node) => @<li>
        <a class="scm-row @(MobileMenu.IsActive(node, _current) ? "active" : "")"
           href="@MobileMenu.Href(node)" @onclick="Navigated" @onclick:preventDefault="false">
            <span class="scm-row-ic">@Icon(node)</span>
            <span class="scm-row-label">@Label(node)</span>
            <span class="scm-row-chev">›</span>
        </a>
    </li>;

    private string Label(MenuTreeNode node) => Loc.Entity("MenuModule", node.Id, "Name", node.Name);

    private string Icon(MenuTreeNode node) => string.IsNullOrWhiteSpace(node.Icon) ? "•" : node.Icon!;

    /// <summary>
    /// Closes the sheet on tap. The anchor still performs the navigation — intercepting it would
    /// cost the browser's own handling of long-press, middle-click and "open in new tab".
    /// </summary>
    private Task Navigated() => OnNavigate.InvokeAsync();

    private void LanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Loc.OnChanged -= LanguageChanged;
}
