@*
    A password box with an eye button that shows or hides what was typed. Wraps the page's own
    input, so its binding, validation and autocomplete stay exactly as they were:

        <PasswordField Context="type">
            <InputText type="@type" @bind-Value="_model.Password" class="sc-input" ... />
        </PasswordField>

    The input must take its type from the context. Hidden again whenever the field is re-created,
    so a revealed password never survives leaving the page.
*@
@inherits LocalizedComponentBase

<div class="sc-pw @(_visible ? "is-visible" : "")">
    @ChildContent(_visible ? "text" : "password")
    <button type="button" class="sc-pw-eye" @onclick="Toggle"
            aria-pressed="@(_visible ? "true" : "false")"
            aria-label="@(_visible ? Loc["auth.hidePassword", "Hide Password"] : Loc["auth.showPassword", "Show Password"])"
            title="@(_visible ? Loc["auth.hidePassword", "Hide Password"] : Loc["auth.showPassword", "Show Password"])">
        @if (_visible)
        {
            @* Eye with a slash: the password is showing; tap to hide it. *@
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 3l18 18" />
                <path d="M10.6 5.1A10.4 10.4 0 0 1 12 5c5.5 0 9.3 4.6 10 7-.3 1-1.1 2.4-2.4 3.7" />
                <path d="M6.6 6.6C4.2 8 2.6 10.3 2 12c.8 2.4 4.5 7 10 7 1.9 0 3.6-.5 5-1.4" />
                <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" />
            </svg>
        }
        else
        {
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 12c.8-2.4 4.5-7 10-7s9.2 4.6 10 7c-.8 2.4-4.5 7-10 7S2.8 14.4 2 12z" />
                <circle cx="12" cy="12" r="3" />
            </svg>
        }
    </button>
</div>

@code {
    /// <summary>The input, given "password" or "text" for its type attribute.</summary>
    [Parameter, EditorRequired] public RenderFragment<string> ChildContent { get; set; } = default!;

    private bool _visible;

    private void Toggle() => _visible = !_visible;
}
