@* Reusable pager: windowed page buttons + "showing X–Y of Z". *@
@if (TotalCount > 0)
{
    <div class="sc-pager-wrap">
        @if (PageCount > 1)
        {
            <div class="sc-pager">
                <button class="sc-pager-btn" disabled="@(Page == 1)" @onclick="() => Go(Page - 1)">‹ Prev</button>
                @foreach (var p in PageNumbers)
                {
                    if (p == -1)
                    {
                        <span class="sc-pager-gap">…</span>
                    }
                    else
                    {
                        var page = p;
                        <button class="sc-pager-btn @(Page == page ? "active" : "")" @onclick="() => Go(page)">@(page)</button>
                    }
                }
                <button class="sc-pager-btn" disabled="@(Page == PageCount)" @onclick="() => Go(Page + 1)">Next ›</button>
            </div>
        }
        <div class="sc-pager-info">Showing @From–@To of @TotalCount</div>
    </div>
}

@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int PageCount { get; set; } = 1;
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public EventCallback<int> OnGoTo { get; set; }

    private int From => TotalCount == 0 ? 0 : (Page - 1) * PageSize + 1;
    private int To => Math.Min(Page * PageSize, TotalCount);

    private Task Go(int p) => OnGoTo.InvokeAsync(p);

    private IEnumerable<int> PageNumbers
    {
        get
        {
            if (PageCount <= 7)
            {
                for (var i = 1; i <= PageCount; i++) yield return i;
                yield break;
            }
            yield return 1;
            var start = Math.Max(2, Page - 1);
            var end = Math.Min(PageCount - 1, Page + 1);
            if (start > 2) yield return -1;
            for (var i = start; i <= end; i++) yield return i;
            if (end < PageCount - 1) yield return -1;
            yield return PageCount;
        }
    }
}
