@* Light/dark. Follows the device's own setting until the seeker taps it; a tap picks the other
   theme and keeps it. Tapping back to the theme the device is already showing returns to following
   the device, so there is no separate "System" option to find: the toggle always shows the
   opposite of what is on screen, and the device setting wins whenever the seeker has not overruled it. *@
@inject IThemeStore ThemeStore
@inject IJSRuntime JS
@implements IAsyncDisposable

<button class="sc-btn-ghost sc-theme-toggle" @onclick="ToggleAsync" title="Toggle Light / Dark">
    @(_dark ? "☀️" : "🌙")
</button>

@code {
    /// <summary>What is on screen.</summary>
    private bool _dark;

    /// <summary>The device's own setting, as the WebView reports it.</summary>
    private bool _systemDark;

    /// <summary>The seeker picked a theme; false while following the device.</summary>
    private bool _chosen;

    private DotNetObjectReference<ThemeToggle>? _self;
    private int? _listenHandle;

    protected override async Task OnInitializedAsync()
    {
        var stored = await ThemeStore.GetThemeAsync();

        try { _systemDark = await JS.InvokeAsync<bool>("scTheme.isSystemDark"); }
        catch (JSException) { _systemDark = false; }

        _chosen = string.Equals(stored, "dark", StringComparison.OrdinalIgnoreCase)
               || string.Equals(stored, "light", StringComparison.OrdinalIgnoreCase);

        _dark = _chosen ? string.Equals(stored, "dark", StringComparison.OrdinalIgnoreCase) : _systemDark;

        await ApplyAsync();

        try
        {
            _self = DotNetObjectReference.Create(this);
            _listenHandle = await JS.InvokeAsync<int>("scTheme.listen", _self);
        }
        catch (JSException) { /* an older page script: the icon simply updates on the next tap */ }
    }

    private async Task ToggleAsync()
    {
        _dark = !_dark;

        // Back to what the device shows: follow the device again rather than pinning it.
        _chosen = _dark != _systemDark;
        await ThemeStore.SetThemeAsync(_chosen ? (_dark ? "dark" : "light") : "system");
        await ApplyAsync();
    }

    /// <summary>The device switched (sunset, a control-centre toggle) while the app follows it.</summary>
    [JSInvokable]
    public Task OnSystemThemeChanged(bool dark) => InvokeAsync(() =>
    {
        _systemDark = dark;
        if (!_chosen) _dark = dark;
        StateHasChanged();
    });

    /// <summary>
    /// Goes through scTheme so the choice is also cached for the next cold start — on mobile the
    /// real store is MAUI Preferences, which the WebView cannot read before Blazor has booted.
    /// </summary>
    private async Task ApplyAsync()
        => await JS.InvokeVoidAsync("scTheme.apply", _chosen ? (_dark ? "dark" : "light") : "system");

    public async ValueTask DisposeAsync()
    {
        try { if (_listenHandle is { } handle) await JS.InvokeVoidAsync("scTheme.unlisten", handle); }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
        _self?.Dispose();
    }
}
