@inject IThemeStore ThemeStore
@inject IJSRuntime JS

<button class="sc-btn-ghost sc-theme-toggle" @onclick="ToggleAsync" title="Toggle light / dark">
    @(_dark ? "☀️" : "🌙")
</button>

@code {
    private bool _dark;

    protected override async Task OnInitializedAsync()
    {
        var theme = await ThemeStore.GetThemeAsync();
        _dark = string.Equals(theme, "dark", StringComparison.OrdinalIgnoreCase);
        await ApplyAsync();
    }

    private async Task ToggleAsync()
    {
        _dark = !_dark;
        await ThemeStore.SetThemeAsync(_dark ? "dark" : "light");
        await ApplyAsync();
    }

    /// <summary>
    /// Goes through scTheme so the choice is also cached for the next cold start — on mobile the
    /// real store is MAUI Preferences, which the WebView cannot read before Blazor has booted.
    /// </summary>
    private async Task ApplyAsync()
        => await JS.InvokeVoidAsync("scTheme.apply", _dark ? "dark" : "light");
}
