@* Dashboard component: a one-line Panchangam summary. Deliberately compact — only the three
   facts a seeker checks at a glance (tithi, nakshatram, Rahu Kalam); the whole strip opens the
   full Panchangam page for everything else. Best-effort: if there is no stored Panchangam for
   today it stays hidden rather than showing an empty shell.

   Linked="false" is for a seeker whose Access Rights do not include Panchangam: the facts are
   still worth reading, but a tappable strip with an arrow would lead to a page they are refused,
   so the same content renders as a plain card with no arrow. *@
@inherits LocalizedComponentBase
@implements IDisposable
@inject IApiClient Api
@inject RegionState Region

@if (_today is not null)
{
    @* The share button is a SIBLING of the card, never inside it: a button inside the linked <a>
       is invalid HTML (the tap would also follow the link), and the card lifts on hover with a
       transform, which would trap the share sheet's fixed backdrop inside it. The wrapper is the
       positioned box the button pins itself to. *@
    <div class="sc-pchg-mini-wrap">
        @if (Linked)
        {
            <a href="panchangam" class="sc-card sc-pchg-mini">
                @Summary(_today)
                <span class="sc-pchg-mini-go" aria-hidden="true">→</span>
            </a>
        }
        else
        {
            <div class="sc-card sc-pchg-mini">
                @Summary(_today)
            </div>
        }
        <PanchangamShare Inline="true" Day="_today" Date="_today.Date" LocationLabel="@(_today.RegionName ?? string.Empty)" />
    </div>
}

@code {
    /// <summary>
    /// True (the default) makes the strip a link to the Panchangam page. Pass false when the
    /// seeker cannot open that page.
    /// </summary>
    [Parameter] public bool Linked { get; set; } = true;

    private PanchangamModel? _today;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        Region.OnChanged += OnRegionChanged;
        await Region.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var today = DateOnly.FromDateTime(DateTime.Now);

            // A date range rather than GetPanchangamByDateAsync, because that one needs a concrete
            // region and the user may be on "All Regions".
            var rows = await Api.GetPanchangamsAsync(regionId: Region.SelectedRegionId, from: today, to: today);
            _today = rows.FirstOrDefault();
        }
        catch
        {
            // Best-effort — the dashboard must still render if Panchangam is unavailable.
            _today = null;
        }
    }

    private void OnRegionChanged()
        => _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    public override void Dispose()
    {
        Region.OnChanged -= OnRegionChanged;
        base.Dispose();
    }

    /// <summary>
    /// The icon and body shared by both wrappers, written once so the linked and plain strips
    /// cannot drift apart. The parameter must be named __builder for Razor to compile the markup.
    /// </summary>
    private RenderFragment Summary(PanchangamModel today) => __builder =>
    {
        <span class="sc-pchg-mini-ic">🗓️</span>

        <span class="sc-pchg-mini-body">
            <span class="sc-pchg-mini-head">
                <span class="sc-pchg-mini-title">@Loc["dashboard.panchangamTitle", "Today's Panchangam"]</span>
                <span class="sc-pchg-mini-date">@today.Date.ToString("ddd, dd MMM yyyy")</span>
                @if (!string.IsNullOrWhiteSpace(today.RegionName))
                {
                    <span class="sc-pchg-mini-region">🗺️ @today.RegionName</span>
                }
            </span>

            <span class="sc-pchg-mini-facts">
                @Fact(Loc["panchangam.tithi", "Tithi"], today.TithiDetails)
                @Fact(Loc["panchangam.nakshatram", "Nakshatram"], today.NakshatramDetails)
                @Fact(Loc["panchangam.rahuKalam", "Rahu Kalam"], today.RahuKalam, warn: true)
            </span>
        </span>
    };

    /// <summary>
    /// One label/value pair. The value is never trimmed in code — long values are ellipsised by
    /// CSS, because slicing a string by character count corrupts Indic scripts.
    /// </summary>
    private static RenderFragment? Fact(string label, string? value, bool warn = false)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;

        return builder =>
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", warn ? "sc-pchg-mini-fact warn" : "sc-pchg-mini-fact");
            builder.AddAttribute(2, "title", $"{label}: {value}");

            builder.OpenElement(3, "span");
            builder.AddAttribute(4, "class", "k");
            builder.AddContent(5, label);
            builder.CloseElement();

            builder.OpenElement(6, "span");
            builder.AddAttribute(7, "class", "v");
            builder.AddContent(8, value);
            builder.CloseElement();

            builder.CloseElement();
        };
    }
}
