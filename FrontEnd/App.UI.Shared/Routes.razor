@using App.UI.Shared.Layout
@using App.UI.Shared.Components
@inject LocalizationState Loc
@inject AppConfig Config
@inject SessionExpiredNotifier SessionExpired
@inject IAuthService AuthService
@inject NavigationManager Nav
@inject ToastService Toast
@implements IDisposable

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Routes).Assembly">
        <Found Context="routeData">
            @* Keyed on the language generation so switching language re-creates the page component
               and re-runs its data load. Database text is translated server-side, so the previously
               fetched rows are stale — a re-render alone would leave the old language's values on
               screen. The key must sit on the RouteView (which instantiates the page), not on a
               wrapper around @Body in the layout: that wrapper is a RenderFragment owned by the
               Router, and keying it does not re-instantiate the component inside. *@
            <AuthorizeRouteView @key="Loc.DataVersion" RouteData="@routeData" DefaultLayout="@Shell">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
                <Authorizing>
                    <OmLoader FullPage="true" Message="Authorizing…" />
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@Shell">
                <div class="sc-center">Page not found.</div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    /// <summary>
    /// The shell each host gets. Decided here from the injected config rather than passed in as a
    /// root-component parameter, so the two hosts stay identical at their mount points and the
    /// choice lives next to the routing it affects. Pages that set their own <c>@@layout</c>
    /// (Login, Register → AuthLayout) still override this.
    /// </summary>
    private Type Shell => Config.IsMobile ? typeof(MobileLayout) : typeof(MainLayout);

    protected override void OnInitialized()
    {
        Loc.OnChanged += Changed;
        SessionExpired.Expired += OnSessionExpired;
    }

    private void Changed() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// The API rejected the stored token, so end the session here rather than letting every screen
    /// discover it separately. Subscribed on the router because it outlives any single page — the
    /// 401 usually arrives from a request the user has already navigated away from.
    /// </summary>
    private void OnSessionExpired() => _ = InvokeAsync(async () =>
    {
        await AuthService.LogoutAsync();
        Toast.Info(Loc["auth.sessionEnded", "Your session has ended. Please sign in again."]);
        Nav.NavigateTo("login");
    });

    public void Dispose()
    {
        Loc.OnChanged -= Changed;
        SessionExpired.Expired -= OnSessionExpired;
    }
}
