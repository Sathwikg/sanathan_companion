@using App.UI.Shared.Layout
@using App.UI.Shared.Components
@inject LocalizationState Loc
@inject AppConfig Config
@inject SessionExpiredNotifier SessionExpired
@inject AccessDeniedNotifier AccessDenied
@inject IAuthService AuthService
@inject NavigationManager Nav
@inject ToastService Toast
@inject NavigationTrackerService NavTracker
@inject ClientErrorReporter ErrorReporter
@inject IDeviceFontScale FontScale
@inject IAppLifecycle Lifecycle
@inject IJSRuntime JS
@implements IDisposable

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Routes).Assembly">
        <Found Context="routeData">
            @* Keyed on the language generation so switching language re-creates the page component
               and re-runs its data load. Database text is translated server-side, so the previously
               fetched rows are stale — a re-render alone would leave the old language's values on
               screen. The key must sit on the RouteView (which instantiates the page), not on a
               wrapper around @Body in the layout: that wrapper is a RenderFragment owned by the
               Router, and keying it does not re-instantiate the component inside. *@
            <AuthorizeRouteView @key="Loc.DataVersion" RouteData="@routeData" DefaultLayout="@Shell">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
                <Authorizing>
                    <OmLoader FullPage="true" Message="Authorizing…" />
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@Shell">
                <div class="sc-center">Page not found.</div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    /// <summary>
    /// The shell each host gets. Decided here from the injected config rather than passed in as a
    /// root-component parameter, so the two hosts stay identical at their mount points and the
    /// choice lives next to the routing it affects. Pages that set their own <c>@@layout</c>
    /// (Login, Register → AuthLayout) still override this.
    /// </summary>
    private Type Shell => Config.IsMobile ? typeof(MobileLayout) : typeof(MainLayout);

    protected override void OnInitialized()
    {
        Loc.OnChanged += Changed;
        SessionExpired.Expired += OnSessionExpired;
        AccessDenied.Denied += OnAccessDenied;
        NavTracker.Initialize();
        // A native host may have saved the crash that ended the previous run.
        _ = ErrorReporter.SendPendingCrashAsync();
        Lifecycle.Changed += OnLifecycleChanged;
    }

    /// <summary>
    /// The phone's text size, applied here because this component is under every screen, the sign-in
    /// page included. Once at start, then each time the app returns to the front: that is when a
    /// change made in the phone's Settings arrives.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await ApplyFontScaleAsync();
    }

    private void OnLifecycleChanged()
    {
        if (Lifecycle.IsActive) _ = InvokeAsync(ApplyFontScaleAsync);
    }

    private async Task ApplyFontScaleAsync()
    {
        if (!FontScale.IsNative) return;
        try { await JS.InvokeVoidAsync("scDevice.setFontScale", FontScale.Read()); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        catch (JSException) { /* an older boot page without deviceDisplay.js: the default size */ }
    }

    private void Changed() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// The API rejected the stored token, so end the session here rather than letting every screen
    /// discover it separately. Subscribed on the router because it outlives any single page — the
    /// 401 usually arrives from a request the user has already navigated away from.
    /// </summary>
    private void OnSessionExpired() => _ = InvokeAsync(async () =>
    {
        await AuthService.LogoutAsync();
        Toast.Info(Loc["auth.sessionEnded", "Your session has ended. Please sign in again."]);
        Nav.NavigateTo("login");
    });

    /// <summary>
    /// The API refused a form this role is not granted. Land on a page that fetches nothing:
    /// sending the seeker to the app root would be a loop, because the root IS a gated form and a
    /// role without the Dashboard grant would be refused there too.
    /// </summary>
    private void OnAccessDenied() => _ = InvokeAsync(() =>
    {
        if (Nav.Uri.Contains("/access-denied", StringComparison.OrdinalIgnoreCase)) return;
        Nav.NavigateTo("access-denied");
    });

    public void Dispose()
    {
        Loc.OnChanged -= Changed;
        SessionExpired.Expired -= OnSessionExpired;
        AccessDenied.Denied -= OnAccessDenied;
        NavTracker.Dispose();
        Lifecycle.Changed -= OnLifecycleChanged;
    }
}
