@page "/sadhana/chant/{Id:guid}"
@attribute [Authorize]
@implements IDisposable
@inject IApiClient Api
@inject ToastService Toast
@inject NavigationManager Nav
@inject AppConfig Config
@inject FavoritesState Favs

<div class="sc-page-head">
    <div class="sc-page-title">
        <span class="sc-page-emoji">🪷</span>
        <div>
            <h1>@(_chant?.Name ?? "Sadhana")</h1>
            <p class="sc-page-sub">@(_chant?.CategoryName)@(_chant is not null && _chant.DeityNames.Count > 0 ? " · " + string.Join(", ", _chant.DeityNames) : "")</p>
        </div>
    </div>
    <div class="sc-page-actions">
        <button type="button" class="sc-fav lg @(Favs.IsChant(Id) ? "on" : null)"
                title="@(Favs.IsChant(Id) ? "Remove from favorites" : "Add to favorites")"
                @onclick="ToggleFavAsync">♥</button>
        <button class="sc-btn-ghost sc-btn-sm" @onclick="Back">← Back</button>
    </div>
</div>

@if (_error is not null)
{
    <div class="sc-alert sc-alert-error">@_error</div>
}

@if (_loading)
{
    <OmLoader FullPage="true" Message="Loading chant…" />
}
else if (_chant is null)
{
    <div class="sc-card sc-empty-state"><div class="sc-empty-om">🪷</div><h3>Chant not found</h3></div>
}
else
{
    <div class="sc-card">
        <div class="sc-japa">
            <div class="sc-japa-ring @(_flash ? "flash" : "")" @onclick="Tap">
                <div style="text-align:center">
                    <div class="sc-japa-count">@_countInMala</div>
                    <div class="sc-japa-of">of @_chant.TargetCount</div>
                    <div class="sc-japa-tap">Tap to chant</div>
                </div>
            </div>

            <div class="sc-japa-malas">
                <span class="n">@_malas</span>
                <span>mala@(_malas == 1 ? "" : "s") today</span>
                <span class="sc-muted">· @_total total</span>
            </div>

            @if (_cheer is not null)
            {
                <div class="sc-japa-cheer">@_cheer</div>
            }

            <div class="sc-japa-actions">
                <button class="sc-btn-ghost sc-btn-sm" @onclick="Undo" disabled="@(_total == 0)">− Undo</button>
                <button class="sc-btn-primary sc-btn-sm" @onclick="Tap">🙏 Chant +1</button>
            </div>
        </div>
    </div>

    @if (_chant.HasAudio)
    {
        <div class="sc-card">
            <h3 class="sc-detail-label">Audio</h3>
            <audio class="sc-audioplayer" controls src="@AudioUrl"></audio>
            @if (!string.IsNullOrWhiteSpace(_chant.AudioFileName))
            {
                <div class="sc-audiometa">@_chant.AudioFileName</div>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_chant.Description))
    {
        <div class="sc-card">
            <h3 class="sc-detail-label">About</h3>
            <p>@_chant.Description</p>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_chant.ChantText))
    {
        <div class="sc-card">
            <h3 class="sc-detail-label">Chant</h3>
            @* Server-side sanitized on save, safe to render. *@
            <div class="sc-richtext">@((MarkupString)_chant.ChantText)</div>
        </div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private SadhanaChantDetail? _chant;
    private bool _loading = true;
    private string? _error;

    private int _total;        // total repetitions today
    private int _malas;        // completed malas today
    private int _countInMala;  // progress within the current mala
    private bool _flash;
    private string? _cheer;

    private CancellationTokenSource? _saveCts;
    private bool _dirty;

    private string AudioUrl => $"{Config.ApiBaseUrl.TrimEnd('/')}/chantconfigs/{Id}/audio";

    protected override async Task OnInitializedAsync()
    {
        Favs.OnChanged += OnFavChanged;
        await Favs.EnsureLoadedAsync();
        StateHasChanged();
    }

    private void OnFavChanged() => InvokeAsync(StateHasChanged);

    private async Task ToggleFavAsync() => await Favs.ToggleChantAsync(Id);

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _chant = await Api.GetSadhanaChantAsync(Id);
            if (_chant is not null)
            {
                _total = _chant.TodayCount;
                _malas = _chant.TodayMalas;
                _countInMala = _chant.TargetCount > 0 ? _total - _malas * _chant.TargetCount : _total;
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task Tap()
    {
        if (_chant is null) return;

        _total++;
        _countInMala++;
        _cheer = null;

        if (_chant.TargetCount > 0 && _countInMala >= _chant.TargetCount)
        {
            _malas++;
            _countInMala = 0;
            _flash = true;
            await SaveNow();                 // persist the completed mala immediately
            _ = ResetFlashAsync();
        }
        else
        {
            _dirty = true;
            _ = DebounceSaveAsync();
        }
    }

    private async Task Undo()
    {
        if (_chant is null || _total == 0) return;
        _total--;
        if (_countInMala > 0) _countInMala--;
        else if (_malas > 0) { _malas--; _countInMala = _chant.TargetCount - 1; }
        _dirty = true;
        await SaveNow();
    }

    private async Task DebounceSaveAsync()
    {
        _saveCts?.Cancel();
        _saveCts = new CancellationTokenSource();
        var token = _saveCts.Token;
        try { await Task.Delay(1200, token); }
        catch (TaskCanceledException) { return; }
        await SaveNow();
    }

    private async Task SaveNow()
    {
        if (!_dirty && _cheer is null && !_flash) { /* still allow mala saves */ }
        _saveCts?.Cancel();
        try
        {
            var result = await Api.LogSadhanaCountAsync(new LogCountRequest { ChantConfigId = Id, TotalCount = _total });
            _dirty = false;
            if (result is not null)
            {
                if (result.StreakSecuredToday)
                    _cheer = $"🔥 Streak secured! You're on a {result.Streak.CurrentStreak}-day streak.";
                else if (result.MalaCompleted)
                    _cheer = "🌸 Mala complete! Keep going.";
                StateHasChanged();
            }
        }
        catch (Exception ex) { _error = "Could not save your count. " + ex.Message; }
    }

    private async Task ResetFlashAsync()
    {
        await Task.Delay(500);
        _flash = false;
        StateHasChanged();
    }

    private async Task Back()
    {
        if (_dirty) await SaveNow();
        Nav.NavigateTo("sadhana");
    }

    public void Dispose()
    {
        Favs.OnChanged -= OnFavChanged;
        _saveCts?.Cancel();
        // best-effort final save of any un-persisted taps
        if (_dirty)
            _ = Api.LogSadhanaCountAsync(new LogCountRequest { ChantConfigId = Id, TotalCount = _total });
    }
}
