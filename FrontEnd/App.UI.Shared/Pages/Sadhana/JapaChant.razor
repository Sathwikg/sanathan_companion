@page "/sadhana/chant/{Id:guid}"
@attribute [Authorize]
@inherits LocalizedComponentBase
@implements IDisposable
@inject IApiClient Api
@inject ToastService Toast
@inject ConfirmService Confirm
@inject NavigationManager Nav
@inject AppConfig Config
@inject FavoritesState Favs
@inject MediaUrlBuilder Media

<div class="sc-page-head">
    <div class="sc-page-title">
        <span class="sc-page-emoji">🪷</span>
        <div>
            <h1>@(_chant?.Name ?? Loc["sadhana.sadhanaLabel", "Sadhana"])</h1>
            <p class="sc-page-sub">@(_chant?.CategoryName)@(_chant is not null && _chant.DeityNames.Count > 0 ? " · " + string.Join(", ", _chant.DeityNames) : "")</p>
        </div>
    </div>
    <div class="sc-page-actions">
        <button type="button" class="sc-fav lg @(Favs.IsChant(Id) ? "on" : null)"
                title="@(Favs.IsChant(Id) ? Loc["favorites.removeFromFavorites", "Remove from Favorites"] : Loc["favorites.addToFavorites", "Add to Favorites"])"
                @onclick="ToggleFavAsync">♥</button>
        <button class="sc-btn-ghost sc-btn-sm" @onclick="Back">← @Loc["common.back", "Back"]</button>
    </div>
</div>

@if (_error is not null)
{
    <div class="sc-alert sc-alert-error">@_error</div>
}

@if (_loading)
{
    <OmLoader FullPage="true" Message="@Loc["sadhana.loadingChant", "Loading chant…"]" />
}
else if (_chant is null)
{
    <div class="sc-card sc-empty-state"><div class="sc-empty-om">🪷</div><h3>@Loc["sadhana.chantNotFound", "Chant Not Found"]</h3></div>
}
else
{
    @* sc-japa-card stays pinned under the top bar on the phone (mobile.css), so the counter and its
       buttons remain in reach while the seeker scrolls through the chant text below. *@
    <div class="sc-card sc-japa-card">
        <div class="sc-japa">
            <div class="sc-japa-ring @(_flash ? "flash" : "")" @onclick="Tap">
                <div style="text-align:center">
                    <div class="sc-japa-count">@_countInMala</div>
                    <div class="sc-japa-of">@Loc.TF("sadhana.ofCount", "of {0}", _chant.TargetCount)</div>
                    <div class="sc-japa-tap">@Loc["sadhana.tapToChant", "Tap to chant"]</div>
                </div>
            </div>

            <div class="sc-japa-malas">
                <span class="n">@_malas</span>
                <span>@(_malas == 1 ? Loc["sadhana.malaTodayOne", "mala today"] : Loc["sadhana.malasTodayMany", "malas today"])</span>
                <span class="sc-muted">· @Loc.TF("sadhana.totalCount", "{0} total", _total)</span>
            </div>

            @if (_cheer is not null)
            {
                <div class="sc-japa-cheer">@_cheer</div>
            }

            <div class="sc-japa-actions">
                <button class="sc-btn-ghost sc-btn-sm" @onclick="ResetAsync" disabled="@(_countInMala == 0)">↺ @Loc["sadhana.resetCount", "Reset Count"]</button>
                <button class="sc-btn-primary sc-btn-sm" @onclick="Tap">🙏 @Loc["sadhana.chantPlusOne", "Chant +1"]</button>
            </div>
        </div>
    </div>

    @if (_chant.HasAudio)
    {
        <div class="sc-card">
            <h3 class="sc-detail-label">@Loc["common.audio", "Audio"]</h3>
            <audio class="sc-audioplayer" controls src="@AudioUrl"></audio>
            @if (!string.IsNullOrWhiteSpace(_chant.AudioFileName))
            {
                <div class="sc-audiometa">@_chant.AudioFileName</div>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_chant.Description))
    {
        <div class="sc-card">
            <h3 class="sc-detail-label">@Loc["sadhana.about", "About"]</h3>
            <p>@_chant.Description</p>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_chant.ChantText))
    {
        <div class="sc-card">
            <h3 class="sc-detail-label">@Loc["sadhana.chantText", "Chant"]</h3>
            @* Server-side sanitized on save, safe to render. *@
            <div class="sc-richtext">@((MarkupString)_chant.ChantText)</div>
        </div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private SadhanaChantDetail? _chant;
    private bool _loading = true;
    private string? _error;

    private int _total;        // total repetitions today
    private int _malas;        // completed malas today
    private int _countInMala;  // progress within the current mala
    private bool _flash;
    private string? _cheer;

    private CancellationTokenSource? _saveCts;
    private readonly SemaphoreSlim _saveLock = new(1, 1);
    private bool _dirty;

    private string AudioUrl => Media.Absolute(ApiRoutes.Media.ChantAudio(Id));

    protected override async Task OnInitializedAsync()
    {
        // The ticket every media URL on this page carries; see MediaUrlBuilder.
        await Media.EnsureAsync();
        await base.OnInitializedAsync();
        Favs.OnChanged += OnFavChanged;
        await Favs.EnsureLoadedAsync();
        StateHasChanged();
    }

    private void OnFavChanged() => InvokeAsync(StateHasChanged);

    private async Task ToggleFavAsync() => await Favs.ToggleChantAsync(Id);

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _chant = await Api.GetSadhanaChantAsync(Id);
            if (_chant is not null)
            {
                _total = _chant.TodayCount;
                _malas = _chant.TodayMalas;
                _countInMala = _chant.TargetCount > 0 ? _total - _malas * _chant.TargetCount : _total;
            }
        }
        catch (Exception ex) { _error = Loc.ErrorText(ex); }
        finally { _loading = false; }
    }

    private async Task Tap()
    {
        if (_chant is null) return;

        _total++;
        _countInMala++;
        _cheer = null;

        if (_chant.TargetCount > 0 && _countInMala >= _chant.TargetCount)
        {
            _malas++;
            _countInMala = 0;
            _flash = true;
            await SaveNow();                 // persist the completed mala immediately
            _ = ResetFlashAsync();
        }
        else
        {
            _dirty = true;
            _ = DebounceSaveAsync();
        }
    }

    /// <summary>
    /// Clears the mala in progress — the big number on the ring — after a confirmation. Completed
    /// malas stay: they are already saved, and they are what the streak counts.
    /// </summary>
    private async Task ResetAsync()
    {
        if (_chant is null || _countInMala == 0) return;

        var confirmed = await Confirm.ConfirmAsync(
            Loc["sadhana.resetConfirmTitle", "Reset Count?"],
            Loc.TF("sadhana.resetConfirmBody", "This clears the {0} chants in your current mala. Completed malas are kept.", _countInMala),
            Loc["sadhana.resetCount", "Reset Count"],
            Loc["common.cancel", "Cancel"],
            ConfirmKind.Warning,
            "↺");
        if (!confirmed) return;

        _total -= _countInMala;
        _countInMala = 0;
        _cheer = null;
        _dirty = true;
        await SaveNow();
    }

    private async Task DebounceSaveAsync()
    {
        _saveCts?.Cancel();
        _saveCts = new CancellationTokenSource();
        var token = _saveCts.Token;
        try { await Task.Delay(1200, token); }
        catch (TaskCanceledException) { return; }
        await SaveNow();
    }

    private async Task SaveNow()
    {
        _saveCts?.Cancel();
        // One save at a time. Two in flight for a chant not yet logged today would both insert
        // the day's row, and the unique index turns the second into a 500. Each save sends the
        // latest total, so the one that waited simply carries the newer count.
        await _saveLock.WaitAsync();
        try
        {
            var sent = _total;
            var result = await Api.LogSadhanaCountAsync(new LogCountRequest { ChantConfigId = Id, TotalCount = sent });
            // Taps that landed while the request was out are still unsaved.
            _dirty = _total != sent;
            if (result is not null)
            {
                if (result.StreakSecuredToday)
                    _cheer = "🔥 " + Loc.TF("sadhana.streakSecured", "Streak secured! You're on a {0}-day streak.", result.Streak.CurrentStreak);
                else if (result.MalaCompleted)
                    _cheer = "🌸 " + Loc["sadhana.malaComplete", "Mala complete! Keep going."];
                StateHasChanged();
            }
        }
        catch (Exception ex) { _error = Loc["sadhana.couldNotSaveCount", "Could not save your count."] + " " + Loc.ErrorText(ex); }
        finally { _saveLock.Release(); }
    }

    private async Task ResetFlashAsync()
    {
        await Task.Delay(500);
        _flash = false;
        StateHasChanged();
    }

    private async Task Back()
    {
        if (_dirty) await SaveNow();
        Nav.NavigateTo("sadhana");
    }

    private async Task SaveOnLeaveAsync(int total)
    {
        await _saveLock.WaitAsync();
        try { await Api.LogSadhanaCountAsync(new LogCountRequest { ChantConfigId = Id, TotalCount = total }); }
        catch { /* the page is gone; nowhere left to report it */ }
        finally { _saveLock.Release(); }
    }

    public override void Dispose()
    {
        Favs.OnChanged -= OnFavChanged;
        _saveCts?.Cancel();
        // best-effort final save of any un-persisted taps, queued behind a save still in flight
        if (_dirty)
            _ = SaveOnLeaveAsync(_total);
        base.Dispose();
    }
}
