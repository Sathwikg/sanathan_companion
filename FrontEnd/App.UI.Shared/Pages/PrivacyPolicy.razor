@page "/privacy"
@page "/privacy-policy"
@attribute [AllowAnonymous]
@layout PublicLayout
@inherits LocalizedComponentBase
@inject IJSRuntime JS

@* The notice's text lives in PrivacyNoticeBody, which the sign-up and consent screens also show. *@
<div class="sc-privacy-container">
    <div class="sc-privacy-card">

        <div class="sc-privacy-title-area">
            <h1 class="sc-privacy-h1">@Loc["privacy.noticeTitle", "Privacy Notice"]</h1>
            <p class="sc-privacy-sub">
                @Loc.TF("privacy.appSub", "{0} — Dedicated to spiritual growth and seeker privacy", Brand.AppName)
            </p>
            <div class="sc-privacy-badge-row">
                <span class="sc-privacy-badge">🕉️ @Loc["privacy.badgeDharma", "Dharma & Trust"]</span>
                <span class="sc-privacy-badge">🔒 @Loc["privacy.badgeEncrypted", "Encrypted in Transit"]</span>
                <span class="sc-privacy-badge">🛡️ @Loc["privacy.badgeNoSale", "Zero Data Selling"]</span>
                <span class="sc-privacy-badge">🇮🇳 @Loc["privacy.badgeDpdp", "DPDP Act, 2023"]</span>
            </div>
        </div>

        <div class="sc-privacy-actions-bar">
            <button type="button" class="sc-btn-ghost sc-btn-sm" @onclick="PrintPolicy">
                🖨️ @Loc["privacy.print", "Print / Save as PDF"]
            </button>
            <AuthorizeView>
                <Authorized>
                    <a href="profile" class="sc-btn-ghost sc-btn-sm">🔐 @Loc["privacy.manageChoices", "Manage My Privacy"]</a>
                    <a href="" class="sc-btn-primary sc-btn-sm">← @Loc["common.backToDashboard", "Back to Dashboard"]</a>
                </Authorized>
                <NotAuthorized>
                    <a href="login" class="sc-btn-primary sc-btn-sm">← @Loc["auth.signInInstead", "Sign In"]</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <PrivacyNoticeBody />

        <footer class="sc-privacy-card-footer">
            <p>© 2026 @Brand.CompanyName · @Brand.AppName</p>
        </footer>
    </div>
</div>

@code {
    private async Task PrintPolicy()
    {
        try { await JS.InvokeVoidAsync("window.print"); }
        catch (JSException) { /* the phone's web view has no print dialog */ }
    }
}
