@page "/users"
@attribute [Authorize]
@inherits LocalizedComponentBase
@inject IApiClient Api

<div class="sc-page-head">
    <div class="sc-page-title">
        <span class="sc-page-emoji">👥</span>
        <div>
            <h1>@Loc["users.title", "Users"]</h1>
            <p class="sc-page-sub">@Loc["users.sub", "Registered seekers and their profiles"]</p>
        </div>
    </div>
    @if (!_forbidden)
    {
        <div class="sc-page-actions">
            <div class="sc-viewtoggle">
                <button class="@(_view == "grid" ? "active" : "")" @onclick='() => _view = "grid"'>▦ @Loc["common.cardView", "Cards"]</button>
                <button class="@(_view == "list" ? "active" : "")" @onclick='() => _view = "list"'>☰ @Loc["common.listView", "List"]</button>
            </div>
        </div>
    }
</div>

@if (_forbidden)
{
    <div class="sc-card sc-empty-state">
        <div class="sc-empty-om">🔒</div>
        <h3>@Loc["common.adminOnly", "Administrator access required"]</h3>
        <p>@Loc["common.adminOnlyBody", "The User master is available to administrators only."]</p>
    </div>
}
else if (_error is not null)
{
    <div class="sc-alert sc-alert-error">@_error</div>
}
else if (_loading)
{
    <OmLoader FullPage="true" Message="@Loc["common.loading", "Loading…"]" />
}
else
{
    <div class="sc-card sc-filtercard">
        <div class="sc-filter" style="min-width:280px">
            <label>@Loc["common.search", "Search"]</label>
            <input class="sc-input sc-input-sm" placeholder="@Loc["users.searchPlaceholder", "Name, email, mobile or role…"]" @bind="_search" @bind:event="oninput" @bind:after="() => _page = 1" />
        </div>
    </div>

    @if (Filtered.Count == 0)
    {
        <div class="sc-card sc-empty-state"><div class="sc-empty-om">👥</div><h3>@Loc.TF("msg.noItemsFound", "No {0} found", Loc["users.entityPlural", "users"])</h3></div>
    }
    else if (_view == "grid")
    {
        <div class="sc-cardgrid">
            @foreach (var u in Paged)
            {
                <div class="sc-tile" @onclick="() => Open(u)" style="cursor:pointer">
                    <div class="sc-tile-top">
                        <div class="sc-avatar"><span>@Initials(u.FullName)</span></div>
                        <span class="sc-typechip @(u.IsAdmin ? "god" : "goddess")">@u.RoleName</span>
                    </div>
                    <h3 class="sc-tile-title">@u.FullName</h3>
                    @if (!string.IsNullOrWhiteSpace(u.SeekerName))
                    {
                        <p class="sc-tile-desc">🕉️ @u.SeekerName</p>
                    }
                    <div class="sc-pchg-row"><span class="k">@Loc["common.email", "Email"]</span><span class="v">@u.Email</span></div>
                    <div class="sc-pchg-row"><span class="k">@Loc["common.mobile", "Mobile"]</span><span class="v">@u.MobileNumber</span></div>
                    <div class="sc-tile-meta">🔥 @Loc.TF("users.dayStreak", "{0} day streak", u.CurrentStreak) · 🧮 @Loc.TF("users.malasCount", "{0} malas", u.TotalMalas)</div>
                    <div class="sc-tile-foot">
                        <span class="sc-muted">@Loc.TF("users.joinedOn", "Joined {0}", u.RegisteredOn.ToLocalTime().ToString("dd MMM yyyy"))</span>
                        <button class="sc-btn-ghost sc-btn-sm" @onclick="() => Open(u)" @onclick:stopPropagation="true">@Loc["users.viewProfile", "View profile"]</button>
                    </div>
                </div>
            }
        </div>
        <Pager Page="_page" PageCount="PageCount" TotalCount="Filtered.Count" PageSize="PageSize" OnGoTo="GoTo" />
    }
    else
    {
        <div class="sc-card sc-tablewrap">
            <table class="sc-table">
                <thead>
                    <tr><th>@Loc["users.userColumn", "User"]</th><th>@Loc["common.email", "Email"]</th><th>@Loc["common.mobile", "Mobile"]</th><th>@Loc["common.role", "Role"]</th><th>@Loc["users.streakColumn", "Streak"]</th><th>@Loc["users.malasColumn", "Malas"]</th><th>@Loc["users.joinedColumn", "Joined"]</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var u in Paged)
                    {
                        <tr>
                            <td><strong>@u.FullName</strong>@(string.IsNullOrWhiteSpace(u.SeekerName) ? "" : $" · {u.SeekerName}")</td>
                            <td class="sc-muted">@u.Email</td>
                            <td class="sc-muted">@u.MobileNumber</td>
                            <td><span class="sc-typechip @(u.IsAdmin ? "god" : "goddess")">@u.RoleName</span></td>
                            <td>🔥 @u.CurrentStreak</td>
                            <td>@u.TotalMalas</td>
                            <td class="sc-muted">@u.RegisteredOn.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td><button class="sc-btn-ghost sc-btn-sm" @onclick="() => Open(u)">@Loc["common.view", "View"]</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Pager Page="_page" PageCount="PageCount" TotalCount="Filtered.Count" PageSize="PageSize" OnGoTo="GoTo" />
    }
}

<ScModal Visible="_showProfile" Title="@Loc["users.profileTitle", "User Profile"]" OnClose="() => _showProfile = false">
    @if (_loadingProfile)
    {
        <OmLoader Inline="true" Size="26" Message="@Loc["common.loading", "Loading…"]" />
    }
    else if (_profile is not null)
    {
        var p = _profile;
        <div class="sc-detail-head">
            <div class="sc-avatar sc-avatar-lg" style="width:60px;height:60px;border-radius:16px"><span style="font-size:1.4rem">@Initials(p.FullName)</span></div>
            <div>
                <h2>@p.FullName</h2>
                <div class="sc-muted">@(string.IsNullOrWhiteSpace(p.SeekerName) ? "" : $"🕉️ {p.SeekerName} · ")<span class="sc-typechip @(p.IsAdmin ? "god" : "goddess")">@p.RoleName</span></div>
            </div>
        </div>

        <div class="sc-detail-grid" style="margin-top:1rem">
            <div class="sc-detail-item"><span class="sc-detail-label">@Loc["common.email", "Email"]</span><span class="sc-detail-value">@p.Email</span></div>
            <div class="sc-detail-item"><span class="sc-detail-label">@Loc["common.mobile", "Mobile"]</span><span class="sc-detail-value">@p.MobileNumber</span></div>
            <div class="sc-detail-item"><span class="sc-detail-label">@Loc["users.registered", "Registered"]</span><span class="sc-detail-value">@p.RegisteredOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span></div>
            <div class="sc-detail-item"><span class="sc-detail-label">@Loc["users.lastPractice", "Last practice"]</span><span class="sc-detail-value">@(p.LastPracticeDate?.ToString("dd MMM yyyy") ?? "—")</span></div>
        </div>

        <div class="sc-detail-section">
            <h3>@Loc["users.sadhana", "Sadhana"]</h3>
            <div class="sc-streak-stats" style="margin:0;flex-wrap:wrap;gap:1.6rem">
                <div class="sc-streak-stat"><div class="n">🔥 @p.CurrentStreak</div><div class="l">@Loc["users.currentStreak", "Current streak"]</div></div>
                <div class="sc-streak-stat"><div class="n">@p.LongestStreak</div><div class="l">@Loc["users.longestStreak", "Longest"]</div></div>
                <div class="sc-streak-stat"><div class="n">@p.TotalMalas</div><div class="l">@Loc["users.totalMalas", "Total malas"]</div></div>
                <div class="sc-streak-stat"><div class="n">@p.TotalDaysPracticed</div><div class="l">@Loc["users.daysPracticed", "Days practiced"]</div></div>
            </div>
        </div>

        @if (p.RecentSadhana.Count > 0)
        {
            <div class="sc-detail-section">
                <h3>@Loc["users.recentPractice", "Recent practice"]</h3>
                <div class="sc-tablewrap">
                    <table class="sc-table">
                        <thead><tr><th>@Loc["common.date", "Date"]</th><th>@Loc["users.chantColumn", "Chant"]</th><th>@Loc["users.deityColumn", "Deity"]</th><th>@Loc["users.malasColumn", "Malas"]</th><th>@Loc["common.count", "Count"]</th></tr></thead>
                        <tbody>
                            @foreach (var e in p.RecentSadhana)
                            {
                                <tr>
                                    <td>@e.Date.ToString("dd MMM")</td>
                                    <td><strong>@e.ChantName</strong></td>
                                    <td class="sc-muted">@(e.DeityName ?? "—")</td>
                                    <td>@e.MalasCompleted</td>
                                    <td class="sc-muted">@e.TotalCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <p class="sc-muted">@Loc["users.noSadhana", "No sadhana practised yet."]</p>
        }
    }
</ScModal>

@code {
    private List<UserListItem> _users = new();
    private string _view = "grid";
    private string _search = string.Empty;
    private bool _loading = true;
    private bool _forbidden;
    private string? _error;

    private int _page = 1;
    private const int PageSize = 9;

    private bool _showProfile;
    private bool _loadingProfile;
    private UserProfile? _profile;

    private List<UserListItem> Filtered
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_search)) return _users;
            var t = _search.Trim();
            return _users.Where(u =>
                u.FullName.Contains(t, StringComparison.OrdinalIgnoreCase) ||
                u.Email.Contains(t, StringComparison.OrdinalIgnoreCase) ||
                u.MobileNumber.Contains(t, StringComparison.OrdinalIgnoreCase) ||
                (u.SeekerName?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false) ||
                u.RoleName.Contains(t, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    private int PageCount => Math.Max(1, (int)Math.Ceiling(Filtered.Count / (double)PageSize));
    private IEnumerable<UserListItem> Paged => Filtered.Skip((_page - 1) * PageSize).Take(PageSize);

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        var (ok, users, forbidden, err) = await Api.GetUsersAsync();
        _forbidden = forbidden;
        if (ok) _users = users;
        else if (!forbidden) _error = err;
        _loading = false;
    }

    private void GoTo(int page) => _page = Math.Clamp(page, 1, PageCount);

    private async Task Open(UserListItem u)
    {
        _showProfile = true;
        _loadingProfile = true;
        _profile = null;
        try { _profile = await Api.GetUserProfileAsync(u.UserId); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loadingProfile = false; }
    }

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        return parts.Length == 1
            ? parts[0][..1].ToUpper()
            : (parts[0][..1] + parts[^1][..1]).ToUpper();
    }
}
