@page "/users"
@attribute [Authorize]
@inject IApiClient Api

<div class="sc-page-head">
    <div class="sc-page-title">
        <span class="sc-page-emoji">👥</span>
        <div>
            <h1>Users</h1>
            <p class="sc-page-sub">Registered seekers and their profiles</p>
        </div>
    </div>
    @if (!_forbidden)
    {
        <div class="sc-page-actions">
            <div class="sc-viewtoggle">
                <button class="@(_view == "grid" ? "active" : "")" @onclick='() => _view = "grid"'>▦ Cards</button>
                <button class="@(_view == "list" ? "active" : "")" @onclick='() => _view = "list"'>☰ List</button>
            </div>
        </div>
    }
</div>

@if (_forbidden)
{
    <div class="sc-card sc-empty-state">
        <div class="sc-empty-om">🔒</div>
        <h3>Administrator access required</h3>
        <p>The User master is available to administrators only.</p>
    </div>
}
else if (_error is not null)
{
    <div class="sc-alert sc-alert-error">@_error</div>
}
else if (_loading)
{
    <OmLoader FullPage="true" Message="Loading users…" />
}
else
{
    <div class="sc-card sc-filtercard">
        <div class="sc-filter" style="min-width:280px">
            <label>Search</label>
            <input class="sc-input sc-input-sm" placeholder="Name, email, mobile or role…" @bind="_search" @bind:event="oninput" @bind:after="() => _page = 1" />
        </div>
    </div>

    @if (Filtered.Count == 0)
    {
        <div class="sc-card sc-empty-state"><div class="sc-empty-om">👥</div><h3>No users found</h3></div>
    }
    else if (_view == "grid")
    {
        <div class="sc-cardgrid">
            @foreach (var u in Paged)
            {
                <div class="sc-tile" @onclick="() => Open(u)" style="cursor:pointer">
                    <div class="sc-tile-top">
                        <div class="sc-avatar"><span>@Initials(u.FullName)</span></div>
                        <span class="sc-typechip @(u.RoleName == "Admin" ? "god" : "goddess")">@u.RoleName</span>
                    </div>
                    <h3 class="sc-tile-title">@u.FullName</h3>
                    @if (!string.IsNullOrWhiteSpace(u.SeekerName))
                    {
                        <p class="sc-tile-desc">🕉️ @u.SeekerName</p>
                    }
                    <div class="sc-pchg-row"><span class="k">Email</span><span class="v">@u.Email</span></div>
                    <div class="sc-pchg-row"><span class="k">Mobile</span><span class="v">@u.MobileNumber</span></div>
                    <div class="sc-tile-meta">🔥 @u.CurrentStreak day streak · 🧮 @u.TotalMalas malas</div>
                    <div class="sc-tile-foot">
                        <span class="sc-muted">Joined @u.RegisteredOn.ToLocalTime().ToString("dd MMM yyyy")</span>
                        <button class="sc-btn-ghost sc-btn-sm" @onclick="() => Open(u)" @onclick:stopPropagation="true">View profile</button>
                    </div>
                </div>
            }
        </div>
        <Pager Page="_page" PageCount="PageCount" TotalCount="Filtered.Count" PageSize="PageSize" OnGoTo="GoTo" />
    }
    else
    {
        <div class="sc-card sc-tablewrap">
            <table class="sc-table">
                <thead>
                    <tr><th>User</th><th>Email</th><th>Mobile</th><th>Role</th><th>Streak</th><th>Malas</th><th>Joined</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var u in Paged)
                    {
                        <tr>
                            <td><strong>@u.FullName</strong>@(string.IsNullOrWhiteSpace(u.SeekerName) ? "" : $" · {u.SeekerName}")</td>
                            <td class="sc-muted">@u.Email</td>
                            <td class="sc-muted">@u.MobileNumber</td>
                            <td><span class="sc-typechip @(u.RoleName == "Admin" ? "god" : "goddess")">@u.RoleName</span></td>
                            <td>🔥 @u.CurrentStreak</td>
                            <td>@u.TotalMalas</td>
                            <td class="sc-muted">@u.RegisteredOn.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td><button class="sc-btn-ghost sc-btn-sm" @onclick="() => Open(u)">View</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Pager Page="_page" PageCount="PageCount" TotalCount="Filtered.Count" PageSize="PageSize" OnGoTo="GoTo" />
    }
}

<ScModal Visible="_showProfile" Title="User Profile" OnClose="() => _showProfile = false">
    @if (_loadingProfile)
    {
        <OmLoader Inline="true" Size="26" Message="Loading profile…" />
    }
    else if (_profile is not null)
    {
        var p = _profile;
        <div class="sc-detail-head">
            <div class="sc-avatar sc-avatar-lg" style="width:60px;height:60px;border-radius:16px"><span style="font-size:1.4rem">@Initials(p.FullName)</span></div>
            <div>
                <h2>@p.FullName</h2>
                <div class="sc-muted">@(string.IsNullOrWhiteSpace(p.SeekerName) ? "" : $"🕉️ {p.SeekerName} · ")<span class="sc-typechip @(p.RoleName == "Admin" ? "god" : "goddess")">@p.RoleName</span></div>
            </div>
        </div>

        <div class="sc-detail-grid" style="margin-top:1rem">
            <div class="sc-detail-item"><span class="sc-detail-label">Email</span><span class="sc-detail-value">@p.Email</span></div>
            <div class="sc-detail-item"><span class="sc-detail-label">Mobile</span><span class="sc-detail-value">@p.MobileNumber</span></div>
            <div class="sc-detail-item"><span class="sc-detail-label">Registered</span><span class="sc-detail-value">@p.RegisteredOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span></div>
            <div class="sc-detail-item"><span class="sc-detail-label">Last practice</span><span class="sc-detail-value">@(p.LastPracticeDate?.ToString("dd MMM yyyy") ?? "—")</span></div>
        </div>

        <div class="sc-detail-section">
            <h3>Sadhana</h3>
            <div class="sc-streak-stats" style="margin:0;flex-wrap:wrap;gap:1.6rem">
                <div class="sc-streak-stat"><div class="n">🔥 @p.CurrentStreak</div><div class="l">Current streak</div></div>
                <div class="sc-streak-stat"><div class="n">@p.LongestStreak</div><div class="l">Longest</div></div>
                <div class="sc-streak-stat"><div class="n">@p.TotalMalas</div><div class="l">Total malas</div></div>
                <div class="sc-streak-stat"><div class="n">@p.TotalDaysPracticed</div><div class="l">Days practiced</div></div>
            </div>
        </div>

        @if (p.RecentSadhana.Count > 0)
        {
            <div class="sc-detail-section">
                <h3>Recent practice</h3>
                <div class="sc-tablewrap">
                    <table class="sc-table">
                        <thead><tr><th>Date</th><th>Chant</th><th>Deity</th><th>Malas</th><th>Count</th></tr></thead>
                        <tbody>
                            @foreach (var e in p.RecentSadhana)
                            {
                                <tr>
                                    <td>@e.Date.ToString("dd MMM")</td>
                                    <td><strong>@e.ChantName</strong></td>
                                    <td class="sc-muted">@(e.DeityName ?? "—")</td>
                                    <td>@e.MalasCompleted</td>
                                    <td class="sc-muted">@e.TotalCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <p class="sc-muted">No sadhana practised yet.</p>
        }
    }
</ScModal>

@code {
    private List<UserListItem> _users = new();
    private string _view = "grid";
    private string _search = string.Empty;
    private bool _loading = true;
    private bool _forbidden;
    private string? _error;

    private int _page = 1;
    private const int PageSize = 9;

    private bool _showProfile;
    private bool _loadingProfile;
    private UserProfile? _profile;

    private List<UserListItem> Filtered
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_search)) return _users;
            var t = _search.Trim();
            return _users.Where(u =>
                u.FullName.Contains(t, StringComparison.OrdinalIgnoreCase) ||
                u.Email.Contains(t, StringComparison.OrdinalIgnoreCase) ||
                u.MobileNumber.Contains(t, StringComparison.OrdinalIgnoreCase) ||
                (u.SeekerName?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false) ||
                u.RoleName.Contains(t, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    private int PageCount => Math.Max(1, (int)Math.Ceiling(Filtered.Count / (double)PageSize));
    private IEnumerable<UserListItem> Paged => Filtered.Skip((_page - 1) * PageSize).Take(PageSize);

    protected override async Task OnInitializedAsync()
    {
        var (ok, users, forbidden, err) = await Api.GetUsersAsync();
        _forbidden = forbidden;
        if (ok) _users = users;
        else if (!forbidden) _error = err;
        _loading = false;
    }

    private void GoTo(int page) => _page = Math.Clamp(page, 1, PageCount);

    private async Task Open(UserListItem u)
    {
        _showProfile = true;
        _loadingProfile = true;
        _profile = null;
        try { _profile = await Api.GetUserProfileAsync(u.UserId); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loadingProfile = false; }
    }

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        return parts.Length == 1
            ? parts[0][..1].ToUpper()
            : (parts[0][..1] + parts[^1][..1]).ToUpper();
    }
}
