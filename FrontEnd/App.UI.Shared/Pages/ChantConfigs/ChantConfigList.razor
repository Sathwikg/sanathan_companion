@page "/chants-config"
@attribute [Authorize]
@inherits LocalizedComponentBase
@inject IApiClient Api
@inject ConfirmService Confirm
@inject ToastService Toast
@inject NavigationManager Nav

<div class="sc-page-head">
    <div class="sc-page-title">
        <span class="sc-page-emoji">📜</span>
        <div>
            <h1>@Loc["chantsConfig.title", "Chants Config"]</h1>
            <p class="sc-page-sub">@Loc["chantsConfig.sub", "Configure the chants under each chant category"]</p>
        </div>
    </div>
    <div class="sc-page-actions">
        <div class="sc-viewtoggle">
            <button class="@(_view == "list" ? "active" : "")" @onclick='() => SetView("list")'>☰ @Loc["common.listView", "List"]</button>
            <button class="@(_view == "grid" ? "active" : "")" @onclick='() => SetView("grid")'>▦ @Loc["common.cardView", "Cards"]</button>
        </div>
        <button class="sc-btn-primary sc-btn-sm" @onclick='() => Nav.NavigateTo("chants-config/create")'>+ @Loc["chantsConfig.addNew", "Add New Chant"]</button>
    </div>
</div>

<div class="sc-card sc-filtercard">
    <div class="sc-filters">
        <div class="sc-filter">
            <label>@Loc["common.type", "Type"]</label>
            <SearchableSelect Options="CategoryOptions" Value="@_chantId" ValueChanged="OnTypeChanged"
                              EmptyLabel="@Loc["chantsConfig.allTypes", "All types"]" SearchPlaceholder="@Loc["chantsConfig.searchTypes", "Search types…"]" />
        </div>
        <div class="sc-filter">
            <label>@Loc["chantsConfig.deity", "Deity"]</label>
            <SearchableSelect Options="DeityOptions" Value="@_deityId" ValueChanged="OnDeityChanged"
                              EmptyLabel="@Loc["chantsConfig.allDeities", "All deities"]" SearchPlaceholder="@Loc["chantsConfig.searchDeities", "Search deities…"]" />
        </div>
        <div class="sc-filter">
            <label>@Loc["common.time", "Time"]</label>
            <SearchableSelect Options="TimeSelectOptions" Value="@_timeFilter" ValueChanged="OnTimeChanged"
                              EmptyLabel="@Loc["chantsConfig.allTimes", "All times"]" SearchPlaceholder="@Loc["chantsConfig.searchTimes", "Search times…"]" />
        </div>
        <div class="sc-filter">
            <label>@Loc["common.search", "Search"]</label>
            <input class="sc-input sc-input-sm" placeholder="@Loc["chantsConfig.searchPlaceholder", "Name or description…"]" @bind="_search" @bind:event="oninput" @bind:after="OnSearchAsync" />
        </div>
    </div>
</div>

@if (_error is not null)
{
    <div class="sc-alert sc-alert-error">@_error</div>
}

@if (_loading)
{
    <OmLoader FullPage="true" Message="@Loc["chantsConfig.loading", "Loading chants…"]" />
}
else if (Filtered.Count == 0)
{
    <div class="sc-card sc-empty-state">
        <div class="sc-empty-om">📜</div>
        <h3>@Loc["chantsConfig.emptyTitle", "No chants configured"]</h3>
        <p>@(HasFilters ? Loc["chantsConfig.noMatch", "No chants match the current filters."] : Loc["chantsConfig.emptyBody", "Add your first chant to get started."])</p>
        <button class="sc-btn-primary sc-btn-sm" @onclick='() => Nav.NavigateTo("chants-config/create")'>+ @Loc["chantsConfig.addNew", "Add New Chant"]</button>
    </div>
}
else if (_view == "grid")
{
    <div class="sc-cardgrid">
        @foreach (var c in Paged)
        {
            <div class="sc-tile @(c.IsActive ? "" : "is-inactive")">
                <div class="sc-tile-top">
                    <span class="sc-minichip">@c.ChantName</span>
                    <span class="sc-badge @(c.IsActive ? "on" : "off")">@(c.IsActive ? Loc["common.active", "Active"] : Loc["common.inactive", "Inactive"])</span>
                </div>

                <h3 class="sc-tile-title">@c.Name</h3>
                <p class="sc-tile-desc">@(string.IsNullOrWhiteSpace(c.Description) ? Loc["common.noDescription", "No description"] : c.Description)</p>

                @if (!string.IsNullOrWhiteSpace(c.TextPreview))
                {
                    <p class="sc-tile-preview">@c.TextPreview</p>
                }

                @if (c.DeityNames.Count > 0)
                {
                    <div class="sc-chiprow">@foreach (var d in c.DeityNames) { <span class="sc-minichip">@d</span> }</div>
                }

                <div class="sc-tile-meta">
                    @if (c.FromTime is not null || c.ToTime is not null)
                    {
                        <span>⏰ @FormatRange(c.FromTime, c.ToTime)</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(c.TimeDescription))
                    {
                        <span>@c.TimeDescription</span>
                    }
                    @if (c.HasAudio)
                    {
                        <span>🔊 @Loc["common.audio", "Audio"]</span>
                    }
                </div>

                <div class="sc-tile-foot">
                    <button class="sc-chip @(c.IsActive ? "chip-warn" : "chip-ok")" @onclick="() => ConfirmToggle(c)">
                        @(c.IsActive ? Loc["common.deactivate", "Deactivate"] : Loc["common.activate", "Activate"])
                    </button>
                    <div class="sc-tile-actions">
                        <button class="sc-iconbtn" title="@Loc["common.view", "View"]" @onclick="() => View(c)">👁</button>
                        <button class="sc-iconbtn" title="@Loc["common.edit", "Edit"]" @onclick="() => Edit(c)">✏️</button>
                        <button class="sc-iconbtn danger" title="@Loc["common.delete", "Delete"]" @onclick="() => ConfirmDelete(c)">🗑</button>
                    </div>
                </div>
            </div>
        }
    </div>
    <Pager Page="_page" PageCount="PageCount" TotalCount="Filtered.Count" PageSize="PageSize" OnGoTo="GoTo" />
}
else
{
    <div class="sc-card sc-tablewrap">
        <table class="sc-table">
            <thead>
                <tr>
                    <th>@Loc["chantsConfig.chant", "Chant"]</th>
                    <th>@Loc["common.type", "Type"]</th>
                    <th>@Loc["chantsConfig.deities", "Deities"]</th>
                    <th>@Loc["common.time", "Time"]</th>
                    <th>@Loc["common.audio", "Audio"]</th>
                    <th>@Loc["common.status", "Status"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Paged)
                {
                    <tr>
                        <td>
                            <strong>@c.Name</strong>
                            @if (!string.IsNullOrWhiteSpace(c.Description))
                            {
                                <div class="sc-muted">@c.Description</div>
                            }
                        </td>
                        <td><span class="sc-minichip">@c.ChantName</span></td>
                        <td>
                            @if (c.DeityNames.Count == 0)
                            {
                                <span class="sc-muted">—</span>
                            }
                            else
                            {
                                <div class="sc-chiprow">@foreach (var d in c.DeityNames) { <span class="sc-minichip">@d</span> }</div>
                            }
                        </td>
                        <td>
                            <div>@FormatRange(c.FromTime, c.ToTime)</div>
                            @if (!string.IsNullOrWhiteSpace(c.TimeDescription))
                            {
                                <div class="sc-muted">@c.TimeDescription</div>
                            }
                        </td>
                        <td>@(c.HasAudio ? "🔊" : "—")</td>
                        <td>
                            <label class="sc-switch">
                                <input type="checkbox" checked="@c.IsActive" @onclick="() => ConfirmToggle(c)" @onclick:preventDefault />
                                <span class="sc-slider"></span>
                            </label>
                            <span class="sc-status @(c.IsActive ? "on" : "off")">@(c.IsActive ? Loc["common.active", "Active"] : Loc["common.inactive", "Inactive"])</span>
                        </td>
                        <td>
                            <div class="sc-rowactions">
                                <button class="sc-iconbtn" title="@Loc["common.view", "View"]" @onclick="() => View(c)">👁</button>
                                <button class="sc-iconbtn" title="@Loc["common.edit", "Edit"]" @onclick="() => Edit(c)">✏️</button>
                                <button class="sc-iconbtn danger" title="@Loc["common.delete", "Delete"]" @onclick="() => ConfirmDelete(c)">🗑</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <Pager Page="_page" PageCount="PageCount" TotalCount="Filtered.Count" PageSize="PageSize" OnGoTo="GoTo" />
}

@code {
    private List<ChantConfigListItem> _list = new();
    private ChantConfigFormOptions _options = new();
    private bool _loading = true;
    private string? _error;

    private string _view = "list";
    private string _chantId = string.Empty;
    private string _deityId = string.Empty;
    private string _timeFilter = string.Empty;
    private string _search = string.Empty;

    private int _page = 1;
    private const int PageSize = 8;

    private List<ChantConfigListItem> Filtered => string.IsNullOrEmpty(_timeFilter)
        ? _list
        : _list.Where(c => c.TimeDescription == _timeFilter).ToList();

    private int PageCount => Math.Max(1, (int)Math.Ceiling(Filtered.Count / (double)PageSize));
    private IEnumerable<ChantConfigListItem> Paged => Filtered.Skip((_page - 1) * PageSize).Take(PageSize);

    private List<SelectOption> CategoryOptions =>
        _options.Categories.Select(c => new SelectOption(c.Id.ToString(), c.Name)).ToList();

    private List<SelectOption> DeityOptions =>
        _options.Deities.Select(d => new SelectOption(d.Id.ToString(), d.Name)).ToList();

    /// <summary>Time descriptions present in the current result set.</summary>
    private List<SelectOption> TimeSelectOptions => _list
        .Where(c => !string.IsNullOrWhiteSpace(c.TimeDescription))
        .Select(c => c.TimeDescription!)
        .Distinct()
        .OrderBy(t => t)
        .Select(t => new SelectOption(t, t))
        .ToList();

    private bool HasFilters => !string.IsNullOrEmpty(_chantId) || !string.IsNullOrEmpty(_deityId)
        || !string.IsNullOrEmpty(_timeFilter) || !string.IsNullOrWhiteSpace(_search);

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        try
        {
            _options = await Api.GetChantConfigFormOptionsAsync();
        }
        catch { /* filter options are best-effort */ }
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        _page = 1;
        try
        {
            _list = await Api.GetChantConfigsAsync(ParseGuid(_chantId), ParseGuid(_deityId), _search);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearchAsync() => await ReloadAsync();

    private async Task OnTypeChanged(string value)
    {
        _chantId = value;
        await ReloadAsync();
    }

    private async Task OnDeityChanged(string value)
    {
        _deityId = value;
        await ReloadAsync();
    }

    private void OnTimeChanged(string value)
    {
        _timeFilter = value;
        _page = 1;
    }

    private void SetView(string view)
    {
        _view = view;
        _page = 1;
    }

    private void GoTo(int page) => _page = Math.Clamp(page, 1, PageCount);

    private void View(ChantConfigListItem c) => Nav.NavigateTo($"chants-config/{c.Id}");
    private void Edit(ChantConfigListItem c) => Nav.NavigateTo($"chants-config/{c.Id}/edit");

    private static Guid? ParseGuid(string value) => Guid.TryParse(value, out var g) ? g : null;

    private string FormatRange(TimeOnly? from, TimeOnly? to)
    {
        if (from is null && to is null) return "—";
        if (from is not null && to is not null) return $"{from:HH\\:mm} – {to:HH\\:mm}";
        return from is not null
            ? Loc.TF("chantsConfig.fromTime", "from {0}", from.Value.ToString("HH\\:mm"))
            : Loc.TF("chantsConfig.untilTime", "until {0}", to!.Value.ToString("HH\\:mm"));
    }

    private async Task ConfirmToggle(ChantConfigListItem c)
    {
        var activate = !c.IsActive;
        var entity = Loc["chantsConfig.entity", "chant"];
        var confirmed = await Confirm.ConfirmAsync(new ConfirmRequest
        {
            Title = activate
                ? Loc.TF("common.confirmActivate", "Activate {0}?", entity)
                : Loc.TF("common.confirmDeactivate", "Deactivate {0}?", entity),
            Message = activate
                ? Loc.TF("chantsConfig.confirmActivateBody", "Are you sure you want to activate “{0}”?", c.Name)
                : Loc.TF("chantsConfig.confirmDeactivateBody", "Are you sure you want to deactivate “{0}”?", c.Name),
            ConfirmText = activate
                ? Loc["common.yesActivate", "Yes, activate"]
                : Loc["common.yesDeactivate", "Yes, deactivate"],
            CancelText = Loc["common.cancel", "Cancel"],
            Kind = activate ? ConfirmKind.Success : ConfirmKind.Warning
        });
        if (!confirmed) return;

        var (ok, err) = await Api.SetChantConfigStatusAsync(c.Id, activate);
        if (ok)
            Toast.Success(activate
                ? Loc.TF("msg.activatedNamed", "“{0}” has been activated.", c.Name)
                : Loc.TF("msg.deactivatedNamed", "“{0}” has been deactivated.", c.Name));
        else Toast.Error(err);
        await ReloadAsync();
    }

    private async Task ConfirmDelete(ChantConfigListItem c)
    {
        var confirmed = await Confirm.ConfirmAsync(new ConfirmRequest
        {
            Title = Loc.TF("common.confirmDelete", "Delete {0}?", Loc["chantsConfig.entity", "chant"]),
            Message = Loc.TF("chantsConfig.deleteBody", "“{0}” and its audio will be permanently deleted. This cannot be undone.", c.Name),
            ConfirmText = Loc["common.yesDelete", "Yes, delete"],
            CancelText = Loc["common.cancel", "Cancel"],
            Kind = ConfirmKind.Danger
        });
        if (!confirmed) return;

        var (ok, err) = await Api.DeleteChantConfigAsync(c.Id);
        if (ok) Toast.Success(Loc.TF("msg.deletedNamed", "“{0}” was deleted.", c.Name));
        else Toast.Error(err);
        await ReloadAsync();
    }
}
