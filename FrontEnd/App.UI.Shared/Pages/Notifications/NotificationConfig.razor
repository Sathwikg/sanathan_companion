@page "/notification-config"
@attribute [Authorize]
@inherits LocalizedComponentBase
@inject IApiClient Api
@inject ToastService Toast

<div class="sc-page-head">
    <div class="sc-page-title">
        <span class="sc-page-emoji">🛠️</span>
        <div>
            <h1>@Loc["notificationConfig.title", "Notification Config"]</h1>
            <p class="sc-page-sub">@Loc["notificationConfig.sub", "Choose which modules can send notifications to seekers"]</p>
        </div>
    </div>
    @if (!_forbidden && !_loading)
    {
        <div class="sc-page-actions">
            <button class="sc-btn-primary sc-btn-sm" @onclick="SaveAsync" disabled="@_saving">
                @if (_saving) { <OmLoader Inline="true" Size="18" Message="@Loc["common.saving", "Saving…"]" /> } else { <span>@Loc["common.saveChanges", "Save changes"]</span> }
            </button>
        </div>
    }
</div>

@if (_loading)
{
    <OmLoader FullPage="true" Message="@Loc["notificationConfig.loadingModules", "Loading modules…"]" />
}
else if (_forbidden)
{
    <div class="sc-card sc-empty-state">
        <div class="sc-empty-om">🔒</div>
        <h3>@Loc["common.adminOnly", "Administrator access required"]</h3>
        <p>@Loc["notificationConfig.adminOnlyBody", "Notification configuration is available to administrators only."]</p>
    </div>
}
else if (_error is not null)
{
    <div class="sc-alert sc-alert-error">@_error</div>
}
else
{
    <div class="sc-card sc-filtercard">
        <div class="sc-filter" style="min-width:280px">
            <label>@Loc["notificationConfig.searchModules", "Search modules"]</label>
            <input class="sc-input sc-input-sm" placeholder="@Loc["notificationConfig.searchPlaceholder", "Module name…"]" @bind="_search" @bind:event="oninput" />
        </div>
        <div class="sc-notif-summary">
            <span class="sc-badge on">@Loc.TF("notificationConfig.enabledCount", "{0} enabled", _modules.Count(m => m.IsEnabled))</span>
            <span class="sc-muted">@Loc.TF("notificationConfig.ofModules", "of {0} modules", _modules.Count)</span>
            <button class="sc-btn-ghost sc-btn-sm" @onclick="ExpandAll">⊞ @Loc["common.expandAll", "Expand all"]</button>
            <button class="sc-btn-ghost sc-btn-sm" @onclick="CollapseAll">⊟ @Loc["common.collapseAll", "Collapse all"]</button>
        </div>
    </div>

    <div class="sc-card sc-tablewrap">
        <table class="sc-table">
            <thead>
                <tr>
                    <th style="width:32%">@Loc["notificationConfig.colModule", "Module"]</th>
                    <th style="width:16%">@Loc["notificationConfig.colNotifications", "Notifications"]</th>
                    <th>@Loc["notificationConfig.colTitleDesc", "Title & description shown to users"]</th>
                    <th style="width:12%">@Loc["notificationConfig.colDefaultOn", "Default on"]</th>
                    <th style="width:12%">@Loc["notificationConfig.colMandatory", "Mandatory"]</th>
                </tr>
            </thead>
            @foreach (var group in Groups)
            {
                var expanded = IsExpanded(group.Key);
                <tbody class="sc-notif-group">
                    <tr class="sc-notif-grouprow" @onclick="() => ToggleGroup(group.Key)">
                        <td colspan="5">
                            <span class="sc-mtree-caret">@(expanded ? "▾" : "▸")</span>
                            <strong>@(group.Key == TopLevelGroup ? Loc["notificationConfig.topLevel", "Top level"] : group.Key)</strong>
                            <span class="sc-mtree-count">@group.Count()</span>
                            @if (group.Count(m => m.IsEnabled) > 0)
                            {
                                <span class="sc-badge on">@Loc.TF("notificationConfig.onCount", "{0} on", group.Count(m => m.IsEnabled))</span>
                            }
                        </td>
                    </tr>

                    @if (expanded)
                    {
                        @foreach (var m in group)
                        {
                            <tr class="@(m.IsEnabled ? "" : "sc-row-muted")">
                                <td class="sc-notif-childcell">
                                    <strong>@(string.IsNullOrWhiteSpace(m.Icon) ? "" : m.Icon + " ")@m.ModuleName</strong>
                                    @if (m.OptedOutUsers > 0)
                                    {
                                        <div class="sc-muted" style="font-size:0.72rem">@Loc.TF("notificationConfig.optedOut", "{0} opted out", m.OptedOutUsers)</div>
                                    }
                                </td>
                                <td>
                                    <label class="sc-switch">
                                        <input type="checkbox" checked="@m.IsEnabled" @onchange="e => SetEnabled(m, e)" />
                                        <span class="sc-slider"></span>
                                    </label>
                                    <span class="sc-status @(m.IsEnabled ? "on" : "off")">@(m.IsEnabled ? Loc["notificationConfig.on", "On"] : Loc["notificationConfig.off", "Off"])</span>
                                </td>
                                <td>
                                    <input class="sc-input sc-input-sm" placeholder="@Loc.TF("notificationConfig.titlePlaceholder", "e.g. {0} reminder", m.ModuleName)"
                                           value="@m.Title" @onchange="e => m.Title = e.Value?.ToString()" disabled="@(!m.IsEnabled)" />
                                    <input class="sc-input sc-input-sm" style="margin-top:0.35rem" placeholder="@Loc["notificationConfig.descPlaceholder", "What is this notification for?"]"
                                           value="@m.Description" @onchange="e => m.Description = e.Value?.ToString()" disabled="@(!m.IsEnabled)" />
                                </td>
                                <td>
                                    <label class="sc-switch">
                                        <input type="checkbox" checked="@m.DefaultEnabledForUsers"
                                               @onchange="e => m.DefaultEnabledForUsers = (bool)(e.Value ?? false)" disabled="@(!m.IsEnabled)" />
                                        <span class="sc-slider"></span>
                                    </label>
                                </td>
                                <td>
                                    <label class="sc-switch">
                                        <input type="checkbox" checked="@m.IsMandatory"
                                               @onchange="e => m.IsMandatory = (bool)(e.Value ?? false)" disabled="@(!m.IsEnabled)" />
                                        <span class="sc-slider"></span>
                                    </label>
                                    @if (m.IsMandatory)
                                    {
                                        <div class="sc-muted" style="font-size:0.7rem">@Loc["notificationConfig.cannotOptOut", "users can't opt out"]</div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            }
        </table>
    </div>

    <p class="sc-hint" style="margin-top:0.6rem">
        💡 <strong>@Loc["notificationConfig.colDefaultOn", "Default on"]</strong>
        @Loc["notificationConfig.defaultOnHint", "applies to users who haven't chosen for themselves — including new sign-ups. Turning a module off keeps everyone's saved choices, so re-enabling it restores them."]
    </p>
}

@code {
    private List<NotificationModuleModel> _modules = new();
    private string _search = string.Empty;
    private bool _loading = true;
    private bool _forbidden;
    private bool _saving;
    private string? _error;

    /// <summary>Label for forms that sit at the top level rather than under a main module.</summary>
    private const string TopLevelGroup = "Top level";

    private readonly HashSet<string> _expanded = new();
    private bool _searching => !string.IsNullOrWhiteSpace(_search);

    private IEnumerable<NotificationModuleModel> Filtered =>
        !_searching
            ? _modules
            : _modules.Where(m => m.ModuleName.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)
                               || (m.ParentName?.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false));

    /// <summary>Sub-modules grouped under their main module.</summary>
    private IEnumerable<IGrouping<string, NotificationModuleModel>> Groups =>
        Filtered.GroupBy(m => string.IsNullOrWhiteSpace(m.ParentName) ? TopLevelGroup : m.ParentName!)
                .OrderBy(g => g.Key == TopLevelGroup ? 1 : 0)   // main modules first
                .ThenBy(g => g.Key);

    // While searching every matching group opens, otherwise a hidden match looks like "no results".
    private bool IsExpanded(string group) => _searching || _expanded.Contains(group);

    private void ToggleGroup(string group)
    {
        if (!_expanded.Remove(group)) _expanded.Add(group);
    }

    private void ExpandAll()
    {
        foreach (var g in Groups) _expanded.Add(g.Key);
    }

    private void CollapseAll() => _expanded.Clear();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var (ok, data, forbidden, err) = await Api.GetNotificationConfigAsync();
        _forbidden = forbidden;
        if (ok)
        {
            _modules = data?.Modules ?? new();

            // Open the groups that already have notifications configured — the admin sees
            // what's live at a glance, and the rest stays tidy.
            _expanded.Clear();
            foreach (var g in Groups.Where(g => g.Any(m => m.IsEnabled)))
                _expanded.Add(g.Key);
        }
        else if (!forbidden) _error = err;
        _loading = false;
    }

    private void SetEnabled(NotificationModuleModel m, ChangeEventArgs e)
    {
        m.IsEnabled = (bool)(e.Value ?? false);
        // A disabled type can't be mandatory.
        if (!m.IsEnabled) m.IsMandatory = false;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        var request = new SaveNotificationConfigRequest
        {
            Items = _modules.Select(m => new SaveNotificationModule
            {
                MenuModuleId = m.MenuModuleId,
                IsEnabled = m.IsEnabled,
                Title = m.Title,
                Description = m.Description,
                DefaultEnabledForUsers = m.DefaultEnabledForUsers,
                IsMandatory = m.IsMandatory,
                DisplayOrder = m.DisplayOrder
            }).ToList()
        };

        var (ok, err) = await Api.SaveNotificationConfigAsync(request);
        _saving = false;

        if (ok)
        {
            Toast.Success(Loc["notificationConfig.saved", "Notification configuration saved."]);
            await LoadAsync();
        }
        else
        {
            Toast.Error(err);
        }
    }
}
