@page "/puja-process"
@attribute [Authorize]
@inherits LocalizedComponentBase
@inject IApiClient Api
@inject ToastService Toast

<div class="sc-page-head">
    <div class="sc-page-title">
        <span class="sc-page-emoji">📿</span>
        <div>
            <h1>@Loc["pujaProcess.title", "Puja Process"]</h1>
            <p class="sc-page-sub">@Loc["pujaProcess.sub", "Follow the puja step by step"]</p>
        </div>
    </div>
</div>

@if (_loading)
{
    <OmLoader FullPage="true" Message="@Loc["pujaProcess.loading", "Loading…"]" />
}
else if (_allCount == 0)
{
    <div class="sc-card sc-empty-state">
        <div class="sc-empty-om">📿</div>
        <p>@Loc["pujaProcess.nothingConfigured", "No puja process has been set up yet."]</p>
    </div>
}
else
{
    @* Pujas are the point of this screen; the festival only narrows the list. *@
    <div class="sc-card sc-filtercard">
        <div class="sc-field">
            <label>@Loc["pujaProcess.filterByFestival", "Filter by festival"]</label>
            <select class="sc-input" value="@_festivalId" @onchange="OnFestivalChanged">
                <option value="">@Loc.TF("pujaProcess.allFestivals", "All pujas ({0})", _allCount)</option>
                @foreach (var f in _festivals)
                {
                    <option value="@f.Id">@f.Label (@f.PujaCount)@(f.IsCurrent ? $" — {Loc["pujaProcess.current", "current"]}" : "")</option>
                }
            </select>
            @if (SelectedFestival is { } cf)
            {
                <span class="sc-hint">@WhenLabel(cf)</span>
            }
        </div>
    </div>

    @if (_process is null)
    {
        @if (_pujas.Count == 0)
        {
            <div class="sc-card sc-empty-state">
                <div class="sc-empty-om">📿</div>
                <p>@Loc["pujaProcess.noPujas", "No puja is configured for this festival yet."]</p>
                <button type="button" class="sc-btn-ghost sc-btn-sm" @onclick="() => ApplyFilterAsync(null)">
                    @Loc["pujaProcess.showAll", "Show all pujas"]
                </button>
            </div>
        }
        else
        {
            <div class="sc-cardgrid">
                @foreach (var p in _pujas)
                {
                    <button type="button" class="sc-tile sc-puja-pick" @onclick="() => OpenAsync(p.PujaId)">
                        <div class="sc-tile-top">
                            <div class="sc-tile-badge">🛐</div>
                        </div>
                        <h3 class="sc-tile-title">@p.Name</h3>
                        <p class="sc-tile-desc">@p.Description</p>
                        <div class="sc-chiprow">
                            @if (p.HasFestival)
                            {
                                <span class="sc-minichip">🎉 @p.FestivalLabel</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(p.DeityName))
                            {
                                <span class="sc-minichip">🕉️ @p.DeityName</span>
                            }
                            <span class="sc-minichip">@Loc.TF("pujaProcess.stepCount", "{0} steps", p.StepCount)</span>
                        </div>
                    </button>
                }
            </div>
        }
    }
    else
    {
        <div class="sc-wp-bar">
            <button type="button" class="sc-btn-ghost sc-btn-sm" @onclick="BackToList">
                ← @Loc["pujaProcess.allPujas", "All pujas"]
            </button>
            <span class="sc-wp-bar-title">@_process.PujaName</span>
        </div>

        @* ---------------- progress ---------------- *@
        <div class="sc-card sc-progress-card @(_process.IsCompleted ? "done" : null)">
            @if (_process.IsCompleted)
            {
                <div class="sc-puja-done">
                    <span class="sc-puja-done-icon">🎉</span>
                    <div>
                        <strong>@Loc["pujaProcess.completedTitle", "Puja completed"]</strong>
                        <p class="sc-muted">@Loc["pujaProcess.completedBody", "You have finished every step. May your prayers be answered."]</p>
                    </div>
                </div>
            }
            else
            {
                <div class="sc-progress-line">
                    <strong>@Loc.TF("pujaProcess.stepsOf", "{0} of {1} steps", _process.CompletedCount, _process.TotalSteps)</strong>
                    @if (_process.CurrentStepNumber is { } n)
                    {
                        <span class="sc-muted">@Loc.TF("pujaProcess.nextUp", "Next: step {0}", n)</span>
                    }
                </div>
            }
            <div class="sc-progress-track"><div class="sc-progress-fill" style="width:@(_process.PercentComplete)%"></div></div>
            @if (_process.CompletedCount > 0)
            {
                <button type="button" class="sc-linkbtn" @onclick="StartOver">@Loc["pujaProcess.startOver", "Start over"]</button>
            }
        </div>

        @* ---------------- materials ---------------- *@
        @if (_process.Materials.Count > 0)
        {
            <div class="sc-section-head">
                <h2>🧺 @Loc["pujaProcess.materials", "Required materials"]</h2>
            </div>
            <div class="sc-card">
                <ul class="sc-material-list readonly">
                    @foreach (var m in _process.Materials)
                    {
                        <li>
                            <span class="sc-material-name">@m.ItemName</span>
                            <span class="sc-material-qty">@(string.IsNullOrWhiteSpace(m.Quantity) ? "—" : m.Quantity)</span>
                        </li>
                    }
                </ul>
            </div>
        }

        @* ---------------- steps ---------------- *@
        <div class="sc-section-head">
            <h2>🪔 @Loc["pujaProcess.steps", "Steps"]</h2>
            <span class="sc-section-sub">@Loc["pujaProcess.tapToComplete", "Tap a step to mark it done"]</span>
        </div>

        @foreach (var s in _process.Steps)
        {
            var isNext = !s.IsCompleted && s.StepNumber == _process.CurrentStepNumber;
            <div class="sc-card sc-runstep @(s.IsCompleted ? "done" : null) @(isNext ? "next" : null)">
                <button type="button" class="sc-runstep-check" @onclick="() => ToggleStep(s)"
                        title="@(s.IsCompleted ? Loc["pujaProcess.undo", "Mark as not done"] : Loc["pujaProcess.markDone", "Mark done"])">
                    @(s.IsCompleted ? "✓" : s.StepNumber.ToString())
                </button>
                <div class="sc-runstep-body">
                    <div class="sc-runstep-head">
                        <strong>@(string.IsNullOrWhiteSpace(s.Title) ? Loc.TF("pujaProcess.stepN", "Step {0}", s.StepNumber) : s.Title)</strong>
                        @if (isNext)
                        {
                            <span class="sc-minichip">@Loc["pujaProcess.youAreHere", "You are here"]</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(s.Content))
                    {
                        @* Sanitized server-side on save, so rendering as markup is safe. *@
                        <div class="sc-richtext">@((MarkupString)s.Content!)</div>
                    }
                    @if (s.IsFallback)
                    {
                        <span class="sc-hint">@Loc["pujaProcess.notTranslated", "Not available in your language yet."]</span>
                    }
                </div>
            </div>
        }
    }
}

@code {
    private List<ProcessFestivalModel> _festivals = new();
    private List<ProcessPujaSummaryModel> _pujas = new();
    private PujaProcessViewModel? _process;
    private string _festivalId = string.Empty;
    private bool _loading = true;

    private int _allCount;

    private ProcessFestivalModel? SelectedFestival
        => _festivals.FirstOrDefault(f => f.Id.ToString() == _festivalId);

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        // Unfiltered by default. Opening on the current festival would hide every puja that is
        // not tied to one, which is exactly how configured pujas went missing before.
        _festivals = await Api.GetProcessFestivalsAsync();
        _pujas = await Api.GetProcessPujasAsync();
        _allCount = _pujas.Count;

        _loading = false;
    }

    private string WhenLabel(ProcessFestivalModel f) => f.DaysAway switch
    {
        0 => Loc["pujaProcess.today", "Today"],
        1 => Loc["pujaProcess.tomorrow", "Tomorrow"],
        > 1 => Loc.TF("pujaProcess.inDays", "In {0} days", f.DaysAway),
        -1 => Loc["pujaProcess.yesterday", "Yesterday"],
        _ => Loc.TF("pujaProcess.daysAgo", "{0} days ago", -f.DaysAway)
    };

    private Task OnFestivalChanged(ChangeEventArgs e)
        => ApplyFilterAsync(Guid.TryParse(e.Value?.ToString(), out var id) ? id : null);

    private async Task ApplyFilterAsync(Guid? festivalId)
    {
        _festivalId = festivalId?.ToString() ?? string.Empty;
        _process = null;
        _pujas = await Api.GetProcessPujasAsync(festivalId);
    }

    private async Task OpenAsync(Guid pujaId) => _process = await Api.GetPujaProcessAsync(pujaId);

    private async Task BackToList()
    {
        _process = null;
        _pujas = await Api.GetProcessPujasAsync(
            Guid.TryParse(_festivalId, out var id) ? id : null);
    }

    /// <summary>
    /// Ticking a step is page state only — nothing is sent to the server. A puja is performed
    /// afresh each time, so leaving and coming back should offer a clean slate rather than
    /// restoring a half-finished attempt.
    /// </summary>
    private void ToggleStep(PujaStepViewModel step)
    {
        if (_process is null) return;

        var wasCompleted = _process.IsCompleted;
        step.IsCompleted = !step.IsCompleted;

        if (!wasCompleted && _process.IsCompleted)
            Toast.Success(Loc["pujaProcess.completedTitle", "Puja completed"]);
    }

    /// <summary>Clears the tick marks. No confirmation needed — nothing durable is being lost.</summary>
    private void StartOver()
    {
        if (_process is null) return;
        foreach (var s in _process.Steps) s.IsCompleted = false;
    }
}
