@page "/pujas"
@attribute [Authorize]
@inherits LocalizedComponentBase
@inject IApiClient Api
@inject ConfirmService Confirm
@inject ToastService Toast

<div class="sc-page-head">
    <div class="sc-page-title">
        <span class="sc-page-emoji">🛐</span>
        <div>
            <h1>@Loc["pujas.title", "Puja"]</h1>
            <p class="sc-page-sub">@Loc["pujas.sub", "Pujas and the festival each belongs to"]</p>
        </div>
    </div>
    <div class="sc-page-actions">
        <div class="sc-viewtoggle">
            <button class="@(_view == "grid" ? "active" : "")" @onclick='() => _view = "grid"'>▦ @Loc["common.gridView", "Grid"]</button>
            <button class="@(_view == "list" ? "active" : "")" @onclick='() => _view = "list"'>☰ @Loc["common.listView", "List"]</button>
        </div>
        <button class="sc-btn-primary sc-btn-sm" @onclick="OpenCreate">+ @Loc["common.create", "Create"]</button>
    </div>
</div>

@if (_error is not null)
{
    <div class="sc-alert sc-alert-error">@_error</div>
}

@if (_loading)
{
    <OmLoader FullPage="true" Message="@Loc["pujas.loading", "Loading pujas…"]" />
}
else if (_list.Count == 0)
{
    <div class="sc-card sc-empty-state">
        <div class="sc-empty-om">🛐</div>
        <h3>@Loc["pujas.emptyTitle", "No pujas yet"]</h3>
        <p>@Loc["pujas.emptyBody", "Create your first puja and map it to a festival."]</p>
        <button class="sc-btn-primary sc-btn-sm" @onclick="OpenCreate">+ @Loc["pujas.createPuja", "Create Puja"]</button>
    </div>
}
else if (_view == "grid")
{
    <div class="sc-cardgrid">
        @foreach (var p in Paged)
        {
            <div class="sc-tile @(p.IsActive ? "" : "is-inactive")">
                <div class="sc-tile-top">
                    <div class="sc-tile-badge">🛐</div>
                    <span class="sc-badge @(p.IsActive ? "on" : "off")">@(p.IsActive ? Loc["common.active", "Active"] : Loc["common.inactive", "Inactive"])</span>
                </div>
                <h3 class="sc-tile-title">@p.Name</h3>
                <p class="sc-tile-desc">@(string.IsNullOrWhiteSpace(p.Description) ? Loc["common.noDescription", "No description"] : p.Description)</p>
                <div class="sc-chiprow">
                    @if (p.HasFestival)
                    {
                        <span class="sc-minichip">🎉 @p.FestivalLabel</span>
                    }
                    @if (p.HasDeity)
                    {
                        <span class="sc-minichip">🕉️ @p.DeityName</span>
                    }
                    @if (!p.HasFestival && !p.HasDeity)
                    {
                        <span class="sc-minichip sc-muted">@Loc["pujas.notMapped", "Not mapped"]</span>
                    }
                </div>
                <div class="sc-tile-foot">
                    <button class="sc-chip @(p.IsActive ? "chip-warn" : "chip-ok")" @onclick="() => ConfirmToggle(p)">
                        @(p.IsActive ? Loc["common.deactivate", "Deactivate"] : Loc["common.activate", "Activate"])
                    </button>
                    <button class="sc-btn-ghost sc-btn-sm" @onclick="() => OpenEdit(p)">@Loc["common.edit", "Edit"]</button>
                </div>
            </div>
        }
    </div>
    <Pager Page="_page" PageCount="PageCount" TotalCount="_list.Count" PageSize="PageSize" OnGoTo="GoTo" />
}
else
{
    <div class="sc-card sc-tablewrap">
        <table class="sc-table">
            <thead>
                <tr>
                    <th>@Loc["pujas.pujaName", "Puja Name"]</th>
                    <th>@Loc["common.description", "Description"]</th>
                    <th>@Loc["pujas.festival", "Festival"]</th>
                    <th>@Loc["pujas.deity", "Deity"]</th>
                    <th>@Loc["common.status", "Status"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Paged)
                {
                    <tr>
                        <td><strong>@p.Name</strong></td>
                        <td class="sc-muted">@p.Description</td>
                        <td>@(p.HasFestival ? p.FestivalLabel : "—")</td>
                        <td>@(p.HasDeity ? p.DeityName : "—")</td>
                        <td>
                            <label class="sc-switch">
                                <input type="checkbox" checked="@p.IsActive" @onclick="() => ConfirmToggle(p)" @onclick:preventDefault />
                                <span class="sc-slider"></span>
                            </label>
                            <span class="sc-status @(p.IsActive ? "on" : "off")">@(p.IsActive ? Loc["common.active", "Active"] : Loc["common.inactive", "Inactive"])</span>
                        </td>
                        <td><button class="sc-btn-ghost sc-btn-sm" @onclick="() => OpenEdit(p)">@Loc["common.edit", "Edit"]</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <Pager Page="_page" PageCount="PageCount" TotalCount="_list.Count" PageSize="PageSize" OnGoTo="GoTo" />
}

<ScModal Visible="_showForm" Title="@(_editId is null ? Loc["pujas.createPuja", "Create Puja"] : Loc["pujas.editPuja", "Edit Puja"])" OnClose="CloseForm">
    <EditForm Model="_model" OnValidSubmit="SaveAsync" class="sc-form">
        <DataAnnotationsValidator />

        @if (_formError is not null)
        {
            <div class="sc-alert sc-alert-error">@_formError</div>
        }

        <div class="sc-field">
            <label>@Loc["pujas.pujaName", "Puja Name"]</label>
            <InputText @bind-Value="_model.Name" class="sc-input" />
            <ValidationMessage For="() => _model.Name" />
        </div>

        <div class="sc-field">
            <label>@Loc["common.description", "Description"]</label>
            <InputTextArea @bind-Value="_model.Description" class="sc-input" rows="3" />
            <ValidationMessage For="() => _model.Description" />
        </div>

        @* Both mappings are optional. Bound to ids, never names — a name would break the mapping
           the moment the label is translated or the record is renamed. *@
        <div class="sc-field">
            <label>@Loc["pujas.festival", "Festival"] <span class="sc-optional">@Loc["common.optional", "(optional)"]</span></label>
            <InputSelect @bind-Value="_model.FestivalId" class="sc-input">
                <option value="">@Loc["pujas.noFestival", "— No festival —"]</option>
                @foreach (var f in _festivals)
                {
                    <option value="@f.Id">@f.Label</option>
                }
            </InputSelect>
        </div>

        <div class="sc-field">
            <label>@Loc["pujas.deity", "Deity"] <span class="sc-optional">@Loc["common.optional", "(optional)"]</span></label>
            <InputSelect @bind-Value="_model.DeityId" class="sc-input">
                <option value="">@Loc["pujas.noDeity", "— No deity —"]</option>
                @foreach (var d in _deities)
                {
                    <option value="@d.Id">@d.Name</option>
                }
            </InputSelect>
        </div>

        <div class="sc-switches">
            <div class="sc-switchrow">
                <label class="sc-switch"><input type="checkbox" @bind="_model.IsActive" /><span class="sc-slider"></span></label>
                <span>@Loc["common.active", "Active"]</span>
            </div>
        </div>

        <div class="sc-modal-actions">
            <button type="button" class="sc-btn-ghost" @onclick="CloseForm">@Loc["common.cancel", "Cancel"]</button>
            <button type="submit" class="sc-btn-primary" disabled="@_busy">
                @if (_busy) { <OmLoader Inline="true" Size="18" Message="@Loc["common.saving", "Saving…"]" /> } else { <span>@(_editId is null ? Loc["common.create", "Create"] : Loc["common.update", "Update"])</span> }
            </button>
        </div>
    </EditForm>
</ScModal>

@code {
    private string _view = "grid";
    private bool _loading = true;
    private string? _error;
    private List<PujaModel> _list = new();
    private List<PujaFestivalOption> _festivals = new();
    private List<PujaDeityOption> _deities = new();

    private int _page = 1;
    private const int PageSize = 8;
    private int PageCount => Math.Max(1, (int)Math.Ceiling(_list.Count / (double)PageSize));
    private IEnumerable<PujaModel> Paged => _list.Skip((_page - 1) * PageSize).Take(PageSize);

    private bool _showForm;
    private Guid? _editId;
    private PujaRequest _model = new();
    private bool _busy;
    private string? _formError;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _list = await Api.GetPujasAsync();
            var options = await Api.GetPujaFormOptionsAsync();
            _festivals = options.Festivals;
            _deities = options.Deities;
            _page = Math.Clamp(_page, 1, PageCount);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void GoTo(int page) => _page = Math.Clamp(page, 1, PageCount);

    private void OpenCreate()
    {
        _editId = null;
        _formError = null;
        _model = new PujaRequest();
        _showForm = true;
    }

    private void OpenEdit(PujaModel p)
    {
        _editId = p.Id;
        _formError = null;
        _model = new PujaRequest
        {
            Name = p.Name,
            Description = p.Description,
            FestivalId = p.FestivalId,
            DeityId = p.DeityId,
            IsActive = p.IsActive
        };
        _showForm = true;
    }

    private void CloseForm() => _showForm = false;

    private async Task SaveAsync()
    {
        _busy = true;
        _formError = null;

        var (ok, err) = _editId is null
            ? await Api.CreatePujaAsync(_model)
            : await Api.UpdatePujaAsync(_editId.Value, _model);

        _busy = false;

        if (ok)
        {
            Toast.Success(Loc.TF("msg.savedNamed", "“{0}” saved.", _model.Name));
            _showForm = false;
            await LoadAsync();
        }
        else
        {
            _formError = err;
        }
    }

    private async Task ConfirmToggle(PujaModel p)
    {
        var activate = !p.IsActive;
        var entity = Loc["pujas.entity", "puja"];
        var confirmed = await Confirm.ConfirmAsync(new ConfirmRequest
        {
            Title = activate
                ? Loc.TF("common.confirmActivate", "Activate {0}?", entity)
                : Loc.TF("common.confirmDeactivate", "Deactivate {0}?", entity),
            Message = activate
                ? Loc.TF("pujas.confirmActivateBody", "Are you sure you want to activate “{0}”?", p.Name)
                : Loc.TF("pujas.confirmDeactivateBody", "Are you sure you want to deactivate “{0}”?", p.Name),
            ConfirmText = activate
                ? Loc["common.yesActivate", "Yes, activate"]
                : Loc["common.yesDeactivate", "Yes, deactivate"],
            CancelText = Loc["common.cancel", "Cancel"],
            Kind = activate ? ConfirmKind.Success : ConfirmKind.Warning
        });
        if (!confirmed) return;

        var (ok, err) = await Api.SetPujaStatusAsync(p.Id, activate);
        if (ok)
            Toast.Success(activate
                ? Loc.TF("msg.activatedNamed", "“{0}” has been activated.", p.Name)
                : Loc.TF("msg.deactivatedNamed", "“{0}” has been deactivated.", p.Name));
        else Toast.Error(err);

        await LoadAsync();
    }
}
