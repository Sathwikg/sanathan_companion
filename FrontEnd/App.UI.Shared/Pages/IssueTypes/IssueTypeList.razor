@page "/issue-types"
@attribute [Authorize]
@inject IApiClient Api
@inject ConfirmService Confirm
@inject ToastService Toast

<div class="sc-page-head">
    <div class="sc-page-title">
        <span class="sc-page-emoji">🏷️</span>
        <div>
            <h1>Issue Types</h1>
            <p class="sc-page-sub">Common feedback categories shown on the feedback form</p>
        </div>
    </div>
    @if (!_forbidden)
    {
        <div class="sc-page-actions">
            <button class="sc-btn-primary sc-btn-sm" @onclick="OpenCreate">+ Create</button>
        </div>
    }
</div>

@if (_forbidden)
{
    <div class="sc-card sc-empty-state">
        <div class="sc-empty-om">🔒</div>
        <h3>Administrator access required</h3>
        <p>Issue types are managed by administrators only.</p>
    </div>
}
else if (_error is not null)
{
    <div class="sc-alert sc-alert-error">@_error</div>
}
else if (_loading)
{
    <OmLoader FullPage="true" Message="Loading issue types…" />
}
else if (_list.Count == 0)
{
    <div class="sc-card sc-empty-state">
        <div class="sc-empty-om">🏷️</div>
        <h3>No issue types yet</h3>
        <p>Create your first issue type to get started.</p>
        <button class="sc-btn-primary sc-btn-sm" @onclick="OpenCreate">+ Create Issue Type</button>
    </div>
}
else
{
    <div class="sc-card sc-tablewrap">
        <table class="sc-table">
            <thead>
                <tr><th>Order</th><th>Name</th><th>Description</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var t in _list)
                {
                    <tr>
                        <td class="sc-muted">@t.DisplayOrder</td>
                        <td><strong>@t.Name</strong></td>
                        <td class="sc-muted">@(string.IsNullOrWhiteSpace(t.Description) ? "—" : t.Description)</td>
                        <td>
                            <label class="sc-switch">
                                <input type="checkbox" checked="@t.IsActive" @onclick="() => ConfirmToggle(t)" @onclick:preventDefault />
                                <span class="sc-slider"></span>
                            </label>
                            <span class="sc-status @(t.IsActive ? "on" : "off")">@(t.IsActive ? "Active" : "Inactive")</span>
                        </td>
                        <td><button class="sc-btn-ghost sc-btn-sm" @onclick="() => OpenEdit(t)">Edit</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<ScModal Visible="_showForm" Title="@(_editId is null ? "Create Issue Type" : "Edit Issue Type")" OnClose="CloseForm">
    <EditForm Model="_model" OnValidSubmit="SaveAsync" class="sc-form">
        <DataAnnotationsValidator />

        @if (_formError is not null)
        {
            <div class="sc-alert sc-alert-error">@_formError</div>
        }

        <div class="sc-field">
            <label>Name</label>
            <InputText @bind-Value="_model.Name" class="sc-input" />
            <ValidationMessage For="() => _model.Name" />
        </div>
        <div class="sc-field">
            <label>Description <span class="sc-optional">(shown as guidance on the form)</span></label>
            <InputTextArea @bind-Value="_model.Description" class="sc-input sc-textarea" rows="2" />
            <ValidationMessage For="() => _model.Description" />
        </div>
        <div class="sc-field" style="max-width:160px">
            <label>Display order</label>
            <InputNumber @bind-Value="_model.DisplayOrder" class="sc-input" />
        </div>

        <div class="sc-switches">
            <div class="sc-switchrow">
                <label class="sc-switch"><input type="checkbox" @bind="_model.IsActive" /><span class="sc-slider"></span></label>
                <span>Active</span>
            </div>
        </div>

        <div class="sc-modal-actions">
            <button type="button" class="sc-btn-ghost" @onclick="CloseForm">Cancel</button>
            <button type="submit" class="sc-btn-primary" disabled="@_busy">
                @if (_busy) { <OmLoader Inline="true" Size="18" Message="Saving…" /> } else { <span>@(_editId is null ? "Create" : "Update")</span> }
            </button>
        </div>
    </EditForm>
</ScModal>

@code {
    private bool _loading = true;
    private bool _forbidden;
    private string? _error;
    private List<IssueTypeModel> _list = new();

    private bool _showForm;
    private Guid? _editId;
    private IssueTypeRequest _model = new();
    private bool _busy;
    private string? _formError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        var (ok, items, forbidden, err) = await Api.GetIssueTypesAsync();
        _forbidden = forbidden;
        if (ok) _list = items;
        else if (!forbidden) _error = err;
        _loading = false;
    }

    private void OpenCreate()
    {
        _editId = null;
        _formError = null;
        _model = new IssueTypeRequest { DisplayOrder = (_list.Count == 0 ? 1 : _list.Max(t => t.DisplayOrder) + 1) };
        _showForm = true;
    }

    private void OpenEdit(IssueTypeModel t)
    {
        _editId = t.Id;
        _formError = null;
        _model = new IssueTypeRequest
        {
            Name = t.Name,
            Description = t.Description,
            DisplayOrder = t.DisplayOrder,
            IsActive = t.IsActive
        };
        _showForm = true;
    }

    private void CloseForm() => _showForm = false;

    private async Task SaveAsync()
    {
        _busy = true;
        _formError = null;
        var (ok, err) = _editId is null
            ? await Api.CreateIssueTypeAsync(_model)
            : await Api.UpdateIssueTypeAsync(_editId.Value, _model);
        _busy = false;

        if (ok)
        {
            Toast.Success($"Issue type “{_model.Name}” saved.");
            _showForm = false;
            await LoadAsync();
        }
        else
        {
            _formError = err;
        }
    }

    private async Task ConfirmToggle(IssueTypeModel t)
    {
        var activate = !t.IsActive;
        var confirmed = await Confirm.ConfirmAsync(new ConfirmRequest
        {
            Title = activate ? "Activate issue type?" : "Deactivate issue type?",
            Message = $"Are you sure you want to {(activate ? "activate" : "deactivate")} “{t.Name}”?",
            ConfirmText = activate ? "Yes, activate" : "Yes, deactivate",
            CancelText = "Cancel",
            Kind = activate ? ConfirmKind.Success : ConfirmKind.Warning
        });
        if (!confirmed) return;

        var (ok, err) = await Api.SetIssueTypeStatusAsync(t.Id, activate);
        if (ok) Toast.Success($"“{t.Name}” has been {(activate ? "activated" : "deactivated")}.");
        else Toast.Error(err);
        await LoadAsync();
    }
}
