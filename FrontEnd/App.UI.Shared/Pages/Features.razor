        --land-y: 0px;
        --land-prog: 0;
        --land-hero: 0;
        position: relative;
        z-index: 0;
        isolation: isolate;
        overflow-x: clip;
        color: var(--land-ink);
        font-family: var(--font-body);
    }

    :root[data-theme="dark"] .sc-land {
        --land-glass: rgba(43, 29, 16, 0.58);
        --land-glass-edge: rgba(255, 226, 168, 0.14);
        --land-glass-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.7);
        --land-glow: rgba(243, 159, 90, 0.34);
        --land-glow-soft: rgba(243, 159, 90, 0.16);
        --land-text-grad: linear-gradient(92deg, #FFE2A8 0%, #F39F5A 45%, #E4A951 75%, #FFD98A 100%);
    }

    .sc-land-wrap { width: 100%; max-width: 1180px; margin: 0 auto; padding: 0 1.25rem; }

    /* ---- Scroll progress: a gold hairline under the top bar ---- */
    .sc-land-progress {
        position: fixed;
        top: 60px;
        left: 0;
        width: 100%;
        height: 3px;
        z-index: 49;
        background: linear-gradient(90deg, var(--land-gold), var(--land-saffron), var(--land-gold));
        transform-origin: 0 50%;
        transform: scaleX(var(--land-prog));
        box-shadow: 0 0 12px var(--land-glow);
        pointer-events: none;
    }

    /* ---- The sky: orbs and stars, fixed to the viewport, drifting with the scroll ---- */
    .sc-land-sky { position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; }
    .sc-land-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(64px);
        opacity: 0.55;
        will-change: transform;
        animation: land-drift 18s ease-in-out infinite alternate;
    }
    .sc-land-orb-a { width: 46vw; height: 46vw; left: -12vw; top: -8vh; background: radial-gradient(circle, rgba(228, 169, 81, 0.75), rgba(228, 169, 81, 0) 70%); transform: translate3d(0, calc(var(--land-y) * -0.08), 0); }
    .sc-land-orb-b { width: 38vw; height: 38vw; right: -10vw; top: 30vh; background: radial-gradient(circle, rgba(212, 114, 34, 0.6), rgba(212, 114, 34, 0) 70%); animation-delay: -6s; transform: translate3d(0, calc(var(--land-y) * -0.14), 0); }
    .sc-land-orb-c { width: 30vw; height: 30vw; left: 30vw; bottom: -14vh; background: radial-gradient(circle, rgba(255, 226, 168, 0.7), rgba(255, 226, 168, 0) 70%); animation-delay: -12s; transform: translate3d(0, calc(var(--land-y) * -0.05), 0); }
    :root[data-theme="dark"] .sc-land-orb { opacity: 0.38; }
    @@keyframes land-drift {
        from { translate: 0 0; scale: 1; }
        to { translate: 4vw 3vh; scale: 1.08; }
    }

    .sc-land-stars {
        position: absolute;
        inset: 0;
        opacity: 0;
        background-image:
            radial-gradient(1.5px 1.5px at 8% 18%, rgba(255, 240, 210, 0.9), transparent 60%),
            radial-gradient(1px 1px at 22% 62%, rgba(255, 240, 210, 0.8), transparent 60%),
            radial-gradient(1.5px 1.5px at 35% 30%, rgba(255, 226, 168, 0.9), transparent 60%),
            radial-gradient(1px 1px at 48% 80%, rgba(255, 240, 210, 0.7), transparent 60%),
            radial-gradient(2px 2px at 60% 12%, rgba(255, 226, 168, 0.95), transparent 60%),
            radial-gradient(1px 1px at 70% 48%, rgba(255, 240, 210, 0.8), transparent 60%),
            radial-gradient(1.5px 1.5px at 82% 72%, rgba(255, 226, 168, 0.9), transparent 60%),
            radial-gradient(1px 1px at 90% 26%, rgba(255, 240, 210, 0.8), transparent 60%),
            radial-gradient(1px 1px at 15% 88%, rgba(255, 240, 210, 0.7), transparent 60%),
            radial-gradient(1.5px 1.5px at 55% 55%, rgba(255, 226, 168, 0.8), transparent 60%),
            radial-gradient(1px 1px at 95% 92%, rgba(255, 240, 210, 0.7), transparent 60%),
            radial-gradient(1px 1px at 40% 5%, rgba(255, 240, 210, 0.8), transparent 60%);
        transform: translate3d(0, calc(var(--land-y) * -0.03), 0);
        transition: opacity 0.6s ease;
    }
    :root[data-theme="dark"] .sc-land-stars { opacity: 0.85; animation: land-twinkle 6s ease-in-out infinite alternate; }
    @@keyframes land-twinkle { from { opacity: 0.45; } to { opacity: 0.95; } }

    /* ---- Load-in: the hero rises word by word ---- */
    .sc-land-up {
        opacity: 0;
        transform: translateY(26px);
        animation: land-up 1s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
        animation-delay: var(--d, 0s);
    }
    @@keyframes land-up { to { opacity: 1; transform: translateY(0); } }

    /* ---- Reveal on scroll ---- */
    .sc-land [data-reveal] {
        opacity: 0;
        transform: translateY(36px);
        transition: opacity 0.9s ease, transform 1s cubic-bezier(0.2, 0.7, 0.2, 1);
        transition-delay: var(--d, 0s);
        /* Never a blank page: without its JS a reveal still shows after a moment. */
        animation: land-safety 0s linear 2.5s forwards;
    }
    .sc-land.is-ready [data-reveal] { animation: none; }
    .sc-land [data-reveal="left"] { transform: translateX(-44px); }
    .sc-land [data-reveal="right"] { transform: translateX(44px); }
    .sc-land [data-reveal="zoom"] { transform: scale(0.9) translateY(18px); }
    .sc-land [data-reveal="phone-left"] { transform: perspective(1400px) rotateY(22deg) translateX(-60px) scale(0.92); }
    .sc-land [data-reveal="phone-right"] { transform: perspective(1400px) rotateY(-22deg) translateX(60px) scale(0.92); }
    .sc-land [data-reveal].is-in { opacity: 1; transform: none; }
    @@keyframes land-safety { to { opacity: 1; transform: none; } }

    /* ---- Type ---- */
    .sc-land-h1 {
        font-family: "Cinzel", var(--font-heading);
        font-weight: 700;
        font-size: clamp(2.3rem, 5.4vw, 4.6rem);
        line-height: 1.04;
        letter-spacing: 0.005em;
        margin: 1rem 0 1.25rem;
        color: var(--land-ink);
    }
    .sc-land-h1 > span { display: block; }
    .sc-land-grad {
        background: var(--land-text-grad);
        background-size: 200% auto;
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        animation: land-up 1s cubic-bezier(0.2, 0.7, 0.2, 1) forwards, land-shimmer 7s linear 1.2s infinite;
        animation-delay: var(--d, 0s), 1.2s;
        filter: drop-shadow(0 6px 24px var(--land-glow-soft));
    }
    @@keyframes land-shimmer { to { background-position: 200% center; } }

    .sc-land-h2 {
        font-family: "Cinzel", var(--font-heading);
        font-weight: 700;
        font-size: clamp(1.7rem, 3.2vw, 2.7rem);
        line-height: 1.12;
        margin: 0.5rem 0 1rem;
        color: var(--land-ink);
    }
    .sc-land-lead { font-size: clamp(1rem, 1.25vw, 1.15rem); line-height: 1.7; color: var(--land-muted); margin: 0 0 1.4rem; max-width: 34rem; }
    .sc-land-center { text-align: center; }
    .sc-land-center .sc-land-lead { margin-left: auto; margin-right: auto; }

    .sc-land-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--land-deep);
        margin: 0;
    }
    :root[data-theme="dark"] .sc-land-eyebrow { color: var(--land-gold); }
    .sc-land-eyebrow span {
        display: grid;
        place-items: center;
        width: 2rem;
        height: 2rem;
        border-radius: 999px;
        background: var(--land-glass);
        border: 1px solid var(--land-glass-edge);
        box-shadow: 0 6px 18px -8px var(--land-glow);
        font-size: 1rem;
        letter-spacing: 0;
    }
    .sc-land-eyebrow.is-center { justify-content: center; }

    .sc-land-brandpill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.85rem 0.35rem 0.4rem;
        border-radius: 999px;
        background: var(--land-glass);
        border: 1px solid var(--land-glass-edge);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        font-weight: 700;
        font-size: 0.9rem;
        letter-spacing: 0.04em;
        color: var(--land-ink);
        box-shadow: 0 10px 30px -16px var(--land-glow);
    }

    /* ---- Hero ---- */
    .sc-land-hero {
        position: relative;
        min-height: calc(100vh - 60px);
        display: flex;
        align-items: center;
        padding: clamp(2.5rem, 6vh, 5rem) 0 4rem;
        overflow: clip;
    }
    .sc-land-hero-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 3rem;
        align-items: center;
        position: relative;
        z-index: 1;
        /* fades and lifts away as the seeker scrolls on */
        opacity: calc(1 - var(--land-hero) * 0.85);
        transform: translateY(calc(var(--land-hero) * -40px));
    }
    .sc-land-hero-copy { max-width: 40rem; }
    .sc-land-hero-sub { font-size: clamp(1.05rem, 1.4vw, 1.25rem); line-height: 1.7; color: var(--land-muted); margin: 0 0 1.75rem; max-width: 34rem; }

    .sc-land-mandala {
        position: absolute;
        right: -8%;
        top: 50%;
        width: min(78vw, 900px);
        aspect-ratio: 1;
        transform: translateY(-50%);
        color: var(--land-deep);
        opacity: 0.22;
        pointer-events: none;
    }
    :root[data-theme="dark"] .sc-land-mandala { color: var(--land-gold); opacity: 0.2; }
    .sc-land-mandala-svg { width: 100%; height: 100%; overflow: visible; }
    .sc-land-ring { transform-origin: 300px 300px; transform-box: view-box; }
    .sc-land-ring-a { animation: land-spin 120s linear infinite; }
    .sc-land-ring-b { animation: land-spin 80s linear infinite reverse; }
    .sc-land-ring-c { animation: land-spin 50s linear infinite; }
    @@keyframes land-spin { to { transform: rotate(360deg); } }

    .sc-land-cta { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-bottom: 1.5rem; }
    .sc-land-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.95rem 1.5rem;
        border-radius: 14px;
        font: inherit;
        font-weight: 700;
        font-size: 1rem;
        letter-spacing: 0.01em;
        cursor: pointer;
        text-decoration: none;
        border: 1px solid transparent;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease, border-color 0.2s ease;
    }
    .sc-land-btn:hover { text-decoration: none; transform: translateY(-2px); }
    .sc-land-btn:active { transform: translateY(0); }
    .sc-land-btn-ic { font-size: 1.05em; line-height: 1; }
    .sc-land-btn-primary {
        color: #fff;
        background: var(--gradient-gold);
        box-shadow: 0 14px 34px -12px rgba(212, 114, 34, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.35);
        position: relative;
        overflow: hidden;
    }
    .sc-land-btn-primary::after {
        content: "";
        position: absolute;
        top: -40%;
        left: -60%;
        width: 40%;
        height: 180%;
        background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.45), transparent);
        transform: skewX(-20deg);
        animation: land-sheen 4.5s ease-in-out 2s infinite;
    }
    @@keyframes land-sheen { 0%, 70% { left: -60%; } 100% { left: 140%; } }
    .sc-land-btn-primary:hover { box-shadow: 0 18px 40px -12px rgba(212, 114, 34, 0.85), inset 0 1px 0 rgba(255, 255, 255, 0.35); }
    .sc-land-btn-ghost {
        color: var(--land-ink);
        background: var(--land-glass);
        border-color: var(--land-glass-edge);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }
    .sc-land-btn-ghost:hover { border-color: var(--land-gold); box-shadow: 0 12px 30px -16px var(--land-glow); }

    .sc-land-badges { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .sc-land-badges li {
        font-size: 0.82rem;
        font-weight: 600;
        padding: 0.4rem 0.8rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--color-primary-container) 70%, transparent);
        color: var(--color-on-primary-container);
        border: 1px solid var(--glass-border);
    }

    /* The hero phone and what orbits it */
    .sc-land-hero-stage {
        position: relative;
        display: grid;
        place-items: center;
        min-height: 560px;
        --tilt-x: 0deg;
        --tilt-y: 0deg;
    }
    .sc-land-tilt {
        transform: perspective(1400px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
        transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
        transform-style: preserve-3d;
    }
    .sc-land-halo {
        position: absolute;
        width: 120%;
        aspect-ratio: 1;
        border-radius: 50%;
        background: radial-gradient(circle, var(--land-glow) 0%, var(--land-glow-soft) 30%, transparent 62%);
        filter: blur(10px);
        animation: land-breathe 7s ease-in-out infinite;
        pointer-events: none;
    }
    @@keyframes land-breathe { 0%, 100% { transform: scale(0.94); opacity: 0.8; } 50% { transform: scale(1.06); opacity: 1; } }
    .sc-land-rays {
        position: absolute;
        width: 150%;
        aspect-ratio: 1;
        border-radius: 50%;
        background: repeating-conic-gradient(from 0deg, var(--land-glow-soft) 0deg 5deg, transparent 5deg 18deg);
        -webkit-mask: radial-gradient(circle, rgba(0, 0, 0, 0.9) 10%, transparent 58%);
        mask: radial-gradient(circle, rgba(0, 0, 0, 0.9) 10%, transparent 58%);
        animation: land-spin 70s linear infinite;
        pointer-events: none;
        opacity: 0.8;
    }
    .sc-land-phone-float { animation: land-float 7s ease-in-out infinite; will-change: transform; }
    @@keyframes land-float { 0%, 100% { transform: translateY(-9px); } 50% { transform: translateY(9px); } }

    .sc-land-chip {
        position: absolute;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.55rem 0.9rem;
        border-radius: 999px;
        background: var(--land-glass);
        border: 1px solid var(--land-glass-edge);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        box-shadow: var(--land-glass-shadow);
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--land-ink);
        white-space: nowrap;
        animation: land-float 6s ease-in-out infinite;
    }
    .sc-land-chip b { font-size: 1rem; }
    .sc-land-chip-a { top: 12%; left: 2%; animation-delay: -1.5s; }
    .sc-land-chip-b { right: 0; top: 42%; animation-delay: -3s; }
    .sc-land-chip-c { left: 6%; bottom: 14%; animation-delay: -4.5s; }

    .sc-land-scrollhint {
        position: absolute;
        left: 50%;
        bottom: 1.2rem;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.75rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--land-muted);
        opacity: calc(1 - var(--land-hero) * 4);
    }
    .sc-land-scrollhint i {
        width: 1px;
        height: 42px;
        background: linear-gradient(var(--land-gold), transparent);
        position: relative;
        overflow: hidden;
    }
    .sc-land-scrollhint i::after {
        content: "";
        position: absolute;
        left: 0;
        top: -40%;
        width: 100%;
        height: 40%;
        background: var(--land-ink);
        animation: land-dropline 1.8s ease-in-out infinite;
    }
    @@keyframes land-dropline { to { top: 110%; } }

    /* ---- Feature sections ---- */
    .sc-land-feat { position: relative; z-index: 1; padding: clamp(3rem, 8vh, 6rem) 0; }
    .sc-land-feat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
    .sc-land-feat.is-flip .sc-land-feat-copy { order: 2; }
    .sc-land-feat-copy { max-width: 36rem; }
    .sc-land-feat.is-flip .sc-land-feat-copy { margin-left: auto; }
    .sc-land-feat-phone { position: relative; display: grid; place-items: center; }
    .sc-land-glow {
        position: absolute;
        width: 110%;
        aspect-ratio: 1;
        border-radius: 50%;
        background: radial-gradient(circle, var(--land-glow) 0%, transparent 60%);
        filter: blur(20px);
        pointer-events: none;
        animation: land-breathe 8s ease-in-out infinite;
    }
    .sc-land-points { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
    .sc-land-points li {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 0.8rem 1rem;
        border-radius: 14px;
        background: var(--land-glass);
        border: 1px solid var(--land-glass-edge);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        font-size: 0.98rem;
        line-height: 1.5;
        color: var(--land-ink);
    }
    .sc-land-points li i {
        flex: none;
        display: grid;
        place-items: center;
        width: 1.5rem;
        height: 1.5rem;
        border-radius: 999px;
        background: var(--gradient-gold);
        color: #fff;
        font-size: 0.7rem;
        font-style: normal;
        box-shadow: 0 6px 14px -6px rgba(212, 114, 34, 0.7);
    }

    .sc-land-divider { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; gap: 1rem; margin: 0 auto; max-width: 720px; padding: 0 1.25rem; color: var(--land-gold); }
    .sc-land-divider::before, .sc-land-divider::after { content: ""; flex: 1; height: 1px; background: linear-gradient(90deg, transparent, var(--land-gold), transparent); opacity: 0.6; }
    .sc-land-divider i { font-style: normal; font-size: 0.9rem; animation: land-twinkle 3s ease-in-out infinite alternate; }

    /* Scroll-driven settle, where the browser has it: a phone tilts upright as it enters */
    @@supports (animation-timeline: view()) {
        .sc-land-feat-phone .sc-land-phone-float {
            animation: land-float 7s ease-in-out infinite, land-settle linear both;
            animation-timeline: auto, view();
            animation-range: normal, entry 5% cover 40%;
        }
        @@keyframes land-settle {
            from { rotate: x 10deg; scale: 0.94; }
            to { rotate: x 0deg; scale: 1; }
        }
    }

    /* ---- And more ---- */
    .sc-land-more { position: relative; z-index: 1; padding: clamp(3rem, 8vh, 6rem) 0 2rem; }
    .sc-land-more-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: 2rem; }
    .sc-land-more-card {
        position: relative;
        padding: 1.4rem 1.25rem 1.3rem;
        border-radius: 20px;
        background: var(--land-glass);
        border: 1px solid var(--land-glass-edge);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        box-shadow: var(--land-glass-shadow);
        display: grid;
        gap: 0.45rem;
        overflow: hidden;
    }
    .sc-land-more-card::before {
        content: "";
        position: absolute;
        inset: -40% auto auto -40%;
        width: 80%;
        aspect-ratio: 1;
        border-radius: 50%;
        background: radial-gradient(circle, var(--land-glow-soft), transparent 70%);
        transition: transform 0.6s ease;
    }
    .sc-land-more-card:hover::before { transform: translate(30%, 30%); }
    .sc-land-more-card:hover { transform: translateY(-4px); box-shadow: 0 30px 60px -30px var(--land-glow); transition: transform 0.3s ease, box-shadow 0.3s ease; }
    .sc-land-more-card i {
        font-style: normal;
        display: grid;
        place-items: center;
        width: 2.8rem;
        height: 2.8rem;
        border-radius: 14px;
        background: var(--gradient-saffron);
        color: #fff;
        font-size: 1.35rem;
        box-shadow: 0 10px 24px -10px rgba(141, 78, 25, 0.7);
        margin-bottom: 0.3rem;
    }
    .sc-land-more-card b { font-family: var(--font-heading); font-size: 1.08rem; color: var(--land-ink); }
    .sc-land-more-card span { font-size: 0.9rem; line-height: 1.5; color: var(--land-muted); }

    /* ---- Download ---- */
    .sc-land-dl { position: relative; z-index: 1; padding: clamp(2rem, 6vh, 4rem) 0 clamp(3rem, 8vh, 6rem); }
    .sc-land-dl-card {
        position: relative;
        overflow: hidden;
        padding: clamp(2rem, 5vw, 4rem) clamp(1.25rem, 4vw, 3.5rem);
        border-radius: 32px;
        background: var(--land-glass);
        border: 1px solid var(--land-glass-edge);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        box-shadow: var(--land-glass-shadow), 0 0 0 1px rgba(228, 169, 81, 0.12), 0 0 80px -30px var(--land-glow);
    }
    .sc-land-dl-shine {
        position: absolute;
        inset: -50%;
        background: conic-gradient(from 0deg, transparent 0 70%, var(--land-glow-soft) 80%, transparent 90%);
        animation: land-spin 24s linear infinite;
        pointer-events: none;
        opacity: 0.9;
    }
    .sc-land-dl-card > * { position: relative; }
    .sc-land-stores { display: flex; justify-content: center; flex-wrap: wrap; gap: 1.5rem; margin-top: 1.5rem; }
    .sc-land-store {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.85rem;
        width: min(100%, 290px);
        padding: 1.8rem 1.25rem 1.5rem;
        border-radius: 24px;
        background: color-mix(in srgb, var(--color-surface) 85%, transparent);
        border: 1px solid var(--land-glass-edge);
        color: inherit;
        text-decoration: none;
        transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }
    .sc-land-store:hover { text-decoration: none; transform: translateY(-6px); border-color: var(--land-gold); box-shadow: 0 30px 60px -28px var(--land-glow); }
    .sc-land-soon {
        position: absolute;
        top: -0.7rem;
        right: 1rem;
        padding: 0.3rem 0.7rem;
        border-radius: 999px;
        background: var(--gradient-gold);
        color: #fff;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        box-shadow: var(--shadow-glow);
    }
    .sc-land-qr-tile { display: block; padding: 0.7rem; border-radius: 18px; background: #fff; box-shadow: inset 0 0 0 1px #E9E1D2, 0 10px 30px -18px rgba(61, 33, 10, 0.4); }
    .sc-land-qr { display: block; width: 156px; height: 156px; color: #1B120A; }
    .sc-land-qr-hint { font-size: 0.78rem; color: var(--land-muted); }
    .sc-land-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        padding: 0.55rem 1.1rem 0.55rem 0.85rem;
        border-radius: 13px;
        background: #111;
        color: #fff;
        border: 1px solid #3a3a3a;
        min-width: 190px;
    }
    .sc-land-badge small { display: block; font-size: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.85; line-height: 1.1; }
    .sc-land-badge b { display: block; font-size: 1.15rem; line-height: 1.15; letter-spacing: 0.01em; }
    .sc-land-dl-web { text-align: center; margin: 1.75rem 0 0; color: var(--land-muted); font-size: 0.95rem; }
    .sc-land-dl-web a { font-weight: 700; color: var(--color-accent); }
    .sc-land-dl-web span { margin: 0 0.4rem; }

    /* ---- Footer ---- */
    .sc-land-foot { position: relative; z-index: 1; padding: 2rem 0 3rem; border-top: 1px solid var(--glass-border); background: color-mix(in srgb, var(--color-surface) 55%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
    .sc-land-foot-grid { display: grid; grid-template-columns: 1fr auto; gap: 1rem 2rem; align-items: center; }
    .sc-land-foot-brand { display: flex; align-items: center; gap: 0.8rem; }
    .sc-land-foot-brand b { display: block; font-family: var(--font-heading); font-size: 1.1rem; }
    .sc-land-foot-brand span { display: block; font-size: 0.82rem; color: var(--land-muted); }
    .sc-land-foot-links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; font-size: 0.88rem; }
    .sc-land-foot-links a { color: var(--land-ink); }
    .sc-land-foot small { grid-column: 1 / -1; font-size: 0.78rem; color: var(--land-muted); }

    /* =========================================================================
       The phone: a frame drawn in CSS around a screen drawn from the app's tokens.
       Everything inside is in em so one font-size scales the whole device.
       ========================================================================= */
    .sc-land-phone {
        position: relative;
        font-size: 12px;
        width: 22.6em;
        height: 46.8em;
        border-radius: 3.4em;
        padding: 0.6em;
        background: linear-gradient(160deg, #3b2a1b 0%, #150d07 45%, #2a1a0e 100%);
        box-shadow:
            0 50px 90px -34px rgba(0, 0, 0, 0.6),
            0 18px 40px -20px rgba(61, 33, 10, 0.5),
            inset 0 0 0 1px rgba(255, 255, 255, 0.08);
        transform: translateZ(0);
    }
    .sc-land-phone::before {
        content: "";
        position: absolute;
        inset: -2px;
        border-radius: inherit;
        padding: 2px;
        background: linear-gradient(140deg, rgba(255, 226, 168, 0.95), rgba(228, 169, 81, 0.25) 28%, rgba(228, 169, 81, 0.12) 72%, rgba(255, 226, 168, 0.8));
        -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
        -webkit-mask-composite: xor;
        mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
        mask-composite: exclude;
        pointer-events: none;
    }
    .sc-land-phone::after {
        /* side buttons */
        content: "";
        position: absolute;
        right: -0.3em;
        top: 9em;
        width: 0.3em;
        height: 4.5em;
        border-radius: 0 0.2em 0.2em 0;
        background: #2a1a0e;
        box-shadow: 0 7em 0 0 #2a1a0e, -23em -1em 0 0 #2a1a0e, -23em 2.6em 0 0 #2a1a0e;
    }
    .sc-land-phone-hero { font-size: 13px; }

    .lp-screen {
        position: absolute;
        inset: 0.6em;
        border-radius: 2.9em;
        overflow: hidden;
        background: var(--color-background);
        color: var(--color-on-surface);
        display: flex;
        flex-direction: column;
        font-family: var(--font-body);
        line-height: 1.25;
    }
    .lp-screen::after {
        /* glass reflection */
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: linear-gradient(115deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0.04) 28%, transparent 46%);
        pointer-events: none;
    }
    .lp-status { position: relative; flex: none; height: 3em; display: flex; align-items: center; justify-content: space-between; padding: 0.4em 1.7em 0; font-size: 0.95em; font-weight: 700; }
    .lp-status span:last-child { font-size: 0.7em; letter-spacing: 0.08em; }
    .lp-island { position: absolute; top: 0.6em; left: 50%; transform: translateX(-50%); width: 6.6em; height: 1.75em; border-radius: 1em; background: #0a0705; }

    .lp-topbar {
        flex: none;
        display: flex;
        align-items: center;
        gap: 0.55em;
        padding: 0.35em 1.1em 0.6em;
        border-bottom: 1px solid var(--glass-border);
        background: color-mix(in srgb, var(--color-surface) 88%, transparent);
    }
    .lp-logo { width: 2.2em; height: 2.2em; border-radius: 0.7em; background: var(--gradient-saffron); display: grid; place-items: center; color: #fff; font-size: 1em; font-family: var(--font-heading); box-shadow: 0 4px 10px -4px rgba(141, 78, 25, 0.7); }
    .lp-logo .sc-logo-img { width: 1.4em; height: 1.4em; }
    .lp-tb-titles { flex: 1; min-width: 0; display: flex; flex-direction: column; line-height: 1.15; }
    .lp-tb-titles b { font-size: 1em; font-family: var(--font-heading); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .lp-tb-titles i { font-style: normal; font-size: 0.68em; color: var(--color-secondary); }
    .lp-bell { position: relative; font-size: 1.1em; }
    .lp-bell i { position: absolute; top: -0.1em; right: -0.15em; width: 0.6em; height: 0.6em; border-radius: 50%; background: var(--color-error); border: 1.5px solid var(--color-surface); }

    .lp-body { position: relative; flex: 1; min-height: 0; overflow: hidden; padding: 0.8em 1em 0; display: flex; flex-direction: column; gap: 0.7em; }
    .lp-body::after {
        /* the page runs on below the fold */
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 2.5em;
        background: linear-gradient(transparent, var(--color-background));
        pointer-events: none;
    }

    .lp-nav {
        flex: none;
        display: flex;
        height: 4.4em;
        padding: 0.3em 0.2em 0.6em;
        border-top: 1px solid var(--glass-border);
        background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    }
    .lp-nav span { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.2em; font-size: 1.1em; color: var(--color-secondary); position: relative; }
    .lp-nav span i { font-style: normal; font-size: 0.5em; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
    .lp-nav span.active { color: var(--color-primary); }
    .lp-nav span.active::before { content: ""; position: absolute; top: 0.1em; width: 2.6em; height: 1.6em; border-radius: 999px; background: var(--color-primary-container); z-index: -1; }

    /* shared bits */
    .lp-sec { font-size: 0.7em; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-secondary); margin-top: 0.2em; }
    .lp-sec.red { color: #B3261E; }
    .lp-sec.green { color: #2E7D32; }
    :root[data-theme="dark"] .lp-sec.red { color: #F2B8B5; }
    :root[data-theme="dark"] .lp-sec.green { color: #9BD3A2; }
    .lp-card { border-radius: 1.2em; padding: 0.8em 0.9em; background: color-mix(in srgb, var(--color-surface) 92%, transparent); border: 1px solid var(--glass-border); box-shadow: 0 6px 16px -10px rgba(61, 33, 10, 0.3); display: grid; gap: 0.45em; }
    .lp-card-h { display: flex; justify-content: space-between; align-items: baseline; }
    .lp-card-h b { font-family: var(--font-heading); font-size: 0.95em; }
    .lp-card-h span { font-size: 0.66em; color: var(--color-secondary); }
    .lp-kv { display: flex; justify-content: space-between; gap: 0.6em; font-size: 0.8em; padding: 0.25em 0; border-top: 1px dashed var(--color-outline); }
    .lp-kv span { color: var(--color-secondary); }
    .lp-kv b { text-align: right; }
    .lp-kv.is-red b { color: #B3261E; }
    :root[data-theme="dark"] .lp-kv.is-red b { color: #F2B8B5; }
    .lp-chip { display: inline-flex; align-items: center; gap: 0.35em; font-size: 0.66em; font-weight: 700; padding: 0.3em 0.7em; border-radius: 999px; background: var(--color-primary-container); color: var(--color-on-primary-container); }
    .lp-chip.live i { width: 0.7em; height: 0.7em; border-radius: 50%; background: #2E7D32; box-shadow: 0 0 0 0 rgba(46, 125, 50, 0.5); animation: lp-pulse 2s ease-out infinite; }
    @@keyframes lp-pulse { to { box-shadow: 0 0 0 0.6em rgba(46, 125, 50, 0); } }
    .lp-page-h { display: flex; justify-content: space-between; align-items: center; gap: 0.5em; }
    .lp-page-h b.lp-month { font-family: var(--font-heading); font-size: 1em; }
    .lp-tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5em; }
    .lp-tiles.two { grid-template-columns: 1fr 1.25fr; }
    .lp-tile { border-radius: 1em; padding: 0.65em 0.6em; background: color-mix(in srgb, var(--color-surface) 90%, transparent); border: 1px solid var(--glass-border); display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.1em; }
    .lp-tile b { font-size: 1.35em; font-family: var(--font-heading); line-height: 1.1; }
    .lp-tile span { font-size: 0.6em; color: var(--color-secondary); font-weight: 600; }
    .lp-tile.accent { background: var(--color-primary-container); color: var(--color-on-primary-container); }
    .lp-tile.accent span { color: inherit; opacity: 0.8; }
    .lp-tile.lp-next i { font-style: normal; font-size: 1.1em; }
    .lp-tile.lp-next b { font-size: 0.95em; }
    .lp-tile.lp-sun { align-items: stretch; gap: 0.35em; }
    .lp-tile.lp-sun span { display: flex; justify-content: space-between; font-size: 0.68em; }
    .lp-tile.lp-sun b { font-size: 0.85em; }

    /* home */
    .lp-aurora { position: absolute; inset: -30% -20% auto; height: 60%; background: radial-gradient(60% 60% at 30% 30%, rgba(228, 169, 81, 0.35), transparent 70%), radial-gradient(50% 60% at 80% 20%, rgba(212, 114, 34, 0.25), transparent 70%); filter: blur(18px); pointer-events: none; }
    .lp-greet { position: relative; display: flex; flex-direction: column; line-height: 1.2; }
    .lp-greet-k { font-size: 0.7em; color: var(--color-secondary); font-weight: 600; }
    .lp-greet-n { font-size: 1.3em; font-family: var(--font-heading); }
    .lp-bento { position: relative; display: grid; grid-template-columns: 1.3fr 1fr; gap: 0.6em; }
    .lp-streak { border-radius: 1.2em; padding: 0.85em 0.9em; color: #fff; background: var(--gradient-saffron); box-shadow: 0 10px 24px -12px rgba(141, 78, 25, 0.8); display: flex; flex-direction: column; gap: 0.2em; position: relative; overflow: hidden; }
    .lp-streak::after { content: ""; position: absolute; right: -2em; top: -2em; width: 6em; height: 6em; border-radius: 50%; background: rgba(255, 255, 255, 0.12); }
    .lp-streak-k { font-size: 0.68em; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.9; }
    .lp-streak-n { font-size: 2.6em; font-family: var(--font-heading); line-height: 1; }
    .lp-streak-s { font-size: 0.62em; opacity: 0.9; line-height: 1.3; }
    .lp-streak-bar { display: block; height: 0.45em; border-radius: 999px; background: rgba(255, 255, 255, 0.25); overflow: hidden; margin-top: 0.3em; }
    .lp-streak-bar i { display: block; height: 100%; width: 0; border-radius: inherit; background: #FFE2A8; transition: width 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) 0.4s; }
    .is-in .lp-streak-bar i, .sc-land-hero .lp-streak-bar i { width: 72%; }
    .lp-deity { border-radius: 1.2em; background-size: cover; background-position: center top; position: relative; min-height: 8.6em; display: flex; flex-direction: column; justify-content: flex-end; padding: 0.6em 0.7em; color: #fff; overflow: hidden; box-shadow: 0 10px 24px -12px rgba(0, 0, 0, 0.6); }
    .lp-deity::before { content: ""; position: absolute; inset: 0; background: linear-gradient(transparent 40%, rgba(30, 14, 5, 0.85)); }
    .lp-deity span, .lp-deity b { position: relative; }
    .lp-deity span { font-size: 0.58em; text-transform: uppercase; letter-spacing: 0.08em; opacity: 0.9; }
    .lp-deity b { font-size: 0.85em; font-family: var(--font-heading); }
    .lp-bhakti { gap: 0.2em; padding: 0.5em 0.7em; }
    .lp-bhakti-row { display: flex; align-items: center; gap: 0.6em; padding: 0.4em 0; }
    .lp-bhakti-row + .lp-bhakti-row { border-top: 1px dashed var(--color-outline); }
    .lp-bhakti-row i { font-style: normal; font-size: 1.2em; width: 2em; height: 2em; display: grid; place-items: center; border-radius: 0.7em; background: var(--color-primary-container); }
    .lp-bhakti-row div { flex: 1; min-width: 0; display: flex; flex-direction: column; }
    .lp-bhakti-row b { font-size: 0.82em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .lp-bhakti-row span { font-size: 0.62em; color: var(--color-secondary); }
    .lp-bhakti-row em { font-style: normal; color: var(--color-secondary); }

    /* panchangam */
    .lp-datenav { display: flex; justify-content: space-between; align-items: center; font-size: 0.85em; }
    .lp-datenav span { color: var(--color-secondary); font-size: 1.3em; padding: 0 0.4em; }
    .lp-datenav b { font-family: var(--font-heading); }
    .lp-sunrow { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5em; }
    .lp-sunrow div { display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: 0.5em; align-items: center; padding: 0.55em 0.7em; border-radius: 1em; background: var(--color-primary-container); color: var(--color-on-primary-container); }
    .lp-sunrow i { grid-row: 1 / 3; font-style: normal; font-size: 1.4em; }
    .lp-sunrow span { font-size: 0.6em; text-transform: uppercase; letter-spacing: 0.06em; opacity: 0.85; }
    .lp-sunrow b { font-size: 0.85em; }
    .lp-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0.45em; }
    .lp-fact { padding: 0.5em 0.65em; border-radius: 0.9em; background: color-mix(in srgb, var(--color-surface) 92%, transparent); border: 1px solid var(--glass-border); display: flex; flex-direction: column; gap: 0.1em; }
    .lp-fact span { font-size: 0.6em; color: var(--color-secondary); text-transform: uppercase; letter-spacing: 0.06em; }
    .lp-fact b { font-size: 0.8em; }
    .lp-row { display: flex; justify-content: space-between; align-items: center; gap: 0.5em; padding: 0.45em 0.7em; border-radius: 0.8em; font-size: 0.78em; border: 1px solid transparent; }
    .lp-row.red { background: rgba(179, 38, 30, 0.1); border-color: rgba(179, 38, 30, 0.25); }
    .lp-row.green { background: rgba(46, 125, 50, 0.1); border-color: rgba(46, 125, 50, 0.25); }
    .lp-row span { color: var(--color-on-surface); }
    .lp-row b { white-space: nowrap; }
    .lp-fab { position: absolute; right: 1em; bottom: 1em; width: 3.2em; height: 3.2em; border-radius: 50%; display: grid; place-items: center; background: var(--gradient-saffron); color: #fff; font-size: 1.1em; box-shadow: 0 10px 22px -8px rgba(141, 78, 25, 0.7); z-index: 1; }

    /* calendar */
    .lp-masam { font-size: 0.62em; color: var(--color-secondary); text-align: center; }
    .lp-dow { display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; font-size: 0.6em; font-weight: 700; color: var(--color-secondary); text-transform: uppercase; }
    .lp-days { display: grid; grid-template-columns: repeat(7, 1fr); gap: 0.2em; text-align: center; }
    .lp-days span { position: relative; display: grid; place-items: center; height: 2.35em; border-radius: 0.6em; font-size: 0.8em; font-weight: 600; background: color-mix(in srgb, var(--color-surface) 92%, transparent); border: 1px solid var(--glass-border); padding-bottom: 0.4em; }
    .lp-days span i { position: absolute; bottom: 0.15em; font-style: normal; font-size: 0.6em; line-height: 1; }
    .lp-days span.obs i { width: 0.45em; height: 0.45em; border-radius: 50%; background: var(--color-accent); }
    .lp-days span.fest { background: var(--color-primary-container); color: var(--color-on-primary-container); border-color: transparent; }
    .lp-days span.mine i { color: var(--color-accent); }
    .lp-days span.off { opacity: 0.35; }
    .lp-days span.today { background: var(--gradient-saffron); color: #fff; border-color: transparent; box-shadow: 0 0 0 0 rgba(212, 114, 34, 0.6); animation: lp-today 2.4s ease-out infinite; }
    @@keyframes lp-today { to { box-shadow: 0 0 0 0.6em rgba(212, 114, 34, 0); } }
    .lp-ev { display: flex; align-items: center; gap: 0.6em; padding: 0.4em 0.6em; border-radius: 0.9em; background: color-mix(in srgb, var(--color-surface) 92%, transparent); border: 1px solid var(--glass-border); }
    .lp-ev i { font-style: normal; font-size: 1.1em; width: 1.9em; height: 1.9em; display: grid; place-items: center; border-radius: 0.6em; background: var(--color-primary-container); }
    .lp-ev.mine i { color: var(--color-accent); }
    .lp-ev div { display: flex; flex-direction: column; }
    .lp-ev b { font-size: 0.8em; }
    .lp-ev span { font-size: 0.62em; color: var(--color-secondary); }

    /* japa (immersive: no bottom bar, the whole screen counts) */
    .lp-screen-japa { background: radial-gradient(90% 60% at 50% 0%, color-mix(in srgb, var(--color-primary-container) 80%, transparent), transparent 70%), var(--color-background); }
    .lp-japa-h { flex: none; display: flex; justify-content: space-between; align-items: center; padding: 0.3em 1.1em 0.4em; }
    .lp-japa-h b { font-family: var(--font-heading); font-size: 1em; }
    .lp-japa-h span { color: var(--color-secondary); font-size: 1.1em; }
    .lp-japa { align-items: center; justify-content: space-between; gap: 0.6em; text-align: center; padding-bottom: 1em; }
    .lp-japa::after { display: none; }
    .lp-japa-deity { font-size: 0.66em; font-weight: 700; padding: 0.35em 0.8em; border-radius: 999px; background: var(--color-primary-container); color: var(--color-on-primary-container); }
    .lp-japa-ring { position: relative; width: 12.5em; height: 12.5em; border-radius: 50%; display: grid; place-items: center; background: conic-gradient(var(--color-accent) 0 240deg, color-mix(in srgb, var(--color-primary) 18%, transparent) 240deg 360deg); box-shadow: 0 20px 40px -24px rgba(141, 78, 25, 0.7); }
    .lp-japa-ring::before { content: ""; position: absolute; inset: 0.9em; border-radius: 50%; background: var(--color-background); }
    .lp-japa-count { position: relative; display: flex; flex-direction: column; line-height: 1; }
    .lp-japa-count b { font-size: 3.6em; font-family: var(--font-heading); }
    .lp-japa-count span { font-size: 0.75em; color: var(--color-secondary); margin-top: 0.4em; }
    .lp-ripple { position: absolute; inset: -0.5em; border-radius: 50%; border: 2px solid var(--color-accent); opacity: 0; animation: lp-ripple 3s ease-out infinite; }
    .lp-ripple.two { animation-delay: 1.5s; }
    @@keyframes lp-ripple { 0% { transform: scale(0.9); opacity: 0.7; } 100% { transform: scale(1.35); opacity: 0; } }
    .lp-japa-text { font-size: 1.25em; font-family: var(--font-heading); display: flex; flex-direction: column; gap: 0.15em; }
    .lp-japa-text i { font-style: normal; font-size: 0.6em; color: var(--color-secondary); font-family: var(--font-body); }
    .lp-beads { display: flex; gap: 0.45em; }
    .lp-beads i { width: 0.9em; height: 0.9em; border-radius: 50%; background: color-mix(in srgb, var(--color-primary) 20%, transparent); }
    .lp-beads i.on { background: var(--gradient-gold); }
    .lp-beads i.cur { background: var(--color-accent); box-shadow: 0 0 0 0.25em rgba(212, 114, 34, 0.25); }
    .lp-japa-hint { font-size: 0.62em; color: var(--color-secondary); padding: 0 1em; }
    .lp-japa-foot { width: 100%; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.4em; }
    .lp-japa-foot div { display: flex; flex-direction: column; align-items: center; padding: 0.5em 0.3em; border-radius: 0.9em; background: color-mix(in srgb, var(--color-surface) 92%, transparent); border: 1px solid var(--glass-border); }
    .lp-japa-foot b { font-size: 1.1em; font-family: var(--font-heading); }
    .lp-japa-foot span { font-size: 0.55em; color: var(--color-secondary); font-weight: 600; text-align: center; }

    /* puja */
    .lp-puja-hero { border-radius: 1.2em; padding: 0.8em 0.9em; color: #fff; background: var(--gradient-saffron); display: flex; flex-direction: column; gap: 0.2em; box-shadow: 0 10px 24px -12px rgba(141, 78, 25, 0.8); }
    .lp-puja-hero span { font-size: 0.62em; text-transform: uppercase; letter-spacing: 0.06em; opacity: 0.9; }
    .lp-puja-hero b { font-size: 1.1em; font-family: var(--font-heading); }
    .lp-puja-hero small { font-size: 0.62em; opacity: 0.9; }
    .lp-bar { display: block; height: 0.45em; border-radius: 999px; background: rgba(255, 255, 255, 0.25); overflow: hidden; margin-top: 0.25em; }
