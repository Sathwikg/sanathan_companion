@code {
    // Placeholders until the listings exist. The Play Store address is already the final one — it
    // follows from the ApplicationId in App.Mobile.csproj — and the App Store id is a dummy. The
    // two QR codes in wwwroot/landing/ encode exactly these; regenerate them when these change.
    private const string PlayStoreUrl = "https://play.google.com/store/apps/details?id=com.sanathana.companion";
    private const string AppStoreUrl = "https://apps.apple.com/app/id0000000000";

    private ElementReference _root;
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/App.UI.Shared/landing.js");
            await _module.InvokeVoidAsync("attach", _root);
        }
        catch
        {
            // Without the module the page still shows (land-safety); only the scroll motion is lost.
        }
    }

    private async Task ScrollToDownload()
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("scrollTo", "download"); }
        catch { /* the page is going away */ }
    }

    public override void Dispose()
    {
        if (_module is not null) _ = DisposeModuleAsync(_module);
        base.Dispose();
    }

    private static async Task DisposeModuleAsync(IJSObjectReference module)
    {
        try
        {
            await module.InvokeVoidAsync("detach");
            await module.DisposeAsync();
        }
        catch { /* the page, or the WebView, is already gone */ }
    }
}
