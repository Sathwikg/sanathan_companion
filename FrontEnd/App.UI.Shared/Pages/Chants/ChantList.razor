@page "/chants"
@attribute [Authorize]
@inject IApiClient Api
@inject ConfirmService Confirm
@inject ToastService Toast

<div class="sc-page-head">
    <div class="sc-page-title">
        <span class="sc-page-emoji">📿</span>
        <div>
            <h1>Chants</h1>
            <p class="sc-page-sub">Manage chants and their japa counts</p>
        </div>
    </div>
    <div class="sc-page-actions">
        <div class="sc-viewtoggle">
            <button class="@(_view == "grid" ? "active" : "")" @onclick='() => _view = "grid"'>▦ Grid</button>
            <button class="@(_view == "list" ? "active" : "")" @onclick='() => _view = "list"'>☰ List</button>
        </div>
        <button class="sc-btn-primary sc-btn-sm" @onclick="OpenCreate">+ Create</button>
    </div>
</div>

@if (_error is not null)
{
    <div class="sc-alert sc-alert-error">@_error</div>
}

@if (_loading)
{
    <OmLoader FullPage="true" Message="Loading chants…" />
}
else if (_list.Count == 0)
{
    <div class="sc-card sc-empty-state">
        <div class="sc-empty-om">📿</div>
        <h3>No chants yet</h3>
        <p>Create your first chant to get started.</p>
        <button class="sc-btn-primary sc-btn-sm" @onclick="OpenCreate">+ Create Chant</button>
    </div>
}
else if (_view == "grid")
{
    <div class="sc-cardgrid">
        @foreach (var c in Paged)
        {
            <div class="sc-tile @(c.IsActive ? "" : "is-inactive")">
                <div class="sc-tile-top">
                    <div class="sc-tile-badge">📿</div>
                    <span class="sc-badge @(c.IsActive ? "on" : "off")">@(c.IsActive ? "Active" : "Inactive")</span>
                </div>
                <h3 class="sc-tile-title">@c.Name</h3>
                <p class="sc-tile-desc">@(string.IsNullOrWhiteSpace(c.Description) ? "No description" : c.Description)</p>
                @if (c.HasCount)
                {
                    <div class="sc-chiprow"><span class="sc-minichip">Count: @c.Count</span></div>
                }
                <div class="sc-tile-foot">
                    <button class="sc-chip @(c.IsActive ? "chip-warn" : "chip-ok")" @onclick="() => ConfirmToggle(c)">
                        @(c.IsActive ? "Deactivate" : "Activate")
                    </button>
                    <button class="sc-btn-ghost sc-btn-sm" @onclick="() => OpenEdit(c)">Edit</button>
                </div>
            </div>
        }
    </div>
    <Pager Page="_page" PageCount="PageCount" TotalCount="_list.Count" PageSize="PageSize" OnGoTo="GoTo" />
}
else
{
    <div class="sc-card sc-tablewrap">
        <table class="sc-table">
            <thead>
                <tr>
                    <th>Chant Name</th>
                    <th>Description</th>
                    <th>Count</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Paged)
                {
                    <tr>
                        <td><strong>@c.Name</strong></td>
                        <td class="sc-muted">@c.Description</td>
                        <td class="sc-muted">@(c.HasCount ? c.Count?.ToString() : "—")</td>
                        <td>
                            <label class="sc-switch">
                                <input type="checkbox" checked="@c.IsActive" @onclick="() => ConfirmToggle(c)" @onclick:preventDefault />
                                <span class="sc-slider"></span>
                            </label>
                            <span class="sc-status @(c.IsActive ? "on" : "off")">@(c.IsActive ? "Active" : "Inactive")</span>
                        </td>
                        <td><button class="sc-btn-ghost sc-btn-sm" @onclick="() => OpenEdit(c)">Edit</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <Pager Page="_page" PageCount="PageCount" TotalCount="_list.Count" PageSize="PageSize" OnGoTo="GoTo" />
}

<ScModal Visible="_showForm" Title="@(_editId is null ? "Create Chant" : "Edit Chant")" OnClose="CloseForm">
    <EditForm Model="_model" OnValidSubmit="SaveAsync" class="sc-form">
        <DataAnnotationsValidator />

        @if (_formError is not null)
        {
            <div class="sc-alert sc-alert-error">@_formError</div>
        }

        <div class="sc-field">
            <label>Chant Name</label>
            <InputText @bind-Value="_model.Name" class="sc-input" />
            <ValidationMessage For="() => _model.Name" />
        </div>

        <div class="sc-field">
            <label>Description</label>
            <InputTextArea @bind-Value="_model.Description" class="sc-input" rows="3" />
            <ValidationMessage For="() => _model.Description" />
        </div>

        <div class="sc-switches">
            <div class="sc-switchrow">
                <label class="sc-switch"><input type="checkbox" @bind="_model.HasCount" @bind:after="OnHasCountChanged" /><span class="sc-slider"></span></label>
                <span>Count Exists</span>
            </div>
        </div>

        @if (_model.HasCount)
        {
            <div class="sc-field">
                <label>Count</label>
                <InputNumber @bind-Value="_model.Count" class="sc-input" min="1" />
                <ValidationMessage For="() => _model.Count" />
            </div>
        }

        <div class="sc-switches">
            <div class="sc-switchrow">
                <label class="sc-switch"><input type="checkbox" @bind="_model.IsActive" /><span class="sc-slider"></span></label>
                <span>Active</span>
            </div>
        </div>

        <div class="sc-modal-actions">
            <button type="button" class="sc-btn-ghost" @onclick="CloseForm">Cancel</button>
            <button type="submit" class="sc-btn-primary" disabled="@_busy">
                @if (_busy) { <OmLoader Inline="true" Size="18" Message="Saving…" /> } else { <span>@(_editId is null ? "Create" : "Update")</span> }
            </button>
        </div>
    </EditForm>
</ScModal>

@code {
    private string _view = "grid";
    private bool _loading = true;
    private string? _error;
    private List<ChantModel> _list = new();

    private int _page = 1;
    private const int PageSize = 8;
    private int PageCount => Math.Max(1, (int)Math.Ceiling(_list.Count / (double)PageSize));
    private IEnumerable<ChantModel> Paged => _list.Skip((_page - 1) * PageSize).Take(PageSize);

    private bool _showForm;
    private Guid? _editId;
    private ChantRequest _model = new();
    private bool _busy;
    private string? _formError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _list = await Api.GetChantsAsync();
            _page = Math.Clamp(_page, 1, PageCount);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void GoTo(int page) => _page = Math.Clamp(page, 1, PageCount);

    private void OpenCreate()
    {
        _editId = null;
        _formError = null;
        _model = new ChantRequest();
        _showForm = true;
    }

    private void OpenEdit(ChantModel c)
    {
        _editId = c.Id;
        _formError = null;
        _model = new ChantRequest
        {
            Name = c.Name,
            Description = c.Description,
            HasCount = c.HasCount,
            Count = c.Count,
            IsActive = c.IsActive
        };
        _showForm = true;
    }

    private void CloseForm() => _showForm = false;

    private void OnHasCountChanged()
    {
        if (!_model.HasCount) _model.Count = null;
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _formError = null;
        if (!_model.HasCount) _model.Count = null;
        var (ok, err) = _editId is null
            ? await Api.CreateChantAsync(_model)
            : await Api.UpdateChantAsync(_editId.Value, _model);
        _busy = false;

        if (ok)
        {
            Toast.Success($"Chant “{_model.Name}” saved.");
            _showForm = false;
            await LoadAsync();
        }
        else
        {
            _formError = err;
        }
    }

    private async Task ConfirmToggle(ChantModel c)
    {
        var activate = !c.IsActive;
        var confirmed = await Confirm.ConfirmAsync(new ConfirmRequest
        {
            Title = activate ? "Activate chant?" : "Deactivate chant?",
            Message = $"Are you sure you want to {(activate ? "activate" : "deactivate")} “{c.Name}”?",
            ConfirmText = activate ? "Yes, activate" : "Yes, deactivate",
            CancelText = "Cancel",
            Kind = activate ? ConfirmKind.Success : ConfirmKind.Warning
        });
        if (!confirmed) return;

        var (ok, err) = await Api.SetChantStatusAsync(c.Id, activate);
        if (ok) Toast.Success($"“{c.Name}” has been {(activate ? "activated" : "deactivated")}.");
        else Toast.Error(err);
        await LoadAsync();
    }
}
