@page "/profile"
@attribute [Authorize]
@inherits LocalizedComponentBase
@inject IApiClient Api
@inject RegionState Region
@inject ToastService Toast
@inject AppConfig Config
@inject IJSRuntime JS
@inject IAuthService AuthService
@inject NavigationManager Nav

<div class="sc-page-head">
    <div class="sc-page-title">
        <span class="sc-page-emoji">🧘</span>
        <div>
            <h1>@Loc["profile.title", "My Profile"]</h1>
            <p class="sc-page-sub">@Loc["profile.sub", "Your details and sadhana journey"]</p>
        </div>
    </div>
</div>

@if (_loading)
{
    <OmLoader FullPage="true" Message="@Loc["profile.loading", "Loading your profile…"]" />
}
else if (_error is not null)
{
    <div class="sc-alert sc-alert-error">@_error</div>
}
else if (_p is not null)
{
    <div class="sc-card sc-profile-hero">
        <div class="sc-avatar sc-avatar-lg" style="width:72px;height:72px;border-radius:18px">
            <span style="font-size:1.7rem">@Initials(_p.FullName)</span>
        </div>
        <div class="sc-profile-id">
            <h2>@_p.FullName</h2>
            <div class="sc-muted">
                @if (!string.IsNullOrWhiteSpace(_p.SeekerName))
                {
                    <span>🕉️ @_p.SeekerName · </span>
                }
                <span class="sc-typechip @(_p.IsAdmin ? "god" : "goddess")">@_p.RoleName</span>
            </div>
        </div>
        <div class="sc-profile-streak">
            <div class="sc-streak-flame @(_p.CurrentStreak > 0 ? "" : "cold")">
                <span class="ic">🔥</span>
                <div>
                    <div class="sc-streak-num">@_p.CurrentStreak</div>
                    <div class="sc-streak-label">@Loc["sadhana.dayStreak", "day streak"]</div>
                </div>
            </div>
            <div class="sc-streak-stats">
                <div class="sc-streak-stat"><div class="n">@_p.LongestStreak</div><div class="l">@Loc["sadhana.longest", "Longest"]</div></div>
                <div class="sc-streak-stat"><div class="n">@_p.TotalMalas</div><div class="l">@Loc["sadhana.totalMalas", "Total malas"]</div></div>
                <div class="sc-streak-stat"><div class="n">@_p.TotalDaysPracticed</div><div class="l">@Loc["common.days", "Days"]</div></div>
            </div>
        </div>
    </div>

    <div class="sc-tabs">
        <button class="sc-tab @(_tab == "profile" ? "active" : "")" @onclick='() => _tab = "profile"'>👤 @Loc["profile.title", "My Profile"]</button>
        <button class="sc-tab @(_tab == "timeline" ? "active" : "")" @onclick='() => _tab = "timeline"'>📅 @Loc["profile.sadhanaTimeline", "Sadhana Timeline"]</button>
    </div>

    @if (_tab == "profile")
    {
        <div class="sc-card">
            <div class="sc-detail-grid">
                <div class="sc-detail-item"><span class="sc-detail-label">@Loc["profile.fullName", "Full name"]</span><span class="sc-detail-value">@_p.FullName</span></div>
                @if (!string.IsNullOrWhiteSpace(_p.SeekerName))
                {
                    <div class="sc-detail-item"><span class="sc-detail-label">@Loc["profile.seekerName", "Seeker name"]</span><span class="sc-detail-value">🕉️ @_p.SeekerName</span></div>
                }
                <div class="sc-detail-item"><span class="sc-detail-label">@Loc["common.email", "Email"]</span><span class="sc-detail-value">@_p.Email</span></div>
                <div class="sc-detail-item"><span class="sc-detail-label">@Loc["common.mobile", "Mobile"]</span><span class="sc-detail-value">@_p.MobileNumber</span></div>
                <div class="sc-detail-item"><span class="sc-detail-label">@Loc["common.role", "Role"]</span><span class="sc-detail-value">@_p.RoleName</span></div>
                <div class="sc-detail-item"><span class="sc-detail-label">@Loc["profile.registered", "Registered"]</span><span class="sc-detail-value">@_p.RegisteredOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span></div>
                <div class="sc-detail-item"><span class="sc-detail-label">@Loc["profile.lastPractice", "Last practice"]</span><span class="sc-detail-value">@(_p.LastPracticeDate?.ToString("dd MMM yyyy") ?? "—")</span></div>
                <div class="sc-detail-item"><span class="sc-detail-label">@Loc["profile.practisedToday", "Practised today"]</span><span class="sc-detail-value">@(_p.PracticedToday ? "✓ " + Loc["common.yes", "Yes"] : Loc["profile.notYet", "Not yet"])</span></div>
            </div>
        </div>

        <div class="sc-card sc-prefcard">
            <div class="sc-section-head" style="margin-bottom:0.6rem">
                <h2>📍 @Loc["profile.defaultRegion", "Default Region"]</h2>
                <span class="sc-section-sub">@Loc["profile.defaultRegionSub", "Gods and chants shown across the app default to this region"]</span>
            </div>
            <div class="sc-field" style="max-width:340px">
                <label>@Loc["common.region", "Region"]</label>
                <select class="sc-input" value="@(_regionId?.ToString() ?? "")" @onchange="SaveRegionAsync" disabled="@_savingRegion">
                    @* "All Regions" is an administrator-only view; seekers always browse one region. *@
                    @if (Region.AllowAllRegions)
                    {
                        <option value="">@Loc["profile.allRegions", "All Regions"]</option>
                    }
                    @foreach (var r in Region.Regions)
                    {
                        <option value="@r.Id">@r.Name</option>
                    }
                </select>
                <span class="sc-hint">
                    @if (_savingRegion) { <span>@Loc["common.saving", "Saving…"]</span> }
                    else { <span>@Loc["profile.regionSwitchHint", "You can still switch region any time from the selector at the top."]</span> }
                </span>
            </div>
        </div>

        <div class="sc-card sc-prefcard">
            <div class="sc-section-head" style="margin-bottom:0.6rem">
                <h2>⚙️ @Loc["profile.preferences", "Preferences"]</h2>
                <span class="sc-section-sub">@Loc["profile.preferencesSub", "How the app looks and speaks to you on this device"]</span>
            </div>
            <div class="sc-preflist">
                <div class="sc-prefrow">
                    <span class="sc-prefrow-label">🌐 @Loc["nav.selectLanguage", "Select language"]</span>
                    <LanguageSelector />
                </div>
                <div class="sc-prefrow">
                    <span class="sc-prefrow-label">🎨 @Loc["profile.appearance", "Appearance"]</span>
                    <ThemeToggle />
                </div>
                <a class="sc-prefrow sc-prefrow-link" href="my-notifications">
                    <span class="sc-prefrow-label">🔔 @Loc["nav.notifications", "Notifications"]</span>
                    <span class="sc-prefrow-chev">›</span>
                </a>
                <a class="sc-prefrow sc-prefrow-link" href="favorites">
                    <span class="sc-prefrow-label">❤️ @Loc["nav.favorites", "Favorites"]</span>
                    <span class="sc-prefrow-chev">›</span>
                </a>
            </div>
        </div>

        <div class="sc-card sc-prefcard">
            <div class="sc-section-head" style="margin-bottom:0.6rem">
                <h2>🔑 @Loc["profile.security", "Security"]</h2>
                <span class="sc-section-sub">@Loc["profile.securitySub", "Change the password you sign in with"]</span>
            </div>

            @if (!_changingPassword)
            {
                <button type="button" class="sc-btn-ghost sc-btn-sm" @onclick="() => _changingPassword = true" disabled="@_busy">
                    @Loc["profile.changePassword", "Change password"]
                </button>
            }
            else
            {
                <div class="sc-danger-confirm" style="max-width:340px">
                    <div class="sc-field">
                        <label>@Loc["profile.currentPassword", "Current password"]</label>
                        <input class="sc-input" type="password" autocomplete="current-password"
                               @bind="_currentPassword" @bind:event="oninput" disabled="@_busy" />
                    </div>
                    <div class="sc-field">
                        <label>@Loc["profile.newPassword", "New password"]</label>
                        <input class="sc-input" type="password" autocomplete="new-password"
                               @bind="_newPassword" @bind:event="oninput" disabled="@_busy" />
                    </div>
                    <div class="sc-field">
                        <label>@Loc["profile.confirmNewPassword", "Confirm new password"]</label>
                        <input class="sc-input" type="password" autocomplete="new-password"
                               @bind="_confirmPassword" @bind:event="oninput" disabled="@_busy" />
                    </div>
                    @if (_passwordError is not null)
                    {
                        <div class="sc-alert sc-alert-error">@_passwordError</div>
                    }
                    <div class="sc-modal-actions">
                        <button type="button" class="sc-btn-ghost sc-btn-sm" @onclick="CancelPasswordChange" disabled="@_busy">
                            @Loc["common.cancel", "Cancel"]
                        </button>
                        <button type="button" class="sc-btn-primary sc-btn-sm" @onclick="ChangePasswordAsync"
                                disabled="@(_busy || !CanChangePassword)">
                            @Loc["common.save", "Save"]
                        </button>
                    </div>
                </div>
            }
        </div>

        <div class="sc-card sc-prefcard sc-dangercard">
            <div class="sc-section-head" style="margin-bottom:0.6rem">
                <h2>🔐 @Loc["profile.yourData", "Your data"]</h2>
                <span class="sc-section-sub">@Loc["profile.yourDataSub", "Take a copy, or close your account for good"]</span>
            </div>

            <div class="sc-preflist">
                <button type="button" class="sc-prefrow sc-prefrow-link" @onclick="ExportAsync" disabled="@_busy">
                    <span class="sc-prefrow-label">⬇️ @Loc["profile.downloadMyData", "Download my data"]</span>
                    <span class="sc-prefrow-chev">›</span>
                </button>
            </div>

            <p class="sc-hint" style="margin-top:0.4rem">
                @Loc["profile.downloadMyDataHint", "A JSON file with your account details, sadhana history, favourites, feedback and notification settings."]
            </p>

            <hr class="sc-danger-rule" />

            @if (!_confirmingDelete)
            {
                <button type="button" class="sc-btn-danger" @onclick="() => _confirmingDelete = true" disabled="@_busy">
                    @Loc["profile.deleteAccount", "Delete my account"]
                </button>
            }
            else
            {
                <div class="sc-danger-confirm">
                    <p class="sc-danger-warning">
                        @Loc["profile.deleteAccountWarning", "This erases your account, your entire sadhana history, your favourites and your feedback. It cannot be undone."]
                    </p>
                    <div class="sc-field" style="max-width:340px">
                        <label>@Loc["profile.confirmWithPassword", "Enter your password to confirm"]</label>
                        <input class="sc-input" type="password" autocomplete="current-password"
                               @bind="_deletePassword" @bind:event="oninput" disabled="@_busy" />
                    </div>
                    @if (_deleteError is not null)
                    {
                        <div class="sc-alert sc-alert-error">@_deleteError</div>
                    }
                    <div class="sc-modal-actions">
                        <button type="button" class="sc-btn-ghost sc-btn-sm" @onclick="CancelDelete" disabled="@_busy">
                            @Loc["common.cancel", "Cancel"]
                        </button>
                        <button type="button" class="sc-btn-danger" @onclick="DeleteAccountAsync"
                                disabled="@(_busy || string.IsNullOrWhiteSpace(_deletePassword))">
                            @if (_busy) { <OmLoader Inline="true" Size="18" Message="@Loc["common.saving", "Saving…"]" /> }
                            else { <span>@Loc["profile.deleteAccountConfirm", "Permanently delete"]</span> }
                        </button>
                    </div>
                </div>
            }
        </div>

        <div class="sc-card sc-prefcard sc-aboutcard">
            <div class="sc-section-head" style="margin-bottom:0.6rem">
                <h2>ℹ️ @Loc["profile.about", "About"]</h2>
            </div>
            <div class="sc-detail-grid">
                <div class="sc-detail-item"><span class="sc-detail-label">@Loc["profile.app", "App"]</span><span class="sc-detail-value">@Config.AppName</span></div>
                <div class="sc-detail-item"><span class="sc-detail-label">@Loc["profile.version", "Version"]</span><span class="sc-detail-value">@Config.AppVersion</span></div>
                <div class="sc-detail-item"><span class="sc-detail-label">@Loc["profile.platform", "Platform"]</span><span class="sc-detail-value">@Config.Platform</span></div>
                <div class="sc-detail-item"><span class="sc-detail-label">@Loc["profile.environment", "Environment"]</span><span class="sc-detail-value">@Config.Environment</span></div>
            </div>
        </div>
    }
    else
    {
        @if (_p.Timeline.Count == 0)
        {
            <div class="sc-card sc-empty-state">
                <div class="sc-empty-om">🪷</div>
                <h3>@Loc["profile.noSadhanaYet", "No sadhana yet"]</h3>
                <p>@Loc["profile.noSadhanaBody", "Your daily practice will appear here once you begin."]</p>
                <a href="sadhana" class="sc-btn-primary sc-btn-sm">@Loc["profile.beginSadhana", "Begin Sadhana"] →</a>
            </div>
        }
        else
        {
            <div class="sc-timeline">
                @foreach (var day in _p.Timeline)
                {
                    <div class="sc-card sc-day-card">
                        <div class="sc-day-head">
                            <div class="sc-tile-date">
                                <span class="sc-tile-day">@day.Date.ToString("dd")</span>
                                <span class="sc-tile-mon">@day.Date.ToString("MMM")</span>
                            </div>
                            <div class="sc-day-meta">
                                <strong>@day.Date.ToString("dddd, dd MMM yyyy")</strong>
                                <span class="sc-muted">🧮 @(day.TotalMalas == 1 ? Loc.TF("profile.malaCountOne", "{0} mala", day.TotalMalas) : Loc.TF("profile.malaCountMany", "{0} malas", day.TotalMalas)) · @(day.Entries.Count == 1 ? Loc.TF("profile.chantCountOne", "{0} chant", day.Entries.Count) : Loc.TF("profile.chantCountMany", "{0} chants", day.Entries.Count)) · @Loc.TF("profile.totalCount", "{0} total count", day.TotalCount)</span>
                            </div>
                        </div>
                        <div class="sc-day-entries">
                            @foreach (var e in day.Entries)
                            {
                                <div class="sc-day-entry">
                                    <span class="sc-day-chant">📿 @e.ChantName</span>
                                    <span class="sc-day-sub">@(string.IsNullOrWhiteSpace(e.DeityName) ? e.CategoryName : e.DeityName)</span>
                                    <span class="sc-day-val">@(e.MalasCompleted == 1 ? Loc.TF("profile.malaCountOne", "{0} mala", e.MalasCompleted) : Loc.TF("profile.malaCountMany", "{0} malas", e.MalasCompleted)) · @e.TotalCount</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
}

@code {
    private MyProfile? _p;
    private bool _loading = true;
    private string? _error;
    private string _tab = "profile";

    private Guid? _regionId;
    private bool _savingRegion;

    private bool _busy;
    private bool _changingPassword;
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _passwordError;
    private bool _confirmingDelete;
    private string _deletePassword = string.Empty;
    private string? _deleteError;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await Region.EnsureLoadedAsync();
        try
        {
            _p = await Api.GetMyProfileAsync();
            _regionId = _p?.DefaultRegionId;
        }
        catch (Exception ex) { _error = Loc["profile.couldNotLoad", "Could not load your profile."] + " " + ex.Message; }
        finally { _loading = false; }
    }

    private async Task SaveRegionAsync(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        Guid? id = Guid.TryParse(raw, out var g) ? g : null;

        _savingRegion = true;
        var (ok, err) = await Api.SetDefaultRegionAsync(id);
        _savingRegion = false;

        if (ok)
        {
            _regionId = id;
            // Follow the new default straight away in the top-bar selector.
            Region.ApplyDefault(id);
            var name = Region.Regions.FirstOrDefault(r => r.Id == id)?.Name ?? Loc["profile.allRegions", "All Regions"];
            Toast.Success(Loc.TF("profile.defaultRegionSet", "Default region set to {0}.", name));
        }
        else
        {
            Toast.Error(err);
        }
    }

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        return parts.Length == 1
            ? parts[0][..1].ToUpper()
            : (parts[0][..1] + parts[^1][..1]).ToUpper();
    }

    private bool CanChangePassword =>
        !string.IsNullOrWhiteSpace(_currentPassword)
        && !string.IsNullOrWhiteSpace(_newPassword)
        && !string.IsNullOrWhiteSpace(_confirmPassword);

    private void CancelPasswordChange()
    {
        _changingPassword = false;
        _currentPassword = _newPassword = _confirmPassword = string.Empty;
        _passwordError = null;
    }

    private async Task ChangePasswordAsync()
    {
        _passwordError = null;

        // Checked here as well as on the server so the seeker is not told "wrong password" by a
        // round trip that was never going to succeed.
        if (_newPassword != _confirmPassword)
        {
            _passwordError = Loc["profile.passwordMismatch", "The two new passwords do not match."];
            return;
        }

        _busy = true;
        try
        {
            var (ok, error) = await Api.ChangePasswordAsync(new ChangePasswordRequest
            {
                CurrentPassword = _currentPassword,
                NewPassword = _newPassword,
                ConfirmNewPassword = _confirmPassword
            });

            if (!ok)
            {
                _passwordError = string.IsNullOrWhiteSpace(error)
                    ? Loc["profile.passwordChangeFailed", "Your password could not be changed."]
                    : error;
                return;
            }

            CancelPasswordChange();
            Toast.Success(Loc["profile.passwordChanged", "Your password has been changed."]);
        }
        catch (Exception ex)
        {
            _passwordError = Loc["profile.passwordChangeFailed", "Your password could not be changed."] + " " + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Downloads everything the app holds about this seeker. The file is built from the response
    /// body in the browser rather than linked to directly, because the export endpoint needs the
    /// bearer token and a plain anchor cannot carry one.
    /// </summary>
    private async Task ExportAsync()
    {
        _busy = true;
        try
        {
            var (ok, json, error) = await Api.ExportMyDataAsync();
            if (!ok)
            {
                Toast.Error(string.IsNullOrWhiteSpace(error)
                    ? Loc["profile.exportFailed", "Could not prepare your data."]
                    : error);
                return;
            }

            await JS.InvokeVoidAsync("scDownload.text", "sanathana-companion-my-data.json", "application/json", json);
            Toast.Success(Loc["profile.exportReady", "Your data has been downloaded."]);
        }
        catch (Exception ex)
        {
            Toast.Error(Loc["profile.exportFailed", "Could not prepare your data."] + " " + ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private void CancelDelete()
    {
        _confirmingDelete = false;
        _deletePassword = string.Empty;
        _deleteError = null;
    }

    private async Task DeleteAccountAsync()
    {
        _busy = true;
        _deleteError = null;
        try
        {
            var (ok, error) = await Api.DeleteMyAccountAsync(new DeleteAccountRequest { Password = _deletePassword });
            if (!ok)
            {
                _deleteError = string.IsNullOrWhiteSpace(error)
                    ? Loc["profile.deleteFailed", "Your account could not be deleted."]
                    : error;
                return;
            }

            // The account is gone, so the token in hand now refers to nothing. Sign out locally and
            // return to the login screen rather than leaving a dead session in place.
            await AuthService.LogoutAsync();
            Nav.NavigateTo("login");
        }
        catch (Exception ex)
        {
            _deleteError = Loc["profile.deleteFailed", "Your account could not be deleted."] + " " + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
