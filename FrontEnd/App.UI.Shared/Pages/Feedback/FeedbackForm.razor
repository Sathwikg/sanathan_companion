@page "/feedback"
@attribute [Authorize]
@inject IApiClient Api
@inject ToastService Toast

<div class="sc-page-head">
    <div class="sc-page-title">
        <span class="sc-page-emoji">📝</span>
        <div>
            <h1>Feedback</h1>
            <p class="sc-page-sub">Share a suggestion, appreciation or report an issue</p>
        </div>
    </div>
</div>

@if (_loading)
{
    <OmLoader FullPage="true" Message="Loading…" />
}
else if (_types.Count == 0)
{
    <div class="sc-card sc-empty-state">
        <div class="sc-empty-om">🏷️</div>
        <h3>No issue types available</h3>
        <p>An administrator needs to add feedback issue types first.</p>
    </div>
}
else
{
    <div class="sc-card" style="max-width:660px">
        <EditForm Model="_req" OnValidSubmit="SubmitAsync" class="sc-form">
            <DataAnnotationsValidator />

            @if (_error is not null)
            {
                <div class="sc-alert sc-alert-error">@_error</div>
            }

            <div class="sc-field">
                <label>Issue Type</label>
                <InputSelect @bind-Value="_req.IssueTypeId" class="sc-input">
                    <option value="@Guid.Empty">— Select an issue type —</option>
                    @foreach (var t in _types)
                    {
                        <option value="@t.Id">@t.Name</option>
                    }
                </InputSelect>
                @if (SelectedType is not null && !string.IsNullOrWhiteSpace(SelectedType.Description))
                {
                    <span class="sc-hint">💡 @SelectedType.Description</span>
                }
            </div>

            <div class="sc-field">
                <label>Description</label>
                <InputTextArea @bind-Value="_req.Description" class="sc-input sc-textarea" rows="6"
                               placeholder="Tell us what's on your mind…" />
                <ValidationMessage For="() => _req.Description" />
            </div>

            <div class="sc-modal-actions" style="justify-content:flex-start">
                <button type="submit" class="sc-btn-primary" disabled="@_busy">
                    @if (_busy) { <OmLoader Inline="true" Size="18" Message="Submitting…" /> }
                    else { <span>Submit Feedback</span> }
                </button>
            </div>
        </EditForm>
    </div>
}

@code {
    private List<IssueTypeModel> _types = new();
    private SubmitFeedbackRequest _req = new();
    private bool _loading = true;
    private bool _busy;
    private string? _error;

    private IssueTypeModel? SelectedType => _types.FirstOrDefault(t => t.Id == _req.IssueTypeId);

    protected override async Task OnInitializedAsync()
    {
        try { _types = await Api.GetActiveIssueTypesAsync(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task SubmitAsync()
    {
        if (_req.IssueTypeId == Guid.Empty)
        {
            _error = "Please choose an issue type.";
            return;
        }

        _busy = true;
        _error = null;
        var (ok, err) = await Api.SubmitFeedbackAsync(_req);
        _busy = false;

        if (ok)
        {
            Toast.Success("🙏 Thank you! Your feedback has been submitted.");
            _req = new();
        }
        else
        {
            _error = err;
        }
    }
}
