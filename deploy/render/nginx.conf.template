# Sanathana Companion — the single public entry point on Render.
#
#   /      -> the Blazor WebAssembly app (static files baked into this image)
#   /api/  -> reverse-proxied to Kestrel on loopback, inside this container
#
# This is a TEMPLATE, not a config: entrypoint.sh runs envsubst over it to
# inject ${PORT} and ${API_PORT}, then writes the result to
# /etc/nginx/conf.d/default.conf. Only those two names are substituted, so
# nginx's own $variables below survive untouched.
#
# Differences from FrontEnd/docker/nginx.conf, which serves the compose stack:
#   * listens on Render's $PORT rather than a fixed 80
#   * proxies to 127.0.0.1 rather than the compose service name `api`, so the
#     `resolver 127.0.0.11` (Docker's embedded DNS, which does not exist on
#     Render) and the variable-in-proxy_pass trick it required are both gone
#   * forwards Render's X-Forwarded-Proto through instead of overwriting it
#
# Response headers are set per-location rather than once at server level: nginx
# drops inherited add_header directives as soon as a location declares its own,
# and the API already sets its own security headers on /api responses.

# Render terminates TLS at its edge and forwards plain HTTP to this container,
# so $scheme is always "http" here. Passing that on would make the API's
# UseHttpsRedirection() bounce every /api request into a redirect loop. Prefer
# the edge's own header and fall back to $scheme only for direct local calls.
map $http_x_forwarded_proto $sc_forwarded_proto {
    default   $scheme;
    "https"   https;
    "http"    http;
}

server {
    # IPv4 only. The compose config also has a `listen [::]:80`, but Render
    # gives containers no outbound IPv6 and routes only IPv4 inbound; if the
    # instance comes up without an IPv6 stack, nginx fails to bind and the whole
    # container dies at startup. There is nothing to gain by keeping it.
    listen      ${PORT};
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    # Kestrel accepts 16 MB (audio uploads base64-inflate); don't reject earlier.
    client_max_body_size 20m;

    gzip            on;
    gzip_vary       on;
    gzip_min_length 1024;
    gzip_types      text/plain text/css application/javascript application/json
                    application/wasm image/svg+xml application/octet-stream;
    # Blazor publishes a .gz sibling for every framework asset — serve those
    # rather than re-compressing multi-megabyte wasm on each request.
    gzip_static     on;

    # ---- API ---------------------------------------------------------------
    location /api/ {
        # A literal target (no variables), so nginx resolves it at startup and
        # needs no `resolver`. Loopback never changes, unlike a compose service
        # whose container IP moves on restart.
        proxy_pass http://127.0.0.1:${API_PORT};

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $sc_forwarded_proto;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_connect_timeout  10s;
        proxy_read_timeout    120s;
        proxy_send_timeout    120s;
        # Chant audio streams straight to the client instead of buffering first.
        proxy_buffering off;
    }

    # Only answers when the API runs with ASPNETCORE_ENVIRONMENT=Development;
    # in Production the API doesn't map Swagger and this returns 404.
    location /swagger {
        proxy_pass http://127.0.0.1:${API_PORT};

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $sc_forwarded_proto;
    }

    # ---- Blazor WebAssembly ------------------------------------------------
    # The SDK fingerprints every filename under _framework, so these can be
    # cached forever. A miss is a genuine 404, not a client-side route.
    location /_framework/ {
        try_files $uri =404;

        add_header Cache-Control          "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff     always;
        add_header Referrer-Policy        no-referrer always;
        add_header X-Frame-Options        DENY        always;
    }

    # Everything else falls back to the SPA shell so deep links keep working.
    # no-cache (revalidate, not "never store") keeps index.html and the
    # entrypoint-generated appsettings.json from going stale after a redeploy.
    location / {
        try_files $uri $uri/ /index.html;

        add_header Cache-Control          "no-cache" always;
        add_header X-Content-Type-Options nosniff     always;
        add_header Referrer-Policy        no-referrer always;
        add_header X-Frame-Options        DENY        always;
    }
}
