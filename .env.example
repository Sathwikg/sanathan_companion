# Copy to .env (git-ignored) and fill in before `docker compose up`.
# ---------------------------------------------------------------------------

# Host port the whole app is served on -> http://localhost:8080
WEB_PORT=8080

# --- Database (Supabase) ---------------------------------------------------
#
# IMPORTANT: do NOT use the "Direct connection" host
# (db.<project-ref>.supabase.co). Supabase publishes only an IPv6 address for
# it, and Docker's default bridge network is IPv4-only, so the container fails
# with "Network is unreachable".
#
# Use the SESSION POOLER instead — it has an IPv4 address:
#   Supabase Dashboard -> Project Settings -> Database -> Connection string
#   -> "Session pooler" (port 5432)
#
# Two things differ from the direct string: the host becomes
# aws-<n>-<region>.pooler.supabase.com and the username gains the project ref
# (postgres.<project-ref> instead of plain postgres).
#
# Session pooler (port 5432) is the right mode here — EF Core runs migrations
# on startup, and the transaction pooler on 6543 breaks prepared statements.
#
# If the password contains a $, double it ($$) — Compose expands .env values.
CONNECTION_STRING=Host=aws-0-<region>.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<project-ref>;Password=YOUR-PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# --- Auth ------------------------------------------------------------------
# JWT signing key. Must be random, at least 32 bytes, and must not contain
# "change-me" — the API refuses to start otherwise, which is deliberate.
#   PowerShell:  [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
#   bash:        openssl rand -base64 48
JWT_SECRET=change-me-generate-a-random-48-byte-secret
