# Settings for deploy.ps1 (the VPS deploy). Copy to .env.vps (git-ignored) and fill in.
# deploy.ps1 uploads it to the server as the stack's .env, so it never goes into git.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL on the VPS itself) --------------------------------
#
# Self-hosted on the VPS, listening on port 5433 (not Supabase, not the default 5432).
# host.docker.internal is the VPS, as seen from inside the API container. The database is
# created by the API's migrations on first start if it does not exist yet, provided the user
# may create databases (postgres can).
#
# Postgres must accept connections from Docker networks, not only from localhost:
# listen_addresses must include the Docker bridge (or '*'), and pg_hba.conf needs a line for
# the Docker subnets, e.g.
#   host  all  all  172.16.0.0/12  scram-sha-256
# (If Postgres itself runs in a container published on 5433, this already holds.)
#
# No SSL settings: the connection never leaves the VPS.
# If the password contains a $, double it ($$) - Compose expands .env values.
CONNECTION_STRING=Host=host.docker.internal;Port=5433;Database=sanathan;Username=postgres;Password=YOUR-PASSWORD

# --- Auth -------------------------------------------------------------------
# JWT signing key. Random, at least 32 characters, must not contain "change-me" - the API
# refuses to start otherwise. Keep it stable between deploys: changing it signs everyone out.
#   PowerShell:  [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
#   bash:        openssl rand -base64 48
JWT_SECRET=change-me-generate-a-random-48-byte-secret

# The seeded administrator ships locked. On first start this opens it with this password
# (at least 10 characters, not an obvious one). Applied only while the account is still
# locked, so leaving it set never resets a password changed later.
ADMIN_INITIAL_PASSWORD=

# --- Sign in with Google (optional) -----------------------------------------
# Leave empty while the site is served over plain http://IP:port - Google only accepts
# https origins (or localhost), so the button would fail anyway.
GOOGLE_CLIENT_ID=
